#cloud-config
hostname: halbot
manage_etc_hosts: true
disable_root: true
ssh_pwauth: false
users:
  - name: halbot
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - SSH_PUBLIC_KEY
growpart:
  mode: auto
  devices: ['/']
resize_rootfs: true
package_update: false
package_upgrade: false
