// HalCode9000.ailang — native AILang Claude Code, Phase 1 entry point.
//
// A terminal chat client against the Anthropic Messages API. Streams text
// deltas to stdout in real time, dispatches tool calls to cc_tools/* IPC
// services, and loops until the model stops asking for tools.
//
// No JS, no Bun, no Node, no MCP, no hooks. ~150 lines of glue plus
// generic libraries (HTTP, SSE, JSON, Socket, UtilArgs) and Anthropic-
// specific helpers (.History, .Anthropic, .IPCDispatch).
//
// Build: ./ailang.x Applications/HalCode9000/HalCode9000.ailang HalCode9000.x
// Run:   ANTHROPIC_API_KEY=sk-... ./HalCode9000.x
//
// Prerequisites at runtime:
//   - cc_read_ipc.x (and other cc_*_ipc.x services) running
//   - curl on PATH
//   - ANTHROPIC_API_KEY env var set
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. MIT.

LibraryImport.Arena
LibraryImport.JSON
LibraryImport.StringUtils
LibraryImport.HTTP
LibraryImport.SSE
LibraryImport.OAuth
LibraryImport.ThreadTrampoline
Import.Applications.HalCode9000.History
Import.Applications.HalCode9000.UI
Import.Applications.HalCode9000.IPCDispatch
Import.Applications.HalCode9000.backends.Backend
Import.Applications.HalCode9000.Auth

FixedPool.CCSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_DUP":       Initialize=32
    "SYS_DUP2":      Initialize=33
    "SYS_NANOSLEEP": Initialize=35
    "SYS_FORK":      Initialize=57
    "SYS_EXECVE":    Initialize=59
    "SYS_EXIT":      Initialize=60
    "SYS_KILL":      Initialize=62
    "SYS_CHDIR":     Initialize=80
    "SYS_MKDIR":     Initialize=83
    "SYS_READLINK":  Initialize=89
    "SYS_WAIT4":     Initialize=61
    "SYS_PRCTL":     Initialize=157
    "SYS_POLL":      Initialize=7
    "SYS_RT_SIGPROCMASK": Initialize=14
    "SYS_SETPGID":   Initialize=109
    "SYS_SIGNALFD":  Initialize=289
    "SYS_GETDENTS64": Initialize=217
    "SYS_TIME":      Initialize=201
    "SYS_RENAME":    Initialize=82
    "SYS_UNLINK":    Initialize=87
    "SIGTERM":       Initialize=15
    "SIGKILL":       Initialize=9
    "PR_SET_PDEATHSIG": Initialize=1
}

FixedPool.CCConst {
    "MODEL":          Initialize=0, CanChange=True
    "SYSTEM_PROMPT":  Initialize=0, CanChange=True
    "PROJ_PROMPT":    Initialize=0, CanChange=True
    "INPUT_BUF_SZ":   Initialize=1048576      // 1MB
    "LINE_BUF_SZ":    Initialize=1048576      // 1MB - prevents Buffer Bound overflows
    "SSE_STATE_SZ":   Initialize=88
    "MAX_CHILDREN":   Initialize=64
    "BIND_WAIT_NS":   Initialize=5000000000   // 5s — allows slower tools like relmem to bind
    "PARK_THRESHOLD": Initialize=32768        // 32KB — fixes PGMEM SPILL PANIC
    "LOG_DIR":        Initialize=0, CanChange=True
    "LOG_PATH":       Initialize=0, CanChange=True
    "LOG_WARN_MSG":   Initialize=0, CanChange=True
}

FixedPool.CCRunState {
    "running":       Initialize=1, CanChange=True
    "go_home":       Initialize=0, CanChange=True
    "child_pids":    Initialize=0, CanChange=True
    "child_count":   Initialize=0, CanChange=True
    "auto_approve":  Initialize=0, CanChange=True
    "session_turn":  Initialize=0, CanChange=True
    "auth_mode":     Initialize=0, CanChange=True
    "auth_cred":     Initialize=0, CanChange=True
    "log_fd":        Initialize=0, CanChange=True  // 0 = not open
    "log_open":      Initialize=0, CanChange=True  // 1 when log_fd is valid
    "log_bytes":     Initialize=0, CanChange=True  // bytes written this session
    "line_buf":      Initialize=0, CanChange=True  // persistent 1MB SSE line buffer (reuse, no per-turn alloc)
    "ui_proj":       Initialize=0, CanChange=True
    "ui_thread":     Initialize=0, CanChange=True
    "ui_state":      Initialize=0, CanChange=True
    "fresh":         Initialize=0, CanChange=True
    "serve_token":   Initialize=0, CanChange=True  // bearer token for --serve mode
}

// MCP on-demand tool table — stores manifest entries for spawn-per-call dispatch.
// Each slot: 8 name + 8 binary + 8 socket = 24 bytes, up to 32 tools.
FixedPool.MCPToolTable {
    "entries":   Initialize=0, CanChange=True  // heap block: 32 * 24 = 768 bytes
    "count":     Initialize=0, CanChange=True
    "schemas":   Initialize=0, CanChange=True  // JSON array of tool schemas
}

FixedPool.QuoteState {
    "arr":           Initialize=0, CanChange=True   // JSON array of quote strings
    "count":         Initialize=0, CanChange=True
    "rng":           Initialize=42, CanChange=True  // LCG state
    "last_sec":      Initialize=0, CanChange=True   // absolute second tracker for quotes
}

// =============================================================================
// I/O HELPERS
// =============================================================================
Function.CC_WriteStdout {
    Input: s: Address
    Body: {
        len = StringLength(s)
        IfCondition GreaterThan(len, 0) ThenBlock: {
            SystemCall(CCSys.SYS_WRITE, 1, s, len, 0, 0)
        }
    }
}

// Blocking read of one line from stdin into buf. Returns length read
// (excluding the trailing newline). Reads byte-at-a-time so we don't
// over-consume into next prompt. Returns -1 on EOF.
Function.CC_ReadStdinLine {
    Input: buf: Address
    Input: maxlen: Integer
    Output: Integer
    Body: {
        used = 0
        WhileLoop LessThan(used, Subtract(maxlen, 1)) {
            n = SystemCall(CCSys.SYS_READ, 0, Add(buf, used), 1, 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: {
                IfCondition EqualTo(used, 0) ThenBlock: { ReturnValue(-1) }
                BreakLoop
            }
            ch = GetByte(buf, used)
            IfCondition EqualTo(ch, 10) ThenBlock: { BreakLoop }
            used = Add(used, 1)
        }
        // Strip trailing CR if present (Windows copy-paste)
        IfCondition GreaterThan(used, 0) ThenBlock: {
            last = GetByte(buf, Subtract(used, 1))
            IfCondition EqualTo(last, 13) ThenBlock: {
                used = Subtract(used, 1)
            }
        }
        SetByte(buf, used, 0)
        ReturnValue(used)
    }
}

// Read $VAR from /proc/self/environ. Returns 0 if not set.
Function.CC_GetEnv {
    Input: var_name: Address
    Output: Address
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, "/proc/self/environ", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(65536)
        n = SystemCall(CCSys.SYS_READ, fd, buf, 65536, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 65536)
            ReturnValue(0)
        }
        var_len = StringLength(var_name)
        i = 0
        WhileLoop LessThan(i, n) {
            match = 1
            j = 0
            WhileLoop LessThan(j, var_len) {
                IfCondition NotEqual(GetByte(buf, Add(i, j)), GetByte(var_name, j)) ThenBlock: {
                    match = 0
                    BreakLoop
                }
                j = Add(j, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, Add(i, var_len)), 61) ThenBlock: {
                    val_start = Add(i, Add(var_len, 1))
                    val_end = val_start
                    WhileLoop LessThan(val_end, n) {
                        IfCondition EqualTo(GetByte(buf, val_end), 0) ThenBlock: { BreakLoop }
                        val_end = Add(val_end, 1)
                    }
                    val_len = Subtract(val_end, val_start)
                    out = Allocate(Add(val_len, 1))
                    k = 0
                    WhileLoop LessThan(k, val_len) {
                        SetByte(out, k, GetByte(buf, Add(val_start, k)))
                        k = Add(k, 1)
                    }
                    SetByte(out, val_len, 0)
                    Deallocate(buf, 65536)
                    ReturnValue(out)
                }
            }
            WhileLoop LessThan(i, n) {
                IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { BreakLoop }
                i = Add(i, 1)
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 65536)
        ReturnValue(0)
    }
}

// Heap copy. JSON interior pointers do not survive the auth arena.
Function.CC_Dup {
    Input: src: Address
    Output: Address
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        n = StringLength(src)
        out = Allocate(Add(n, 1))
        IfCondition EqualTo(out, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessEqual(i, n) {
            SetByte(out, i, GetByte(src, i))
            i = Add(i, 1)
        }
        ReturnValue(out)
    }
}

Function.CC_SleepMs {
    Input: ms: Integer
    Body: {
        IfCondition LessEqual(ms, 0) ThenBlock: { ReturnValue(0) }
        ts = Allocate(16)
        sec = Divide(ms, 1000)
        rem_ms = Subtract(ms, Multiply(sec, 1000))
        ns = Multiply(rem_ms, 1000000)
        StoreValue(Add(ts, 0), sec)
        StoreValue(Add(ts, 8), ns)
        SystemCall(CCSys.SYS_NANOSLEEP, ts, 0, 0, 0, 0)
        Deallocate(ts, 16)
    }
}

Function.CC_StartsWith {
    Input: line: Address
    Input: pfx: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(line, 0), EqualTo(pfx, 0)) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop 1 {
            pc = GetByte(pfx, i)
            IfCondition EqualTo(pc, 0) ThenBlock: { ReturnValue(1) }
            IfCondition NotEqual(GetByte(line, i), pc) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
    }
}

// Write the pinned assistant blob to disk. No model, no history rewrite.
Function.CC_SavePinned {
    Input: path: Address
    Body: {
        out_path = path
        IfCondition Or(EqualTo(out_path, 0), EqualTo(StringLength(out_path), 0)) ThenBlock: {
            out_path = "docs/last-assistant.md"
        }
        txt = History.GetPinnedText()
        n = History.GetPinnedLen()
        IfCondition Or(EqualTo(txt, 0), EqualTo(n, 0)) ThenBlock: {
            UI.ChatTag("✗", "Nothing pinned. Need an assistant reply first (short 'ok' does not pin).", 1)
            ReturnValue(0)
        }
        fd = SystemCall(CCSys.SYS_OPEN, out_path, 577, 420, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            UI.ChatTag("✗", StringConcat("cannot write ", out_path), 1)
            ReturnValue(0)
        }
        SystemCall(CCSys.SYS_WRITE, fd, txt, n, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        okm = StringConcat("saved ", out_path)
        okm = StringConcat(okm, " (")
        okm = StringConcat(okm, NumberToString(n))
        okm = StringConcat(okm, " bytes, verbatim)")
        UI.ChatTag("✓", okm, 2)
    }
}

// Non-blocking sleep: pumps UI animation each 16ms so the screen stays live
// and ESC interrupts work during retry back-off delays.
Function.CC_SleepAnimated {
    Input: ms: Integer
    Body: {
        IfCondition LessEqual(ms, 0) ThenBlock: { ReturnValue(0) }
        elapsed = 0
        WhileLoop LessThan(elapsed, ms) {
            UI.AnimTick()
            IfCondition EqualTo(UILayout.interrupted, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(IPCDState.proxy_mode, 0) ThenBlock: {
                IPCDispatch.PollProxy()
            }
            CC_SleepMs(16)
            elapsed = Add(elapsed, 16)
        }
    }
}

// Full-jitter helper: returns a random ms value in [0, max_ms].
// Uses 2 bytes from /dev/urandom for 16-bit entropy.
Function.CC_RandomMs {
    Input: max_ms: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(max_ms, 0) ThenBlock: { ReturnValue(0) }
        fd = SystemCall(CCSys.SYS_OPEN, "/dev/urandom", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(Divide(max_ms, 2)) }
        buf = Allocate(2)
        SystemCall(CCSys.SYS_READ, fd, buf, 2, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        lo = GetByte(buf, 0)
        hi = GetByte(buf, 1)
        Deallocate(buf, 2)
        rnd = BitwiseOr(lo, LeftShift(hi, 8))
        ReturnValue(Divide(Multiply(rnd, max_ms), 65535))
    }
}

// Verbose debug logger. Appends to /tmp/hal9000_debug.log
Function.CC_DebugLog {
    Input: msg: Address
    Body: {
        // O_WRONLY | O_CREAT | O_APPEND = 1 | 64 | 1024 = 1089
        fd = SystemCall(CCSys.SYS_OPEN, "/tmp/hal9000_debug.log", 1089, 420, 0, 0) // 0644
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(CCSys.SYS_WRITE, fd, msg, StringLength(msg), 0, 0)
            SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        }
    }
}

// JSON.SetString stores the pointer as-is (no copy). JSON.Free /
// JSON.FreeArray then Deallocate() those pointers. Anything we put in
// a tree we later free must be a heap copy we own — never a string
// literal or a live buffer.
// JSON.Free() is only for ParseJSON tagged values. JSON.NewArray() /
// JSON.NewObject() return untagged containers — use JSON.FreeArray /
// JSON.FreeObject, and only if every string value is owned.
Function.CC_StrDup {
    Input: src: Address
    Output: Address
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(src)
        dst = Allocate(Add(slen, 1))
        k = 0
        WhileLoop LessThan(k, slen) {
            SetByte(dst, k, GetByte(src, k))
            k = Add(k, 1)
        }
        SetByte(dst, slen, 0)
        ReturnValue(dst)
    }
}

// Check for agent completion flag written by cc_agent_ipc daemon worker.
// Non-blocking: open returns -1 immediately if file absent.
Function.CC_CheckAgentNotify {
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, "/tmp/hal_agent_notify.txt", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(256)
        n = SystemCall(CCSys.SYS_READ, fd, buf, 255, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        SystemCall(CCSys.SYS_UNLINK, "/tmp/hal_agent_notify.txt", 0, 0, 0, 0)
        IfCondition GreaterThan(n, 0) ThenBlock: {
            SetByte(buf, n, 0)
            IfCondition EqualTo(GetByte(buf, Subtract(n, 1)), 10) ThenBlock: {
                SetByte(buf, Subtract(n, 1), 0)
            }
            UI.ChatTag("◆", buf, 6)
        }
        Deallocate(buf, 256)
    }
}

// Turn log — appends tool name, arg summary, and first 4096 chars of result
// to /tmp/hal_turn_log.txt immediately after each tool completes, so work
// is never silently lost when the stream drops mid-turn.
Function.CC_TurnLog {
    Input: tname: Address
    Input: argsummary: Address
    Input: content: Address
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, "/tmp/hal_turn_log.txt", 1089, 420, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        hdr = StringConcat("[", tname)
        hdr = StringConcat(hdr, "] ")
        hdr = StringConcat(hdr, argsummary)
        hdr = StringConcat(hdr, "\n")
        SystemCall(CCSys.SYS_WRITE, fd, hdr, StringLength(hdr), 0, 0)
        IfCondition NotEqual(content, 0) ThenBlock: {
            cap = 4096
            clen = StringLength(content)
            IfCondition LessThan(clen, cap) ThenBlock: { cap = clen }
            IfCondition GreaterThan(cap, 0) ThenBlock: {
                SystemCall(CCSys.SYS_WRITE, fd, content, cap, 0, 0)
            }
        }
        sep = "\n---\n"
        SystemCall(CCSys.SYS_WRITE, fd, sep, StringLength(sep), 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
    }
}


// =============================================================================
// SESSION LOG — /tmp/hal_session.txt
// Comprehensive per-turn record: user input, full COT, full response.
// =============================================================================

// Append a labeled section to the session log.
Function.CC_SessionLog {
    Input: label: Address
    Input: content: Address
    Body: {
        IfCondition EqualTo(CCRunState.log_open, 0) ThenBlock: { ReturnValue(0) }
        fd = CCRunState.log_fd
        IfCondition NotEqual(label, 0) ThenBlock: {
            llen = StringLength(label)
            IfCondition GreaterThan(llen, 0) ThenBlock: {
                SystemCall(CCSys.SYS_WRITE, fd, label, llen, 0, 0)
                CCRunState.log_bytes = Add(CCRunState.log_bytes, llen)
            }
        }
        IfCondition NotEqual(content, 0) ThenBlock: {
            clen = StringLength(content)
            IfCondition GreaterThan(clen, 0) ThenBlock: {
                SystemCall(CCSys.SYS_WRITE, fd, content, clen, 0, 0)
                CCRunState.log_bytes = Add(CCRunState.log_bytes, clen)
            }
        }
        SystemCall(CCSys.SYS_WRITE, fd, "\n", 1, 0, 0)
        CCRunState.log_bytes = Add(CCRunState.log_bytes, 1)
    }
}

// Write the turn header + user message to the session log.
Function.CC_SessionLogUser {
    Input: user_msg: Address
    Body: {
        CCRunState.session_turn = Add(CCRunState.session_turn, 1)
        ts = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        hdr = StringConcat("=== TURN ", NumberToString(CCRunState.session_turn))
        hdr = StringConcat(hdr, " [ts=")
        hdr = StringConcat(hdr, NumberToString(ts))
        hdr = StringConcat(hdr, "] ===\n[USER]\n")
        CC_SessionLog(hdr, user_msg)
        CC_SessionLog("[/USER]\n", 0)
    }
}

// Write COT + response sections to the session log (call before Backend.Reset).
Function.CC_SessionLogResponse {
    Body: {
        CC_AgentLog("[think] SessionLogResponse enter")
        ts = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        ts_str = NumberToString(ts)
        cot = Backend.GetReasoning()
        CC_AgentLog("[think] GetReasoning ptr")
        resp = Backend.GetResponseText()
        CC_AgentLog("[think] GetResponseText ptr")
        cot_n = 0
        IfCondition NotEqual(cot, 0) ThenBlock: { cot_n = StringLength(cot) }
        CC_AgentLog(StringConcat("[think] cot chars=", NumberToString(cot_n)))
        IfCondition GreaterThan(cot_n, 0) ThenBlock: {
            CC_AgentLog("[think] write think.tmp")
            CC_WriteAppFile("/tmp/halcode_app/think.tmp", cot)
            SystemCall(CCSys.SYS_RENAME, "/tmp/halcode_app/think.tmp", "/tmp/halcode_app/think.txt", 0, 0, 0)
            CC_AgentLog("[think] wrote think.txt")
        }
        IfCondition NotEqual(cot, 0) ThenBlock: {
            IfCondition GreaterThan(cot_n, 0) ThenBlock: {
                think_hdr = StringConcat("[THINKING ts=", ts_str)
                think_hdr = StringConcat(think_hdr, "]\n")
                CC_SessionLog(think_hdr, cot)
                CC_SessionLog("[/THINKING]\n", 0)
            }
        }
        IfCondition NotEqual(resp, 0) ThenBlock: {
            resp_hdr = StringConcat("[RESPONSE ts=", ts_str)
            resp_hdr = StringConcat(resp_hdr, "]\n")
            CC_SessionLog(resp_hdr, resp)
            CC_SessionLog("[/RESPONSE]\n", 0)
        }
    }
}

// Close the persistent session log fd and print the saved path.
Function.CC_SessionCleanup {
    Body: {
        IfCondition EqualTo(CCRunState.log_open, 1) ThenBlock: {
            SystemCall(CCSys.SYS_CLOSE, CCRunState.log_fd, 0, 0, 0, 0)
            CCRunState.log_open = 0
        }
        IfCondition NotEqual(CCConst.LOG_PATH, 0) ThenBlock: {
            CC_WriteStdout("\nSession saved: ")
            CC_WriteStdout(CCConst.LOG_PATH)
            CC_WriteStdout("\n")
        }
    }
}

// Log a tool call (before dispatch) with timestamp.
Function.CC_SessionLogTool {
    Input: tname: Address
    Input: arg_sum: Address
    Body: {
        ts = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        hdr = StringConcat("[TOOL_CALL ts=", NumberToString(ts))
        hdr = StringConcat(hdr, " tool=")
        hdr = StringConcat(hdr, tname)
        hdr = StringConcat(hdr, "]\n")
        CC_SessionLog(hdr, arg_sum)
        CC_SessionLog("[/TOOL_CALL]\n", 0)
    }
}

// Log a tool result (after dispatch) with full content — no truncation.
Function.CC_SessionLogToolResult {
    Input: tname: Address
    Input: content: Address
    Input: is_err: Integer
    Body: {
        ts = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        ok_str = "1"
        IfCondition EqualTo(is_err, 1) ThenBlock: { ok_str = "0" }
        hdr = StringConcat("[TOOL_RESULT ts=", NumberToString(ts))
        hdr = StringConcat(hdr, " tool=")
        hdr = StringConcat(hdr, tname)
        hdr = StringConcat(hdr, " ok=")
        hdr = StringConcat(hdr, ok_str)
        hdr = StringConcat(hdr, "]\n")
        CC_SessionLog(hdr, content)
        CC_SessionLog("[/TOOL_RESULT]\n", 0)
    }
}

// Create ~/.halcode/logs/, open session log file, run 90-day cleanup + size check.
Function.CC_SessionInit {
    Body: {
        home = CC_GetEnv("HOME")
        IfCondition EqualTo(home, 0) ThenBlock: { home = "/root" }

        // Build paths: $HOME/.halcode/logs/
        halcode_dir = StringConcat(home, "/.halcode")
        SystemCall(CCSys.SYS_MKDIR, halcode_dir, 493, 0, 0, 0)
        log_dir = StringConcat(halcode_dir, "/logs")
        CCConst.LOG_DIR = log_dir
        SystemCall(CCSys.SYS_MKDIR, log_dir, 493, 0, 0, 0)

        // Build session filename: session_<ts>.txt
        ts = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        log_path = StringConcat(log_dir, "/session_")
        log_path = StringConcat(log_path, NumberToString(ts))
        log_path = StringConcat(log_path, ".txt")
        CCConst.LOG_PATH = log_path

        // Open persistent fd (O_WRONLY|O_CREAT|O_APPEND=1089, mode 0644=420)
        fd = SystemCall(CCSys.SYS_OPEN, log_path, 1089, 420, 0, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            CCRunState.log_fd = fd
            CCRunState.log_open = 1
            hdr = StringConcat("=== HAL CODE 9000 SESSION ts=", NumberToString(ts))
            hdr = StringConcat(hdr, " ===\n")
            SystemCall(CCSys.SYS_WRITE, fd, hdr, StringLength(hdr), 0, 0)
        }

        // Fork sh: delete logs older than 90 days, write dir size to /tmp/hal_log_sz.txt
        sh_cmd = StringConcat("find ", log_dir)
        sh_cmd = StringConcat(sh_cmd, " -name 'session_*.txt' -mtime +90 -delete 2>/dev/null; du -sb ")
        sh_cmd = StringConcat(sh_cmd, log_dir)
        sh_cmd = StringConcat(sh_cmd, " 2>/dev/null | awk '{print $1}' > /tmp/hal_log_sz.txt")
        sh_pid = SystemCall(CCSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition EqualTo(sh_pid, 0) ThenBlock: {
            argv = Allocate(32)
            sh_path = "/bin/sh"
            arg1 = "-c"
            StoreValue(Add(argv, 0), sh_path)
            StoreValue(Add(argv, 8), arg1)
            StoreValue(Add(argv, 16), sh_cmd)
            StoreValue(Add(argv, 24), 0)
            envp = CC_BuildInheritedEnvp()
            SystemCall(CCSys.SYS_EXECVE, sh_path, argv, envp)
            SystemCall(CCSys.SYS_EXIT, 1, 0, 0, 0, 0)
        }
        IfCondition GreaterThan(sh_pid, 0) ThenBlock: {
            wstat = Allocate(8)
            SystemCall(CCSys.SYS_WAIT4, sh_pid, wstat, 0, 0, 0)
            Deallocate(wstat, 8)
        }

        // Read dir size, set warning if over thresholds
        sz_fd = SystemCall(CCSys.SYS_OPEN, "/tmp/hal_log_sz.txt", 0, 0, 0, 0)
        IfCondition GreaterEqual(sz_fd, 0) ThenBlock: {
            sz_buf = Allocate(32)
            sz_n = SystemCall(CCSys.SYS_READ, sz_fd, sz_buf, 31, 0, 0)
            SystemCall(CCSys.SYS_CLOSE, sz_fd, 0, 0, 0, 0)
            IfCondition GreaterThan(sz_n, 0) ThenBlock: {
                SetByte(sz_buf, sz_n, 0)
                total_sz = StringToInt(sz_buf)
                // warn at 120MB (125829120), limit 150MB (157286400)
                IfCondition GreaterThan(total_sz, 125829120) ThenBlock: {
                    mb_str = NumberToString(Divide(total_sz, 1048576))
                    warn = StringConcat("[Session logs: ", mb_str)
                    IfCondition GreaterThan(total_sz, 157286400) ThenBlock: {
                        CCConst.LOG_WARN_MSG = StringConcat(warn, "MB / 150MB LIMIT REACHED — oldest logs deleted]")
                    } ElseBlock: {
                        CCConst.LOG_WARN_MSG = StringConcat(warn, "MB / 150MB — getting full]")
                    }
                }
            }
            Deallocate(sz_buf, 32)
        }
    }
}

// =============================================================================
// =============================================================================
// PROJECT PROMPT — load/build/apply per-project system prompt addon
// =============================================================================

// Fetch the project prompt from pgmem key __prompt__. Returns text or 0.
Function.CC_LoadProjectPrompt {
    Output: Address
    Body: {
        args = JSON.NewObject()
        JSON.SetString(args, "op", "pickup")
        JSON.SetString(args, "key", "__prompt__")
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        result = IPCDispatch.Dispatch("Pgmem", args, 0, perr)
        err_flag = Dereference(perr, "dword")
        Deallocate(perr, 8)
        IfCondition EqualTo(err_flag, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringLength(result), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(result)
    }
}

// Build the combined system prompt (base rules + project addon if set).
Function.CC_BuildFullPrompt {
    Output: Address
    Body: {
        IfCondition EqualTo(CCConst.PROJ_PROMPT, 0) ThenBlock: {
            ReturnValue(CCConst.SYSTEM_PROMPT)
        }
        full = StringConcat(CCConst.SYSTEM_PROMPT, "\n\nPROJECT PROMPT:\n")
        full = StringConcat(full, CCConst.PROJ_PROMPT)
        ReturnValue(full)
    }
}

// Re-initialize backend with current combined prompt. Clears history.
// Call UI.Shutdown/Init/SessionHeader in the caller after this.
Function.CC_ApplyProjectPrompt {
    Body: {
        History.Init()
        Backend.Init(CCRunState.auth_mode, CCRunState.auth_cred, CC_BuildFullPrompt())
    }
}

// =============================================================================
// PROJECT COMMAND — /project slash command handler
// =============================================================================
// Calls project.info on pgmem and prints the human-readable content field.
Function.CC_ProjectCommand {
    Body: {
        args = JSON.NewObject()
        JSON.SetString(args, "op", "project.info")
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        resp = IPCDispatch.Dispatch("Pgmem", args, 0, perr)
        err_flag = Dereference(perr, "dword")
        Deallocate(perr, 8)
        IfCondition EqualTo(err_flag, 1) ThenBlock: {
            UI.ChatTag("✗", "Pgmem unavailable — start cc_pgmem_ipc.x first.", 1)
            ReturnValue(0)
        }
        IfCondition NotEqual(resp, 0) ThenBlock: {
            UI.ChatPrintln(resp)
        }
        UI.ChatPrintln("  project.list | project.create name=<n> | project.select name=<n> | project.layout")
    }
}

// =============================================================================
// PATH HELPERS — expand "~/..." to "$HOME/..."
// =============================================================================
Function.CC_ExpandHome {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        // If first char is not '~', return path unchanged
        IfCondition NotEqual(GetByte(path, 0), 126) ThenBlock: { ReturnValue(path) }
        home = CC_GetEnv("HOME")
        IfCondition EqualTo(home, 0) ThenBlock: { ReturnValue(path) }
        // ~/foo  ->  $HOME/foo
        rest = Add(path, 1)   // skip '~'
        ReturnValue(StringConcat(home, rest))
    }
}

Function.CC_MkdirP {
    Input: path: Address
    Body: {
        // Best-effort mkdir; ignore EEXIST
        SystemCall(83, path, 448, 0, 0, 0)   // 0700
    }
}

// =============================================================================
// AUTH MODE PROMPT — 1=subscription OAuth, 2=API key
// =============================================================================
Function.CC_ClearScreenCooked {
    Body: {
        buf = Allocate(8)
        SetByte(buf, 0, 27) SetByte(buf, 1, 91) SetByte(buf, 2, 50) SetByte(buf, 3, 74)
        SetByte(buf, 4, 27) SetByte(buf, 5, 91) SetByte(buf, 6, 72) SetByte(buf, 7, 0)
        CC_WriteStdout(buf)
        Deallocate(buf, 8)
    }
}

Function.CC_PrintStepHeader {
    Input: step_name: Address
    Body: {
        CC_ClearScreenCooked()
        CC_WriteStdout("\n")
        buf = Allocate(16)
        SetByte(buf,0,27) SetByte(buf,1,91) SetByte(buf,2,51) SetByte(buf,3,56) SetByte(buf,4,59)
        SetByte(buf,5,53) SetByte(buf,6,59) SetByte(buf,7,50) SetByte(buf,8,48) SetByte(buf,9,56) SetByte(buf,10,109) SetByte(buf,11,0)
        CC_WriteStdout(buf)
        
        CC_WriteStdout(" ┌───┐\n")
        CC_WriteStdout(" ─┤ ")
        SetByte(buf,0,226) SetByte(buf,1,151) SetByte(buf,2,137) SetByte(buf,3,0)
        CC_WriteStdout(buf)
        CC_WriteStdout(" ├─  HAL Code 9000\n")
        CC_WriteStdout(" └───┘\n")
        
        SetByte(buf,0,27) SetByte(buf,1,91) SetByte(buf,2,48) SetByte(buf,3,109) SetByte(buf,4,0)
        CC_WriteStdout(buf)
        Deallocate(buf, 16)
        
        CC_WriteStdout("\n ")
        CC_WriteStdout(step_name)
        CC_WriteStdout("\n ────────────────────────────────────────────────────────\n\n")
    }
}

// Returns 1 or 2. Reads a single-line answer; first char wins.
Function.CC_PromptAuthMode {
    Output: Integer
    Body: {
        CC_PrintStepHeader("STEP 1: Authentication")
        CC_WriteStdout("  1) Subscription (claude.ai OAuth — Pro/Max/Team)\n")
        CC_WriteStdout("  2) Console API key (sk-ant-... from console.anthropic.com)\n")
        CC_WriteStdout("  0) Quit\n\n")
        CC_WriteStdout(" Choice [2]: ")
        buf = Allocate(64)
        n = CC_ReadStdinLine(buf, 64)
        choice = 2
        IfCondition GreaterThan(n, 0) ThenBlock: {
            first = GetByte(buf, 0)
            IfCondition EqualTo(first, 49) ThenBlock: { choice = 1 }    // '1'
            IfCondition EqualTo(first, 50) ThenBlock: { choice = 2 }    // '2'
            IfCondition EqualTo(first, 48) ThenBlock: { choice = -1 }   // '0'
            IfCondition EqualTo(first, 113) ThenBlock: { choice = -1 }  // 'q'
        }
        Deallocate(buf, 64)
        ReturnValue(choice)
    }
}

// =============================================================================
// CHILD PROCESS MANAGEMENT
// =============================================================================
// Fork+exec a tool service binary. Redirects child stdout+stderr to
// /dev/null so the chat output stays clean. Stores PID for cleanup.
// Returns child PID, or -1 on failure.
// Read /proc/self/environ and build a NULL-terminated envp array of
// pointers into a heap buffer. AILang runtime crashes on minimal env
// (just PATH+HOME etc isn't enough), so the right thing is to inherit
// whatever env ClaudeCode itself was launched with.
Function.CC_BuildInheritedEnvp {
    Output: Address
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, "/proc/self/environ", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(16384)
        n = SystemCall(0, fd, buf, 16384, 0, 0)         // SYS_READ = 0
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }

        // Walk the NUL-separated entries, build a pointer array.
        envp = Allocate(4096)                            // up to 512 entries
        idx = 0
        StoreValue(Add(envp, 0), buf)                    // first entry = buf
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: {
                next_pos = Add(i, 1)
                IfCondition LessThan(next_pos, n) ThenBlock: {
                    idx = Add(idx, 1)
                    StoreValue(Add(envp, Multiply(idx, 8)), Add(buf, next_pos))
                }
            }
            i = Add(i, 1)
        }
        // NULL-terminate the envp array
        StoreValue(Add(envp, Multiply(Add(idx, 1), 8)), 0)
        ReturnValue(envp)
    }
}

// Quick file logger for CC_LaunchTool diagnostics — same file as IPCDispatch.
Function.CC_LaunchLog {
    Input: msg: Address
    Body: {
        fd = SystemCall(2, "/tmp/cc-ipcd.log", 1089, 420, 0, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(1, fd, msg, StringLength(msg), 0, 0)
            SystemCall(3, fd, 0, 0, 0, 0)
        }
    }
}

Function.CC_LaunchTool {
    Input: binary_path: Address
    Input: tool_name: Address
    Input: tool_socket: Address
    Output: Integer
    Body: {
        CC_LaunchLog("[launch] BEGIN ")
        CC_LaunchLog(binary_path)
        CC_LaunchLog("\n")
        // Build envp BEFORE fork so the child inherits the buffer (COW).
        envp = CC_BuildInheritedEnvp()
        IfCondition EqualTo(envp, 0) ThenBlock: {
            CC_LaunchLog("[launch] FAIL build_envp\n")
        }
        pid = SystemCall(CCSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            CC_LaunchLog("[launch] FAIL fork ")
            CC_LaunchLog(binary_path)
            CC_LaunchLog("\n")
            ReturnValue(-1)
        }
        IfCondition EqualTo(pid, 0) ThenBlock: {
            // Child — log BEFORE dup2 so logger still has stderr if needed.
            CC_LaunchLog("[launch] CHILD pre_exec ")
            CC_LaunchLog(binary_path)
            CC_LaunchLog("\n")
            // Own process group so shutdown reaches shells this tool forks.
            SystemCall(CCSys.SYS_SETPGID, 0, 0, 0, 0, 0)
            // Die automatically when parent exits for any reason (crash, kill, etc.)
            SystemCall(CCSys.SYS_PRCTL, CCSys.PR_SET_PDEATHSIG, CCSys.SIGTERM, 0, 0, 0)
            // The host blocks SIGINT|SIGTERM for its signalfd. A child that
            // keeps that mask never runs the parent's death signal, holds
            // @halcode/<Tool>, and spins in Accept. Unblock both.
            sigmask = Allocate(8)
            StoreValue(sigmask, 16386)
            SystemCall(CCSys.SYS_RT_SIGPROCMASK, 1, sigmask, 0, 8, 0)
            Deallocate(sigmask, 8)
            // Silence stdout/stderr, exec
            devnull = SystemCall(CCSys.SYS_OPEN, "/dev/null", 1, 0, 0, 0)
            IfCondition GreaterEqual(devnull, 0) ThenBlock: {
                SystemCall(CCSys.SYS_DUP2, devnull, 1, 0, 0, 0)
                SystemCall(CCSys.SYS_DUP2, devnull, 2, 0, 0, 0)
                SystemCall(CCSys.SYS_CLOSE, devnull, 0, 0, 0, 0)
            }
            // Pass name+socket as argv[1]/argv[2] so tools can self-configure.
            // Tools that predate this pattern ignore the extra args safely.
            argv = Allocate(32)
            StoreValue(Add(argv, 0), binary_path)
            IfCondition And(NotEqual(tool_name, 0), NotEqual(tool_socket, 0)) ThenBlock: {
                StoreValue(Add(argv, 8),  tool_name)
                StoreValue(Add(argv, 16), tool_socket)
                StoreValue(Add(argv, 24), 0)
            } ElseBlock: {
                StoreValue(Add(argv, 8),  0)
                StoreValue(Add(argv, 16), 0)
                StoreValue(Add(argv, 24), 0)
            }
            ret = SystemCall(CCSys.SYS_EXECVE, binary_path, argv, envp)
            // execve returned -> failed
            CC_LaunchLog("[launch] CHILD EXECVE_FAILED ret=")
            CC_LaunchLog(NumberToString(ret))
            CC_LaunchLog(" for ")
            CC_LaunchLog(binary_path)
            CC_LaunchLog("\n")
            SystemCall(CCSys.SYS_EXIT, 127, 0, 0, 0, 0)
        }
        // Parent — record PID. setpgid from both sides covers the race
        // where the child has not run yet.
        SystemCall(CCSys.SYS_SETPGID, pid, pid, 0, 0, 0)
        IfCondition LessThan(CCRunState.child_count, CCConst.MAX_CHILDREN) ThenBlock: {
            slot = Multiply(CCRunState.child_count, 8)
            StoreValue(Add(CCRunState.child_pids, slot), pid)
            CCRunState.child_count = Add(CCRunState.child_count, 1)
        } ElseBlock: {
            CC_LaunchLog("[launch] PID TABLE FULL\n")
        }
        ReturnValue(pid)
    }
}

// Gracefully shut down every child: SIGTERM → wait → SIGKILL stragglers → reap.
// Prevents zombie processes by always calling waitpid on every child we forked.
Function.CC_KillAllChildren {
    Body: {
        IfCondition EqualTo(CCRunState.child_count, 0) ThenBlock: { ReturnValue(0) }

        // Phase 1: SIGTERM all children.
        i = 0
        WhileLoop LessThan(i, CCRunState.child_count) {
            slot = Multiply(i, 8)
            pid = Dereference(Add(CCRunState.child_pids, slot))
            IfCondition GreaterThan(pid, 0) ThenBlock: {
                SystemCall(CCSys.SYS_KILL, pid, CCSys.SIGTERM, 0, 0, 0)
                SystemCall(CCSys.SYS_KILL, Subtract(0, pid), CCSys.SIGTERM, 0, 0, 0)
            }
            i = Add(i, 1)
        }

        // Phase 2: Give children 500ms to exit gracefully.
        ts = Allocate(16)
        StoreValue(Add(ts, 0), 0)
        StoreValue(Add(ts, 8), 500000000)
        SystemCall(CCSys.SYS_NANOSLEEP, ts, 0, 0, 0, 0)
        Deallocate(ts, 16)

        // Phase 3: WNOHANG reap pass — collect anyone already exited.
        // For survivors, escalate to SIGKILL.
        status_buf = Allocate(8)
        i = 0
        WhileLoop LessThan(i, CCRunState.child_count) {
            slot = Multiply(i, 8)
            pid = Dereference(Add(CCRunState.child_pids, slot))
            IfCondition GreaterThan(pid, 0) ThenBlock: {
                StoreValue(status_buf, 0)
                wr = SystemCall(CCSys.SYS_WAIT4, pid, status_buf, 1, 0, 0)
                // 1 = WNOHANG
                IfCondition EqualTo(wr, 0) ThenBlock: {
                    // Child still alive — escalate to SIGKILL (the whole group).
                    SystemCall(CCSys.SYS_KILL, pid, CCSys.SIGKILL, 0, 0, 0)
                    SystemCall(CCSys.SYS_KILL, Subtract(0, pid), CCSys.SIGKILL, 0, 0, 0)
                }
                IfCondition EqualTo(wr, -10) ThenBlock: {
                    StoreValue(Add(CCRunState.child_pids, slot), 0)
                }
                IfCondition GreaterThan(wr, 0) ThenBlock: {
                    // Already reaped — mark slot empty
                    StoreValue(Add(CCRunState.child_pids, slot), 0)
                }
            }
            i = Add(i, 1)
        }

        // Phase 4: Blocking reap for any SIGKILL'd children.
        i = 0
        WhileLoop LessThan(i, CCRunState.child_count) {
            slot = Multiply(i, 8)
            pid = Dereference(Add(CCRunState.child_pids, slot))
            IfCondition GreaterThan(pid, 0) ThenBlock: {
                StoreValue(status_buf, 0)
                SystemCall(CCSys.SYS_WAIT4, pid, status_buf, 0, 0, 0)
                StoreValue(Add(CCRunState.child_pids, slot), 0)
            }
            i = Add(i, 1)
        }
        Deallocate(status_buf, 8)
        CCRunState.child_count = 0
    }
}

// 1 if the /proc comm (no parentheses, length n) is one of our tools.
// comm is truncated to 15 bytes, so cc_ailang_lsp_ipc shows up as cc_ailang_lsp_i.
Function.CC_CommIsTool {
    Input: s: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 0), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 1), 99) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(s, 2), 95) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessEqual(i, Subtract(n, 4)) {
            IfCondition EqualTo(GetByte(s, i), 95) ThenBlock: {
                IfCondition EqualTo(GetByte(s, Add(i, 1)), 105) ThenBlock: {
                    IfCondition EqualTo(GetByte(s, Add(i, 2)), 112) ThenBlock: {
                        IfCondition EqualTo(GetByte(s, Add(i, 3)), 99) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(n, 15) ThenBlock: {
            IfCondition EqualTo(StringCompare(s, "cc_ailang_lsp_i"), 0) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// SIGKILL an orphaned cc_*_ipc (ppid 1). A live host's tools have that host
// as parent, so this does not touch them or HalCode9000.x --mcp.
Function.CC_KillIfOrphanTool {
    Input: pid: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(pid, 1) ThenBlock: { ReturnValue(0) }
        stpath = Allocate(64)
        SetByte(stpath, 0, 47) SetByte(stpath, 1, 112) SetByte(stpath, 2, 114)
        SetByte(stpath, 3, 111) SetByte(stpath, 4, 99) SetByte(stpath, 5, 47)
        digits = Allocate(16)
        nd = 0
        v = pid
        WhileLoop GreaterThan(v, 0) {
            SetByte(digits, nd, Add(48, Modulo(v, 10)))
            nd = Add(nd, 1)
            v = Divide(v, 10)
        }
        di = 0
        WhileLoop LessThan(di, nd) {
            SetByte(stpath, Add(6, di), GetByte(digits, Subtract(Subtract(nd, 1), di)))
            di = Add(di, 1)
        }
        Deallocate(digits, 16)
        base = Add(6, nd)
        SetByte(stpath, base, 47)
        SetByte(stpath, Add(base, 1), 115)
        SetByte(stpath, Add(base, 2), 116)
        SetByte(stpath, Add(base, 3), 97)
        SetByte(stpath, Add(base, 4), 116)
        SetByte(stpath, Add(base, 5), 0)
        fd = SystemCall(CCSys.SYS_OPEN, stpath, 0, 0, 0, 0)
        Deallocate(stpath, 64)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(512)
        n = SystemCall(CCSys.SYS_READ, fd, buf, 511, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 512)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        lp = -1
        rp = -1
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, 40) ThenBlock: {
                IfCondition EqualTo(lp, -1) ThenBlock: { lp = i }
            }
            IfCondition EqualTo(ch, 41) ThenBlock: { rp = i }
            i = Add(i, 1)
        }
        killed = 0
        IfCondition And(GreaterEqual(lp, 0), GreaterThan(rp, Add(lp, 1))) ThenBlock: {
            comm = Add(buf, Add(lp, 1))
            clen = Subtract(rp, Add(lp, 1))
            SetByte(buf, rp, 0)
            IfCondition EqualTo(CC_CommIsTool(comm, clen), 1) ThenBlock: {
                // ") S ppid" — state is one byte, then a space, then ppid.
                pp = 0
                saw = 0
                j = Add(rp, 4)
                WhileLoop LessThan(j, n) {
                    d = GetByte(buf, j)
                    IfCondition Or(LessThan(d, 48), GreaterThan(d, 57)) ThenBlock: { BreakLoop }
                    pp = Add(Multiply(pp, 10), Subtract(d, 48))
                    saw = 1
                    j = Add(j, 1)
                }
                IfCondition And(EqualTo(saw, 1), EqualTo(pp, 1)) ThenBlock: {
                    SystemCall(CCSys.SYS_KILL, pid, CCSys.SIGKILL, 0, 0, 0)
                    SystemCall(CCSys.SYS_KILL, Subtract(0, pid), CCSys.SIGKILL, 0, 0, 0)
                    killed = 1
                }
            }
        }
        Deallocate(buf, 512)
        ReturnValue(killed)
    }
}

// Drop orphaned cc_*_ipc workers from a previous host. They inherit a blocked
// SIGTERM, so the parent's death signal never lands and they keep the
// abstract socket. Only ppid 1. No pkill -f (that regex also matches --mcp
// command lines and unrelated processes).
Function.CC_KillStaleTools {
    Body: {
        dirfd = SystemCall(CCSys.SYS_OPEN, "/proc", 65536, 0, 0, 0)
        IfCondition LessThan(dirfd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(8192)
        killed = 0
        WhileLoop 1 {
            n = SystemCall(CCSys.SYS_GETDENTS64, dirfd, buf, 8192, 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }
            pos = 0
            WhileLoop LessThan(pos, n) {
                IfCondition GreaterThan(Add(pos, 20), n) ThenBlock: { BreakLoop }
                reclen = Add(GetByte(buf, Add(pos, 16)), Multiply(GetByte(buf, Add(pos, 17)), 256))
                IfCondition Or(LessThan(reclen, 20), GreaterThan(Add(pos, reclen), n)) ThenBlock: { BreakLoop }
                name = Add(buf, Add(pos, 19))
                pid = 0
                okdig = 1
                k = 0
                WhileLoop LessThan(k, 10) {
                    d = GetByte(name, k)
                    IfCondition EqualTo(d, 0) ThenBlock: { BreakLoop }
                    IfCondition Or(LessThan(d, 48), GreaterThan(d, 57)) ThenBlock: {
                        okdig = 0
                        BreakLoop
                    }
                    pid = Add(Multiply(pid, 10), Subtract(d, 48))
                    k = Add(k, 1)
                }
                IfCondition And(EqualTo(okdig, 1), GreaterThan(pid, 1)) ThenBlock: {
                    IfCondition EqualTo(CC_KillIfOrphanTool(pid), 1) ThenBlock: {
                        killed = Add(killed, 1)
                    }
                }
                pos = Add(pos, reclen)
            }
        }
        SystemCall(CCSys.SYS_CLOSE, dirfd, 0, 0, 0, 0)
        Deallocate(buf, 8192)
        IfCondition GreaterThan(killed, 0) ThenBlock: {
            ts = Allocate(16)
            StoreValue(Add(ts, 0), 0)
            StoreValue(Add(ts, 8), 200000000)
            SystemCall(CCSys.SYS_NANOSLEEP, ts, 0, 0, 0, 0)
            Deallocate(ts, 16)
        }
        ReturnValue(killed)
    }
}

// Brief sleep (nanosleep) so services have time to bind their sockets
// before we try to connect. Sleeps for CCConst.BIND_WAIT_NS nanoseconds.
Function.CC_SleepShort {
    Body: {
        // This is a source of race conditions. It has been disabled in favor
        // of a robust retry loop in IPCDispatch.RegisterTool.
    }
}

// =============================================================================
// INTRUSIVE THOUGHTS — rotating dystopian quotes during TTFT wait.
// File has two concatenated JSON objects; we parse only the first.
// =============================================================================
Function.CC_LoadQuotes {
    Input: path: Address
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, path, 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(32768)
        n = SystemCall(CCSys.SYS_READ, fd, buf, 32767, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 32768)
            ReturnValue(0)
        }
        // Null-terminate after first top-level '}' so ParseJSON sees one object.
        // Pattern: }\n\n{ separates the two concatenated objects in the file.
        i = 0
        WhileLoop LessThan(i, Subtract(n, 3)) {
            IfCondition EqualTo(GetByte(buf, i), 125) ThenBlock: {       // '}'
                IfCondition EqualTo(GetByte(buf, Add(i, 1)), 10) ThenBlock: {   // '\n'
                    IfCondition EqualTo(GetByte(buf, Add(i, 2)), 10) ThenBlock: {  // '\n'
                        IfCondition EqualTo(GetByte(buf, Add(i, 3)), 123) ThenBlock: { // '{'
                            SetByte(buf, Add(i, 1), 0)
                            i = n
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        SetByte(buf, n, 0)
        // buf is NOT freed — JSON parser stores raw pointers into it.
        parsed = ParseJSON(buf)
        IfCondition EqualTo(parsed, 0) ThenBlock: { ReturnValue(0) }
        obj = JSON.AsObject(parsed)
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        arr = JSON.GetArray(obj, "main_set")
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }
        QuoteState.arr = arr
        QuoteState.count = JSON.ArrayLength(arr)
        // Seed RNG with current Unix time for variety each session
        QuoteState.rng = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        QuoteState.last_sec = QuoteState.rng
    }
}

Function.CC_NextQuote {
    Output: Address
    Body: {
        IfCondition EqualTo(QuoteState.count, 0) ThenBlock: { ReturnValue(0) }
        // Classic 32-bit Numerical Recipes LCG
        QuoteState.rng = Add(Multiply(QuoteState.rng, 1664525), 1013904223)
        rng_val = QuoteState.rng
        IfCondition LessThan(rng_val, 0) ThenBlock: { rng_val = Subtract(0, rng_val) }
        idx = Modulo(rng_val, QuoteState.count)
        q_tag = JSON.ArrayGet(QuoteState.arr, idx)
        ReturnValue(JSON.AsString(q_tag))
    }
}

Function.CC_ShowQuote {
    Body: {
        q = CC_NextQuote()
        IfCondition NotEqual(q, 0) ThenBlock: {
            UI.SetQuote(q)
        }
    }
}

// Called every 100ms while waiting for TTFT. Ticks the mascot every call,
// shows a new quote exactly every 10 seconds using wall-clock time.
Function.CC_AnimTick {
    Body: {
        UI.AnimTick()
        
        now_sec = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        elapsed = Subtract(now_sec, QuoteState.last_sec)
        IfCondition LessThan(elapsed, 0) ThenBlock: { QuoteState.last_sec = now_sec }
        IfCondition GreaterEqual(elapsed, 10) ThenBlock: { 
            CC_ShowQuote()
            QuoteState.last_sec = now_sec
        }
    }
}

// =============================================================================
// AGENT TURN — one user-message-to-final-response cycle.
// Runs the request->stream->maybe-dispatch-tools loop until the model
// stops calling tools.
// =============================================================================
Function.CC_GetProcessVirt_MB {
    Output: Integer
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, "/proc/self/statm", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(128)
        n = SystemCall(CCSys.SYS_READ, fd, buf, 127, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 128)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        virt_pages = 0
        i = 0
        WhileLoop 1 {
            c = GetByte(buf, i)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 32) ThenBlock: { BreakLoop }
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                virt_pages = Add(Multiply(virt_pages, 10), Subtract(c, 48))
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 128)
        ReturnValue(Divide(virt_pages, 256))
    }
}

Function.CC_GetProcessRSS_MB {
    Output: Integer
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, "/proc/self/statm", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(128)
        n = SystemCall(CCSys.SYS_READ, fd, buf, 127, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 128)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        i = 0
        WhileLoop 1 {
            c = GetByte(buf, i)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 32) ThenBlock: { i = Add(i, 1)  BreakLoop }
            i = Add(i, 1)
        }
        rss_pages = 0
        WhileLoop 1 {
            c = GetByte(buf, i)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 32) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 10) ThenBlock: { BreakLoop }
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                rss_pages = Add(Multiply(rss_pages, 10), Subtract(c, 48))
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 128)
        ReturnValue(Divide(rss_pages, 256))
    }
}

Function.CC_LogStageMemory {
    Input: stage_name: Address
    Body: {
        rss_mb = CC_GetProcessRSS_MB()
        virt_mb = CC_GetProcessVirt_MB()
        hist_cnt = History.Count()

        m_log = StringConcat("[MEM-STAGE] ", stage_name)
        m_log = StringConcat(m_log, " | RSS: ")
        m_log = StringConcat(m_log, NumberToString(rss_mb))
        m_log = StringConcat(m_log, " MB | VIRT: ")
        m_log = StringConcat(m_log, NumberToString(virt_mb))
        m_log = StringConcat(m_log, " MB | History: ")
        m_log = StringConcat(m_log, NumberToString(hist_cnt))
        m_log = StringConcat(m_log, " msgs\n")

        CC_DebugLog(m_log)

        // Write to persistent instrument log: /tmp/hal_mem_instrument.log
        m_fd = SystemCall(CCSys.SYS_OPEN, "/tmp/hal_mem_instrument.log", 1089, 420, 0, 0) // O_WRONLY|O_CREAT|O_APPEND
        IfCondition GreaterEqual(m_fd, 0) ThenBlock: {
            SystemCall(CCSys.SYS_WRITE, m_fd, m_log, StringLength(m_log), 0, 0)
            SystemCall(CCSys.SYS_CLOSE, m_fd, 0, 0, 0, 0)
        }
    }
}

Function.CC_PrintMemoryReport {
    Body: {
        rss_mb = CC_GetProcessRSS_MB()
        virt_mb = CC_GetProcessVirt_MB()
        hist_cnt = History.Count()
        
        msg = StringConcat("RSS: ", NumberToString(rss_mb))
        msg = StringConcat(msg, " MB | VIRT: ")
        msg = StringConcat(msg, NumberToString(virt_mb))
        msg = StringConcat(msg, " MB | History: ")
        msg = StringConcat(msg, NumberToString(hist_cnt))
        msg = StringConcat(msg, " msgs")
        UI.ChatTag("ℹ", msg, 2)
        CC_LogStageMemory("USER_MEM_CMD")
    }
}

// Diagnostics copied out of the HTTP stream handle before it is closed.
// Layout: [0..127] request-id, [128..511] curl error message. Allocated
// lazily BEFORE Arena_ScratchBegin() in CC_RunTurn so it survives
// Arena_ScratchEnd() (same rule as CCRunState.line_buf).
FixedPool.CCHttpDiag {
    "buf": Initialize=0, CanChange=True
}

// Copy at most max-1 bytes of src into dst and NUL-terminate. src may be 0.
Function.CC_CopyStrBounded {
    Input: dst: Address
    Input: src: Address
    Input: max: Integer
    Body: {
        SetByte(dst, 0, 0)
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        n = StringLength(src)
        IfCondition GreaterThan(n, Subtract(max, 1)) ThenBlock: { n = Subtract(max, 1) }
        MemoryCopy(dst, src, n)
        SetByte(dst, n, 0)
    }
}

// Short human hint for an HTTP error status. Returns "" when there is none.
Function.CC_HttpStatusHint {
    Input: status: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(status, 400) ThenBlock: { ReturnValue("request rejected (malformed or unsupported parameters)") }
        IfCondition EqualTo(status, 401) ThenBlock: { ReturnValue("authentication failed, check the provider API key") }
        IfCondition EqualTo(status, 403) ThenBlock: { ReturnValue("forbidden, the key lacks access to this model or endpoint") }
        IfCondition EqualTo(status, 404) ThenBlock: { ReturnValue("not found, check the model name and provider URL") }
        IfCondition EqualTo(status, 408) ThenBlock: { ReturnValue("request timed out") }
        IfCondition EqualTo(status, 413) ThenBlock: { ReturnValue("request too large, the conversation exceeds the provider limit") }
        IfCondition EqualTo(status, 422) ThenBlock: { ReturnValue("request rejected (invalid parameters)") }
        IfCondition EqualTo(status, 429) ThenBlock: { ReturnValue("rate limited") }
        IfCondition EqualTo(status, 529) ThenBlock: { ReturnValue("provider overloaded") }
        IfCondition GreaterEqual(status, 500) ThenBlock: { ReturnValue("provider server error") }
        ReturnValue("")
    }
}

// Gauges the model was told to manage and could not read.
Function.CC_StatusReport {
    Input: chains: Integer
    Output: Address
    Body: {
        s = StringConcat("tokens_in: ", NumberToString(UILayout.tok_in))
        s = StringConcat(s, "\ntokens_out: ")
        s = StringConcat(s, NumberToString(UILayout.tok_out))
        s = StringConcat(s, "\nwindow: 180000")
        s = StringConcat(s, "\npct: ")
        s = StringConcat(s, NumberToString(UILayout.ctx_pct))
        s = StringConcat(s, "\ntool_chains: ")
        s = StringConcat(s, NumberToString(chains))
        s = StringConcat(s, "\ntool_chain_cap: none")
        proj = "(none)"
        IfCondition NotEqual(UILayout.proj_slug, 0) ThenBlock: {
            IfCondition GreaterThan(StringLength(UILayout.proj_slug), 0) ThenBlock: {
                proj = UILayout.proj_slug
            }
        }
        th = "(none)"
        IfCondition NotEqual(UILayout.thread_slug, 0) ThenBlock: {
            IfCondition GreaterThan(StringLength(UILayout.thread_slug), 0) ThenBlock: {
                th = UILayout.thread_slug
            }
        }
        s = StringConcat(s, "\nproject: ")
        s = StringConcat(s, proj)
        s = StringConcat(s, "\nthread: ")
        s = StringConcat(s, th)
        sbuf = Allocate(80)
        SetByte(sbuf, 0, 0)
        sn = CC_ReadAppFile("/tmp/halcode_app/session.txt", sbuf, 80)
        IfCondition LessEqual(sn, 0) ThenBlock: { sbuf = "(none)" }
        s = StringConcat(s, "\nsession: ")
        s = StringConcat(s, sbuf)
        s = StringConcat(s, "\nsession_log_bytes: ")
        s = StringConcat(s, NumberToString(CCRunState.log_bytes))
        ReturnValue(s)
    }
}

// One line the daemon can see. The model should not re-park this after every tool.
Function.CC_ParkDigest {
    Input: name: Address
    Input: arg: Address
    Input: is_err: Integer
    Body: {
        dig = name
        IfCondition EqualTo(dig, 0) ThenBlock: { dig = "?" }
        dig = StringConcat(dig, " ")
        IfCondition NotEqual(arg, 0) ThenBlock: { dig = StringConcat(dig, arg) }
        IfCondition EqualTo(is_err, 1) ThenBlock: {
            dig = StringConcat(dig, " -> error")
        } ElseBlock: {
            dig = StringConcat(dig, " -> ok")
        }
        park_args = JSON.NewObject()
        JSON.SetString(park_args, "op", "park")
        JSON.SetString(park_args, "key", "tool_digest")
        JSON.SetString(park_args, "kind", "note")
        JSON.SetString(park_args, "scope", "persistent")
        JSON.SetString(park_args, "content", dig)
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        pgmem_ret = IPCDispatch.Dispatch("Pgmem", park_args, "", perr)
        Deallocate(perr, 8)
        IfCondition NotEqual(pgmem_ret, 0) ThenBlock: {
            Deallocate(pgmem_ret, Add(StringLength(pgmem_ret), 1))
        }
    }
}

// Last line of a tool result when it is a truncation trailer.
// Read and LS append "[truncated ...]". Parking replaces the body
// with a short stub, and that trailer has to stay visible.
Function.CC_ParkTruncLine {
    Input: content: Address
    Output: Address
    Body: {
        IfCondition EqualTo(content, 0) ThenBlock: { ReturnValue(0) }
        clen = StringLength(content)
        IfCondition LessEqual(clen, 12) ThenBlock: { ReturnValue(0) }
        i = Subtract(clen, 1)
        WhileLoop And(GreaterThan(i, 0), NotEqual(GetByte(content, i), 10)) {
            i = Subtract(i, 1)
        }
        start = 0
        IfCondition EqualTo(GetByte(content, i), 10) ThenBlock: {
            start = Add(i, 1)
        }
        mark = "[truncated"
        mlen = StringLength(mark)
        IfCondition LessThan(Subtract(clen, start), mlen) ThenBlock: { ReturnValue(0) }
        j = 0
        WhileLoop LessThan(j, mlen) {
            IfCondition NotEqual(GetByte(content, Add(start, j)), GetByte(mark, j)) ThenBlock: {
                ReturnValue(0)
            }
            j = Add(j, 1)
        }
        ReturnValue(Add(content, start))
    }
}

Function.CC_RunTurn {
    Output: Integer
    Body: {
        request_ok = 0
        rss_turn_start = CC_GetProcessRSS_MB()
        m_start_msg = StringConcat("Start of turn. Process RSS: ", NumberToString(rss_turn_start))
        m_start_msg = StringConcat(m_start_msg, " MB\n")
        CC_DebugLog(m_start_msg)

        keep_going = 1
        chain_count = 0
        CC_DebugLog("\n\n==================== NEW TURN ====================\n")
        WhileLoop EqualTo(keep_going, 1) {
            keep_going = 0

            chain_count = Add(chain_count, 1)

            // --- Retry Loop for API calls ---
            max_retries = 3
            retry_count = 0
            request_ok = 0
            permanent_fail = 0
            is_interrupted_turn = 0
            retry_delay_ms = 2000

            WhileLoop And(And(LessThan(retry_count, max_retries), EqualTo(request_ok, 0)), EqualTo(permanent_fail, 0)) {

            CC_DebugLog("Building request...\n")
            CC_LogStageMemory("BEFORE_BUILD_REQUEST")

            messages = History.GetMessagesArray()
            tools = IPCDispatch.GetToolSchemasArray()
            IfCondition EqualTo(CCRunState.line_buf, 0) ThenBlock: {
                CCRunState.line_buf = Allocate(CCConst.LINE_BUF_SZ)
            }
            IfCondition EqualTo(CCHttpDiag.buf, 0) ThenBlock: {
                CCHttpDiag.buf = Allocate(512)
            }
            Arena_ScratchBegin()
            body = Backend.BuildRequest(messages, tools)
            CC_LogStageMemory("AFTER_BUILD_REQUEST")

            // Dump full request so malformed JSON is inspectable at column 17271.
            _bfd = SystemCall(CCSys.SYS_OPEN, "/tmp/hal_body.json", 577, 420, 0, 0)
            IfCondition GreaterEqual(_bfd, 0) ThenBlock: {
                SystemCall(CCSys.SYS_WRITE, _bfd, body, StringLength(body), 0, 0)
                SystemCall(CCSys.SYS_CLOSE, _bfd, 0, 0, 0, 0)
            }
            _mfd = SystemCall(CCSys.SYS_OPEN, "/tmp/hal_msgs.json", 577, 420, 0, 0)
            IfCondition GreaterEqual(_mfd, 0) ThenBlock: {
                _ms = JSON.SerializeArray(messages)
                IfCondition NotEqual(_ms, 0) ThenBlock: {
                    SystemCall(CCSys.SYS_WRITE, _mfd, _ms, StringLength(_ms), 0, 0)
                }
                SystemCall(CCSys.SYS_CLOSE, _mfd, 0, 0, 0, 0)
            }

            body_len_str = StringConcat("Request body size: ", NumberToString(StringLength(body)))
            body_len_str = StringConcat(body_len_str, " bytes\n")
            CC_DebugLog(body_len_str)
            dbg_body_len = StringLength(body)
            IfCondition GreaterThan(dbg_body_len, 256) ThenBlock: { dbg_body_len = 256 }
            dbg_body_buf = Allocate(Add(dbg_body_len, 1))
            MemoryCopy(dbg_body_buf, body, dbg_body_len)
            SetByte(dbg_body_buf, dbg_body_len, 0)
            CC_DebugLog(StringConcat("Request body (first 256 bytes):\n", dbg_body_buf))
            CC_DebugLog("\n---\n")
            Deallocate(dbg_body_buf, Add(dbg_body_len, 1))

            IfCondition EqualTo(body, 0) ThenBlock: {
                Arena_ScratchEnd()
                BreakLoop
            }
            url = Backend.GetURL()

            base_headers = Backend.BuildHeaders()
            // Empty Expect header prevents curl from hanging on 100-continue for >1KB bodies
            ua_header = "User-Agent: HalCode9000/1.0\nExpect:\n"
            
            clen_header = StringConcat("Content-Length: ", NumberToString(StringLength(body)))
            clen_header = StringConcat(clen_header, "\n")
            
            headers = StringConcat(base_headers, ua_header)
            headers = StringConcat(headers, clen_header)

            UI.SetState(1)
            CC_ShowQuote()
            QuoteState.last_sec = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
            CC_DebugLog("Sending HTTP POST request...\n")

            IfCondition GreaterThan(retry_count, 0) ThenBlock: {
                retry_msg = StringConcat("Retrying request (", NumberToString(Add(retry_count, 1)))
                retry_msg = StringConcat(retry_msg, "/")
                retry_msg = StringConcat(retry_msg, NumberToString(max_retries))
                retry_msg = StringConcat(retry_msg, ")...")
                UI.ChatPrintDim(retry_msg)
            }

            handle = HTTP.PostStream(url, headers, body, 10000, 900000)
            IfCondition EqualTo(handle, 0) ThenBlock: {
                Arena_ScratchEnd()
                CC_DebugLog("HTTP.PostStream FAILED (curl spawn error).\n")
                UI.ChatTag("✗", "HTTP request failed (curl spawn)", 1)
                CC_SleepAnimated(CC_RandomMs(retry_delay_ms))
                retry_delay_ms = Multiply(retry_delay_ms, 2)
                IfCondition GreaterThan(retry_delay_ms, 30000) ThenBlock: { retry_delay_ms = 30000 }
                retry_count = Add(retry_count, 1)
                ContinueLoop
            }

            sse_state = Allocate(CCConst.SSE_STATE_SZ)
            SSE.Init(sse_state, CCConst.SSE_STATE_SZ)
            // Reuse a single 1MB scratch buffer for the stream read instead of
            // allocating/freeing a fresh block on every request.
            IfCondition EqualTo(CCRunState.line_buf, 0) ThenBlock: {
                CCRunState.line_buf = Allocate(CCConst.LINE_BUF_SZ)
            }
            line_buf = CCRunState.line_buf
            CC_DebugLog("Starting API stream read. See /tmp/hal_turn.log for raw line data.\n")
            CC_AgentLog("[worker] API stream start")

            stream_done = 0
            line_count = 0
            is_api_error = 0
            clean_stop = 0
            consecutive_timeouts = 0
            WhileLoop EqualTo(stream_done, 0) {
                CC_AnimTick()
                
                IfCondition EqualTo(UI.HasInterrupt(), 1) ThenBlock: {
                    CC_DebugLog("User interrupted stream.\n")
                    stream_done = 1
                    is_interrupted_turn = 1
                    BreakLoop
                }

                // Read up to SZ-1 so we can safely null-terminate the buffer for UI/String functions
                line_len = HTTP.ReadLineTimeout(handle, line_buf, Subtract(CCConst.LINE_BUF_SZ, 1), 15)
                IfCondition EqualTo(line_len, -2) ThenBlock: {
                    IfCondition EqualTo(UI.HasInterrupt(), 1) ThenBlock: {
                        CC_DebugLog("User interrupted stream.\n")
                        stream_done = 1
                        is_interrupted_turn = 1
                        BreakLoop
                    }
                    consecutive_timeouts = Add(consecutive_timeouts, 1)
                    IfCondition GreaterThan(consecutive_timeouts, 6000) ThenBlock: {
                        CC_DebugLog("Stream timed out (no data for 90s).\n")
                        stream_done = 1
                        BreakLoop
                    }
                    ContinueLoop
                }
                consecutive_timeouts = 0
                IfCondition GreaterEqual(line_len, 0) ThenBlock: {
                    SetByte(line_buf, line_len, 0)
                }
                    line_count = Add(line_count, 1)
                IfCondition LessThan(line_len, 0) ThenBlock: {
                    CC_AgentLog(StringConcat("[worker] stream readline len=", NumberToString(line_len)))
                    stream_done = 1
                } ElseBlock: {
                    IfCondition EqualTo(line_count, 1) ThenBlock: {
                        CC_AgentLog(StringConcat("[worker] stream first line len=", NumberToString(line_len)))
                    }
                    // Catch raw JSON errors (429 Rate Limit, 400 Bad Request) that aren't SSE
                    first_b = GetByte(line_buf, 0)
                    is_err_fmt = 0
                    IfCondition Or(EqualTo(first_b, 123), EqualTo(first_b, 60)) ThenBlock: { is_err_fmt = 1 } // { or <
                    IfCondition And(EqualTo(is_api_error, 0), EqualTo(is_err_fmt, 1)) ThenBlock: {
                        is_api_error = 1
                        UI.SetState(0)
                        UI.ChatTag("✗", "API Error (Rate Limit / Bad Request):", 1) // 1 = RED_FG
                    }
                    // Catch permanent errors like "Failed to parse the request body" (non-retryable)
                    // These start with 'F'=70 and indicate a broken request, not a transient drop.
                    IfCondition And(EqualTo(is_api_error, 0), EqualTo(first_b, 70)) ThenBlock: {
                        _f1 = GetByte(line_buf, 1)
                        _f2 = GetByte(line_buf, 2)
                        _f3 = GetByte(line_buf, 3)
                        _f4 = GetByte(line_buf, 4)
                        _f5 = GetByte(line_buf, 5)
                        // "Failed" = 70 97 105 108 101 100
                        IfCondition And(And(EqualTo(_f1, 97), EqualTo(_f2, 105)), And(EqualTo(_f3, 108), EqualTo(_f4, 101))) ThenBlock: {
                            is_api_error = 1
                            permanent_fail = 1
                            UI.SetState(0)
                            UI.ChatTag("✗", "Permanent API error (bad request — fix and retry):", 1)
                        }
                    }
                    
                    IfCondition EqualTo(is_api_error, 1) ThenBlock: {
                        IfCondition GreaterThan(line_len, 0) ThenBlock: {
                            UI.ChatPrintln(line_buf)
                        }
                    } ElseBlock: {
                        ready = SSE.FeedLine(sse_state, line_buf, line_len)
                        IfCondition EqualTo(ready, 1) ThenBlock: {
                            evt_type = SSE.GetEventType(sse_state)
                            evt_data = SSE.GetEventData(sse_state)
                            signal = Backend.OnEvent(evt_type, evt_data)
                            SSE.Reset(sse_state)
                            IfCondition NotEqual(signal, 0) ThenBlock: {
                                stream_done = 1
                                clean_stop = 1
                            }
                        }
                    }
                }
            }

            // Capture response status/diagnostics BEFORE CloseStream: the strings
            // point into the stream handle. -1 = unknown (e.g. interrupted).
            http_status = HTTP.GetStatus(handle)
            http_retry_after = HTTP.GetRetryAfter(handle)
            CC_CopyStrBounded(CCHttpDiag.buf, HTTP.GetRequestId(handle), 128)
            CC_CopyStrBounded(Add(CCHttpDiag.buf, 128), HTTP.GetErrorMsg(handle), 384)
            CC_DebugLog(StringConcat("HTTP status=", NumberToString(http_status)))
            CC_DebugLog(StringConcat(" request-id=", CCHttpDiag.buf))
            CC_DebugLog("\n")
            HTTP.CloseStream(handle)
            Deallocate(sse_state, CCConst.SSE_STATE_SZ)
            Deallocate(body, Add(StringLength(body), 1))
            Arena_ScratchEnd()

            // Check if the backend saw a finish_reason before the connection dropped
            IfCondition EqualTo(clean_stop, 0) ThenBlock: {
                clean_stop = Backend.IsCleanStop()
            }

            // Interrupt always wins. IsCleanStop can already be true (finish_reason
            // arrived) while text/args buffers are truncated mid-UTF-8 character.
            // Committing that poisons every later request with
            // "invalid unicode code point".
            IfCondition EqualTo(is_interrupted_turn, 1) ThenBlock: {
                UI.ChatTag("✗", "Turn interrupted by user.", 3)

                user_msg = UI.ConsumeInterrupt()
                msg_len = StringLength(user_msg)
                IfCondition GreaterThan(msg_len, 0) ThenBlock: {
                    UI.ChatTag("›", user_msg, 6)
                    // AppendUser aliases the pointer — do not Deallocate.
                    History.AppendUser(user_msg)
                    keep_going = 1
                }
                request_ok = 0
                BreakLoop
            }

            // Check for mid-stream drop
            IfCondition And(EqualTo(clean_stop, 0), EqualTo(is_api_error, 0)) ThenBlock: {
                CC_DebugLog("API stream DROPPED without clean stop.\n")
                CC_AgentLog("[worker] API stream DROPPED without clean stop")
                // Prefer curl's real reason (DNS, connect, TLS, timeout) over a guess.
                IfCondition GreaterThan(StringLength(Add(CCHttpDiag.buf, 128)), 0) ThenBlock: {
                    UI.ChatTag("✗", StringConcat("Connection error: ", Add(CCHttpDiag.buf, 128)), 1)
                } ElseBlock: {
                    UI.ChatTag("✗", "API connection dropped mid-stream (Overload / Timeout)", 1)
                }
                UI.SetState(0)
                is_api_error = 1
            } ElseBlock: {
                IfCondition EqualTo(is_api_error, 0) ThenBlock: {
                    CC_DebugLog("API stream finished with clean stop.\n")
                }
            }

            // ---- Classify by HTTP status ----
            // 4xx other than 408/429 can never succeed on retry: fail fast.
            // 408/429/5xx (incl. 529 overloaded) retry with backoff, raised to the
            // server's Retry-After. A Retry-After over 60s (e.g. a daily quota) stops
            // instead of waiting silently. Status 0/-1 (no response / unknown) keeps
            // the drop handling above.
            wait_floor_ms = 0
            IfCondition GreaterEqual(http_status, 400) ThenBlock: {
                IfCondition EqualTo(is_api_error, 0) ThenBlock: {
                    is_api_error = 1
                    UI.SetState(0)
                }
                IfCondition And(LessThan(http_status, 500), And(NotEqual(http_status, 408), NotEqual(http_status, 429))) ThenBlock: {
                    permanent_fail = 1
                }
                IfCondition GreaterThan(http_retry_after, 60) ThenBlock: { permanent_fail = 1 }
                IfCondition GreaterThan(http_retry_after, 0) ThenBlock: {
                    wait_floor_ms = Multiply(http_retry_after, 1000)
                }
                status_msg = StringConcat("HTTP ", NumberToString(http_status))
                status_hint = CC_HttpStatusHint(http_status)
                IfCondition GreaterThan(StringLength(status_hint), 0) ThenBlock: {
                    status_msg = StringConcat(status_msg, " — ")
                    status_msg = StringConcat(status_msg, status_hint)
                }
                IfCondition GreaterThan(http_retry_after, 0) ThenBlock: {
                    status_msg = StringConcat(status_msg, " (server asks to wait ")
                    status_msg = StringConcat(status_msg, NumberToString(http_retry_after))
                    status_msg = StringConcat(status_msg, "s)")
                }
                IfCondition GreaterThan(StringLength(CCHttpDiag.buf), 0) ThenBlock: {
                    status_msg = StringConcat(status_msg, " [request-id ")
                    status_msg = StringConcat(status_msg, CCHttpDiag.buf)
                    status_msg = StringConcat(status_msg, "]")
                }
                UI.ChatTag("✗", status_msg, 1)
            }

            // If there was any API error, retry with backoff. Otherwise, mark as success.
            IfCondition EqualTo(is_api_error, 1) ThenBlock: {
                CC_DebugLog(StringConcat("API error detected. Retry ", NumberToString(Add(retry_count, 1))))
                CC_DebugLog("\n")
                retry_count = Add(retry_count, 1)
                IfCondition EqualTo(permanent_fail, 1) ThenBlock: {
                    // Not retryable: no backoff sleep, just clear in-flight state.
                    Backend.Reset()
                    UI.SetReasoning("")
                } ElseBlock: {
                IfCondition LessThan(retry_count, max_retries) ThenBlock: {
                    wait_ms = CC_RandomMs(retry_delay_ms)
                    IfCondition GreaterThan(wait_floor_ms, wait_ms) ThenBlock: { wait_ms = wait_floor_ms }
                    CC_SleepAnimated(wait_ms)
                    retry_delay_ms = Multiply(retry_delay_ms, 2)
                    IfCondition GreaterThan(retry_delay_ms, 30000) ThenBlock: { retry_delay_ms = 30000 }
                    Backend.Reset()
                    UI.SetReasoning("")
                }
                }
            } ElseBlock: {
                request_ok = 1
                CC_DebugLog("Request OK.\n")
                CC_AgentLog("[worker] Request OK")
                CC_LogStageMemory("AFTER_API_STREAM")
            }

            } // --- End of Retry Loop ---

            UI.SetState(2)
            UI.ChatPrintln("")
            IfCondition EqualTo(request_ok, 0) ThenBlock: {
                IfCondition EqualTo(is_interrupted_turn, 0) ThenBlock: {
                    IfCondition EqualTo(permanent_fail, 1) ThenBlock: {
                        UI.ChatTag("✗", "Request rejected, not retrying. Fix the cause above and resend. Any completed tool work is in /tmp/hal_turn_log.txt", 1)
                    } ElseBlock: {
                        UI.ChatTag("✗", "All retries exhausted. Any completed tool work is in /tmp/hal_turn_log.txt", 1)
                    }
                }
            }

            // Only commit to history and dispatch tools if the final request was successful
            IfCondition EqualTo(request_ok, 1) ThenBlock: {
                CC_DebugLog("Committing assistant message to history.\n")
                Backend.CommitAssistantToHistory()
                History.PinAssistantText(Backend.GetResponseText())
                CC_SessionLogResponse()
                Backend.PrintUsage()

                // Pending tools?
                pending = Backend.GetPendingTools()
                n_tools = JSON.ArrayLength(pending)
                IfCondition GreaterThan(n_tools, 0) ThenBlock: {
                    log_nt = StringConcat("Model requested ", NumberToString(n_tools))
                    log_nt = StringConcat(log_nt, " tool calls.\n")
                    CC_DebugLog(log_nt)
                    UI.ToolGroupStart(n_tools)
                    results = JSON.NewArray()
                    i = 0
                    WhileLoop LessThan(i, n_tools) {
                        CC_DebugLog(StringConcat("[STEP H1] Starting tool loop index ", NumberToString(i)))
                        CC_DebugLog("\n")
                        tu_tag = JSON.ArrayGet(pending, i)
                        CC_DebugLog("[STEP H2] ArrayGet done\n")
                        tu = JSON.AsObject(tu_tag)
                        CC_DebugLog("[STEP H3] AsObject done\n")
                        IfCondition NotEqual(tu, 0) ThenBlock: {
                            // Use stable accessors that bypass the JSON-lib
                            // hash-collision bug. Name/id come from a parallel
                            // string-pointer array stashed at content_block_start.
                            tname = Backend.GetToolName(i)
                            CC_DebugLog("[STEP H4] GetToolName done: ")
                            CC_DebugLog(tname)
                            CC_DebugLog("\n")
                            tid   = Backend.GetToolId(i)
                            CC_DebugLog("[STEP H5] GetToolId done\n")
                            tinput = JSON.GetObject(tu, "input")
                            CC_DebugLog("[STEP H6] GetObject input done\n")

                            // Build a short arg summary for display.
                            // Use "path" if present, else the first JSON value, else "".
                            arg_sum = ""
                            IfCondition NotEqual(tinput, 0) ThenBlock: {
                                ps = JSON.GetString(tinput, "path")
                                IfCondition NotEqual(ps, 0) ThenBlock: { arg_sum = ps }
                                IfCondition EqualTo(StringLength(arg_sum), 0) ThenBlock: {
                                    cs = JSON.GetString(tinput, "command")
                                    IfCondition NotEqual(cs, 0) ThenBlock: { arg_sum = cs }
                                }
                                IfCondition EqualTo(StringLength(arg_sum), 0) ThenBlock: {
                                    us = JSON.GetString(tinput, "url")
                                    IfCondition NotEqual(us, 0) ThenBlock: { arg_sum = us }
                                }
                                IfCondition EqualTo(StringLength(arg_sum), 0) ThenBlock: {
                                    tp = JSON.GetString(tinput, "task_prompt")
                                    IfCondition NotEqual(tp, 0) ThenBlock: { arg_sum = tp }
                                }
                                IfCondition EqualTo(StringLength(arg_sum), 0) ThenBlock: {
                                    op = JSON.GetString(tinput, "op")
                                    IfCondition NotEqual(op, 0) ThenBlock: {
                                        qy = JSON.GetString(tinput, "query")
                                        IfCondition NotEqual(qy, 0) ThenBlock: { arg_sum = StringConcat(op, " ")  arg_sum = StringConcat(arg_sum, qy) }
                                        IfCondition EqualTo(qy, 0) ThenBlock: { arg_sum = op }
                                    }
                                }
                            }
                            UI.ToolCallStart(tname, arg_sum, i, n_tools)
                            CC_SessionLogTool(tname, arg_sum)

                            log_msg = StringConcat("Dispatching tool [", tname)
                            log_msg = StringConcat(log_msg, "]\n")
                            CC_DebugLog(log_msg)

                            IfCondition EqualTo(UI.HasInterrupt(), 1) ThenBlock: {
                                CC_DebugLog("[STEP H7] skipped — user interrupt\n")
                                content = "Interrupted by user."
                                is_err = 1
                                ok_flag = 0
                            } ElseBlock: {
                            IfCondition EqualTo(StringCompare(tname, "Status"), 0) ThenBlock: {
                                content = CC_StatusReport(chain_count)
                                is_err = 0
                                ok_flag = 1
                            } ElseBlock: {
                            CC_DebugLog("[STEP H7] Allocating err_holder and calling IPCDispatch.Dispatch\n")
                            err_holder = Allocate(8)
                            StoreValue(err_holder, 0, "dword")
                            content = IPCDispatch.Dispatch(tname, tinput, tid, err_holder)
                            CC_DebugLog("[STEP H8] IPCDispatch.Dispatch returned!\n")
                            is_err = Dereference(err_holder, "dword")
                            Deallocate(err_holder, 8)
                            ok_flag = 1
                            }
                            }

                            log_msg = StringConcat("Tool [", tname)
                            log_msg = StringConcat(log_msg, "] returned. is_err=")
                            log_msg = StringConcat(log_msg, NumberToString(is_err))
                            log_msg = StringConcat(log_msg, ". Content size: ")
                            log_msg = StringConcat(log_msg, NumberToString(StringLength(content)))
                            log_msg = StringConcat(log_msg, " bytes.\n")
                            CC_DebugLog(log_msg)
                            CC_DebugLog("Tool content (first 256 bytes):\n---\n")
                            dbg_tool_len = StringLength(content)
                            IfCondition GreaterThan(dbg_tool_len, 256) ThenBlock: { dbg_tool_len = 256 }
                            CC_DebugLog(StringConcat(content, "\n---\n"))

                            IfCondition EqualTo(is_err, 1) ThenBlock: { ok_flag = 0 }
                            UI.ToolCallEnd(ok_flag, i, n_tools)
                            CC_TurnLog(tname, arg_sum, content)
                            CC_SessionLogToolResult(tname, content, is_err)
                            IfCondition And(NotEqual(StringCompare(tname, "Pgmem"), 0), NotEqual(StringCompare(tname, "Status"), 0)) ThenBlock: {
                                CC_ParkDigest(tname, arg_sum, is_err)
                            }

                            // Park large results in pgmem — avoids stuffing 50KB bash
                            // output into context on every subsequent turn.
                            IfCondition GreaterThan(StringLength(content), CCConst.PARK_THRESHOLD) ThenBlock: {
                                park_key = StringConcat("result_", tname)
                                park_key = StringConcat(park_key, "_")
                                t_now = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
                                park_key = StringConcat(park_key, NumberToString(t_now))
                                park_args = JSON.NewObject()
                                JSON.SetString(park_args, "op", "park")
                                JSON.SetString(park_args, "key", park_key)
                                JSON.SetString(park_args, "kind", "tool_result")
                                JSON.SetString(park_args, "content", content)
                                perr = Allocate(8)
                                StoreValue(perr, 0, "dword")
                                pgmem_ret = IPCDispatch.Dispatch("Pgmem", park_args, "", perr)
                                park_failed = Dereference(perr, "dword")
                                Deallocate(perr, 8)
                                // Do not JSON.Free(park_args): SetString aliased
                                // literals ("park", "tool_result") and `content`.
                                IfCondition NotEqual(pgmem_ret, 0) ThenBlock: {
                                    Deallocate(pgmem_ret, Add(StringLength(pgmem_ret), 1))
                                }
                                trunc_line = CC_ParkTruncLine(content)
                                IfCondition EqualTo(park_failed, 0) ThenBlock: {
                                    CC_DebugLog("Parked large tool output to Pgmem.\n")
                                    nbytes = NumberToString(StringLength(content))
                                    stub = StringConcat("[parked ", nbytes)
                                    stub = StringConcat(stub, " bytes key=")
                                    stub = StringConcat(stub, park_key)
                                    stub = StringConcat(stub, "]")
                                    IfCondition NotEqual(trunc_line, 0) ThenBlock: {
                                        stub = StringConcat(stub, "\n")
                                        stub = StringConcat(stub, trunc_line)
                                    }
                                    content = stub
                                } ElseBlock: {
                                    CC_DebugLog("Pgmem parking FAILED. Truncating output.\n")
                                    // Fallback: hard truncate output if Pgmem parking fails
                                    orig_len_str = NumberToString(StringLength(content))
                                    t_buf = Allocate(Add(CCConst.PARK_THRESHOLD, 1))
                                    k_cp = 0
                                    WhileLoop LessThan(k_cp, CCConst.PARK_THRESHOLD) {
                                        SetByte(t_buf, k_cp, GetByte(content, k_cp))
                                        k_cp = Add(k_cp, 1)
                                    }
                                    SetByte(t_buf, CCConst.PARK_THRESHOLD, 0)
                                    
                                    warn_msg = StringConcat("\n\n[WARNING: Output truncated to ", NumberToString(CCConst.PARK_THRESHOLD))
                                    warn_msg = StringConcat(warn_msg, " bytes. Full size: ")
                                    warn_msg = StringConcat(warn_msg, orig_len_str)
                                    warn_msg = StringConcat(warn_msg, " bytes. Pgmem parking failed!]")
                                    
                                    content = StringConcat(t_buf, warn_msg)
                                    Deallocate(t_buf, Add(CCConst.PARK_THRESHOLD, 1))
                                    IfCondition NotEqual(trunc_line, 0) ThenBlock: {
                                        content = StringConcat(content, "\n")
                                        content = StringConcat(content, trunc_line)
                                    }
                                }
                            }

                             CC_DebugLog("[STEP H9] Creating result JSON object r\n")
                             r = JSON.NewObject()
                             IfCondition NotEqual(tid, 0) ThenBlock: {
                                 tid_copy = CC_StrDup(tid)
                                 JSON.SetString(r, "tool_use_id", tid_copy)
                             }
                             IfCondition NotEqual(content, 0) ThenBlock: {
                                 content_copy = CC_StrDup(content)
                                 JSON.SetString(r, "content", content_copy)
                             }
                             IfCondition EqualTo(is_err, 1) ThenBlock: {
                                 JSON.SetBool(r, "is_error", 1)
                             }
                             CC_DebugLog("[STEP H10] Pushing r to results array\n")
                             JSON.PushObject(results, r)
                         }
                         i = Add(i, 1)
                     }
                     CC_DebugLog("[STEP H11] Appending tool results to history.\n")
                     UI.ToolGroupEnd(n_tools)
                     Backend.AppendToolResultsToHistory(results)
                     CC_DebugLog("[STEP H12] Freeing results array\n")
                     // NewArray() returns an untagged 32-byte Array header.
                     // JSON.Free() expects a 16-byte tagged value and would
                     // Deallocate(results, 16), corrupting the arena.
                     JSON.FreeArray(results)
                     CC_LogStageMemory("AFTER_TOOL_DISPATCH")
                     CC_DebugLog("[STEP H13] Calling Backend.Reset()\n")
                     Backend.Reset()
                     UI.SetReasoning("")
                     IfCondition EqualTo(UI.HasInterrupt(), 1) ThenBlock: {
                         CC_DebugLog("[STEP H14] Tool dispatch loop complete. Interrupted — not auto-continuing.\n")
                         steer = UI.ConsumeInterrupt()
                         IfCondition And(NotEqual(steer, 0), GreaterThan(StringLength(steer), 0)) ThenBlock: {
                             History.AppendUser(steer)
                         }
                         keep_going = 0
                     } ElseBlock: {
                         CC_DebugLog("[STEP H14] Tool dispatch loop complete. Setting keep_going=1\n")
                         keep_going = 1
                     }
                } ElseBlock: {
                    CC_DebugLog("No tools requested. Turn complete.\n")
                    Backend.Reset()
                    UI.SetReasoning("")
                    dropped = History.EvictCompletedTurns()
                    IfCondition GreaterThan(dropped, 0) ThenBlock: {
                        evict_msg = StringConcat("evicted ", NumberToString(dropped))
                        UI.ChatTag("·", evict_msg, 8)
                    }
                    CC_LogStageMemory("AFTER_EVICT_COMPLETED")
                    IfCondition EqualTo(UI.HasInterrupt(), 1) ThenBlock: {
                        steer = UI.ConsumeInterrupt()
                        IfCondition And(NotEqual(steer, 0), GreaterThan(StringLength(steer), 0)) ThenBlock: {
                            History.AppendUser(steer)
                            keep_going = 1
                        }
                    }
                }
            } ElseBlock: {
                IfCondition EqualTo(is_interrupted_turn, 1) ThenBlock: {
                    CC_DebugLog("Turn interrupted. Restarting with new user input.\n")
                    Backend.Reset()
                    CC_SleepMs(1000)
                } ElseBlock: {
                    CC_DebugLog("Request FAILED after retries. Turn aborted.\n")
                    CC_AgentLog("[worker] Request FAILED after retries")
                    UI.ChatTag("✗", "Turn failed after retries. Results saved to /tmp/hal_turn_log.txt — try again and ask the model to write in smaller chunks (<=500 lines per Write call).", 1)
                    fail_msg = "hal: API stream dropped — no tokens. Check model/key (see /tmp/halcode_app/agent.err).\n"
                    CC_WriteAppFile("/tmp/halcode_app/think.tmp", fail_msg)
                    SystemCall(CCSys.SYS_RENAME, "/tmp/halcode_app/think.tmp", "/tmp/halcode_app/think.txt", 0, 0, 0)
                    CC_WriteAppFile("/tmp/halcode_app/reply.tmp", fail_msg)
                    SystemCall(CCSys.SYS_RENAME, "/tmp/halcode_app/reply.tmp", "/tmp/halcode_app/reply.txt", 0, 0, 0)
                    Backend.Reset()
                }
            }

            rss_turn_end = CC_GetProcessRSS_MB()
            m_end_msg = StringConcat("End of turn. Process RSS: ", NumberToString(rss_turn_end))
            m_end_msg = StringConcat(m_end_msg, " MB (turn diff: ")
            m_end_msg = StringConcat(m_end_msg, NumberToString(Subtract(rss_turn_end, rss_turn_start)))
            m_end_msg = StringConcat(m_end_msg, " MB)\n")
            CC_DebugLog(m_end_msg)
        }
        CC_AgentLog(StringConcat("[worker] CC_RunTurn return request_ok=", NumberToString(request_ok)))
        ReturnValue(request_ok)
    }
}



// =============================================================================
// DEMO MODE — render a sample conversation without real auth/tools.
// Now driven by the raw-mode UI primitives.
// =============================================================================
Function.CC_RunDemo {
    Body: {
        UI.Init()
        UI.SessionHeader(0, 0, 0)
        UI.ChatTag("›", "read /etc/hostname", 6)
        UI.ToolCallStart("Read", "/etc/hostname")
        UI.ToolCallEnd(1)
        UI.ChatPrintln("")
        UI.ChatPrintln("The file /etc/hostname contains: <hostname>")
        UI.ChatPrintln("")
        UI.PrintHelp()
        // Block until the user hits a key, then exit cleanly
        UI.ReadLine()
        UI.Shutdown()
    }
}

// Runs the standalone Python aggregator script to fetch live model definitions from provider APIs
Function.CC_RunModelScraper {
    Output: Integer
    Body: {
        CC_PrintStepHeader("Provider Model Aggregator")
        CC_WriteStdout("  Querying live model endpoints and updating provider configs...\n\n")
        sh_pid = SystemCall(CCSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition EqualTo(sh_pid, 0) ThenBlock: {
            argv = Allocate(32)
            sh_cmd = "python3 scripts/fetch_providers.py"
            sh_path = "/bin/sh"
            arg1 = "-c"
            StoreValue(Add(argv, 0), sh_path)
            StoreValue(Add(argv, 8), arg1)
            StoreValue(Add(argv, 16), sh_cmd)
            StoreValue(Add(argv, 24), 0)
            envp = CC_BuildInheritedEnvp()
            SystemCall(CCSys.SYS_EXECVE, sh_path, argv, envp)
            SystemCall(CCSys.SYS_EXIT, 1, 0, 0, 0, 0)
        }
        IfCondition GreaterThan(sh_pid, 0) ThenBlock: {
            wstat = Allocate(8)
            SystemCall(CCSys.SYS_WAIT4, sh_pid, wstat, 0, 0, 0)
            Deallocate(wstat, 8)
        }
        CC_WriteStdout("\n  Provider model definitions refreshed successfully.\n\n")
        CC_SleepMs(500)
        ReturnValue(1)
    }
}

// Prompt user for a new provider connection and write it to
// ~/.halcode/connections/conn_<ts>.json.  Returns 1 on success, 0 on cancel.
Function.CC_PromptAddConnection {
    Output: Integer
    Body: {
        CC_PrintStepHeader("Add Connection")
        CC_WriteStdout("  Backend type:\n")
        CC_WriteStdout("    1) Anthropic\n")
        CC_WriteStdout("    2) OpenAI-compatible  (OpenRouter, Grok, local, etc.)\n")
        CC_WriteStdout("    0) Cancel\n\n")
        CC_WriteStdout("  Choice: ")
        kbuf = Allocate(8)
        CC_ReadStdinLine(kbuf, 8)
        kind_ch = GetByte(kbuf, 0)
        Deallocate(kbuf, 8)
        IfCondition EqualTo(kind_ch, 48) ThenBlock: { ReturnValue(0) }   // '0' cancel

        backend_str = "openai"
        base_url_default = ""
        api_path_default = "/v1/chat/completions"
        IfCondition EqualTo(kind_ch, 49) ThenBlock: {   // '1' Anthropic
            backend_str = "anthropic"
            base_url_default = "https://api.anthropic.com"
            api_path_default = "/v1/messages"
        }

        CC_WriteStdout("\n  Display name: ")
        name_buf = Allocate(64)
        CC_ReadStdinLine(name_buf, 64)
        IfCondition EqualTo(StringLength(name_buf), 0) ThenBlock: {
            Deallocate(name_buf, 64)
            ReturnValue(0)
        }

        CC_WriteStdout("  Model (e.g. grok-3, meta-llama/llama-3.3-70b-instruct:free): ")
        model_buf = Allocate(128)
        CC_ReadStdinLine(model_buf, 128)
        IfCondition EqualTo(StringLength(model_buf), 0) ThenBlock: {
            Deallocate(name_buf, 64)
            Deallocate(model_buf, 128)
            ReturnValue(0)
        }

        url_buf = Allocate(128)
        IfCondition EqualTo(kind_ch, 49) ThenBlock: {   // Anthropic — URL is fixed
            i = 0
            WhileLoop LessThan(i, StringLength(base_url_default)) {
                SetByte(url_buf, i, GetByte(base_url_default, i))
                i = Add(i, 1)
            }
            SetByte(url_buf, i, 0)
        } ElseBlock: {
            CC_WriteStdout("  Base URL (e.g. https://openrouter.ai/api  or  https://api.x.ai): ")
            CC_ReadStdinLine(url_buf, 128)
            IfCondition EqualTo(StringLength(url_buf), 0) ThenBlock: {
                Deallocate(name_buf, 64)
                Deallocate(model_buf, 128)
                Deallocate(url_buf, 128)
                ReturnValue(0)
            }
        }

        // API path defaults are correct for all known providers; skip prompt
        api_path_str = api_path_default

        hint_buf = Allocate(32)
        CC_WriteStdout("  API key env-var hint (e.g. openrouter, xai, openai): ")
        CC_ReadStdinLine(hint_buf, 32)
        IfCondition EqualTo(StringLength(hint_buf), 0) ThenBlock: {
            hint_buf = "apikey"
        }

        // Build JSON manually — avoids Library.JSON hash-collision bug on write
        json = StringConcat("{\"name\":\"", name_buf)
        json = StringConcat(json, "\",\"backend\":\"")
        json = StringConcat(json, backend_str)
        json = StringConcat(json, "\",\"base_url\":\"")
        json = StringConcat(json, url_buf)
        json = StringConcat(json, "\",\"api_path\":\"")
        json = StringConcat(json, api_path_str)
        json = StringConcat(json, "\",\"default_model\":\"")
        json = StringConcat(json, model_buf)
        json = StringConcat(json, "\",\"key_hint\":\"")
        json = StringConcat(json, hint_buf)
        json = StringConcat(json, "\"}")

        // Write ~/.halcode/connections/conn_<timestamp>.json
        t = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        conn_dir = CC_ExpandHome("~/.halcode/connections")
        SystemCall(CCSys.SYS_MKDIR, conn_dir, 493, 0, 0, 0)   // 0755, ignores EEXIST
        fpath = StringConcat(conn_dir, "/conn_")
        fpath = StringConcat(fpath, NumberToString(t))
        fpath = StringConcat(fpath, ".json")
        // O_WRONLY|O_CREAT|O_TRUNC = 1|64|512 = 577, mode 0644 = 420
        wfd = SystemCall(CCSys.SYS_OPEN, fpath, 577, 420, 0, 0)
        IfCondition LessThan(wfd, 0) ThenBlock: {
            CC_WriteStdout("\n  Error: could not write connection file.\n")
            ReturnValue(0)
        }
        SystemCall(CCSys.SYS_WRITE, wfd, json, StringLength(json), 0, 0)
        SystemCall(CCSys.SYS_CLOSE, wfd, 0, 0, 0, 0)
        CC_WriteStdout("\n  Saved: ")
        CC_WriteStdout(fpath)
        CC_WriteStdout("\n")
        CC_SleepMs(800)
        ReturnValue(1)
    }
}

// Provider selection menu. Writes chosen provider fields into SelectedProvider.*
// (defined in backends/Backend.ailang) so Backend.Init can read them without
// going through JSON hash lookups — avoids the Library.JSON hash-collision bug
// (task #28) that maps "key_hint" and "default_model" to wrong buckets.
// Returns 1 as a non-zero sentinel; 0 means "no choice yet" (used by the
// default-Anthropic fallback inside CC_PromptProvider).
//
// "kind" is a BackendKind integer (1=ANTHROPIC, 2=OPENAI). Stored as an integer
// so Backend.Init can dispatch without StringCompare on the "backend" string —
// which was being clobbered by arena allocations in the Auth flow between
// CC_MakeProvider() and Backend.Init(), causing all OpenAI-compat providers
// (DeepSeek, Groq, etc.) to silently fall through to the Anthropic backend.
Function.CC_MakeProvider {
    Input: name: Address
    Input: backend: Address
    Input: base_url: Address
    Input: api_path: Address
    Input: default_model: Address
    Input: key_hint: Address
    Output: Integer
    Body: {
        SelectedProvider.name             = name
        SelectedProvider.backend          = backend
        SelectedProvider.base_url         = base_url
        SelectedProvider.api_path         = api_path
        SelectedProvider.default_model    = default_model
        SelectedProvider.key_hint         = key_hint
        SelectedProvider.reasoning_effort = 0
        // Detect kind while backend string pointer is fresh (before auth arena churn)
        SelectedProvider.kind = BackendKind.OPENAI
        IfCondition EqualTo(StringCompare(backend, "anthropic"), 0) ThenBlock: {
            SelectedProvider.kind = BackendKind.ANTHROPIC
        }
        IfCondition EqualTo(StringCompare(backend, "gemini"), 0) ThenBlock: {
            SelectedProvider.kind = BackendKind.GEMINI
        }
        ReturnValue(1)
    }
}

Function.CC_LoadAllProviderObjects {
    Output: Address
    Body: {
        all_arr = Array.Create(32)
        
        // 1. Try loading user providers (~/.halcode/providers)
        u_dir = CC_ExpandHome("~/.halcode/providers")
        u_arr = Backend.LoadProviders(u_dir)
        IfCondition NotEqual(u_arr, 0) ThenBlock: {
            u_sz = Array.Size(u_arr)
            ui = 0
            WhileLoop LessThan(ui, u_sz) {
                Array.Push(all_arr, Array.Get(u_arr, ui))
                ui = Add(ui, 1)
            }
        }
        
        // 2. Load repo providers (providers)
        r_arr = Backend.LoadProviders("providers")
        IfCondition NotEqual(r_arr, 0) ThenBlock: {
            r_sz = Array.Size(r_arr)
            ri = 0
            WhileLoop LessThan(ri, r_sz) {
                pobj = Array.Get(r_arr, ri)
                pname = JSON.GetString(pobj, "name")
                
                // Avoid adding duplicates if already loaded from user dir
                dup = 0
                all_sz = Array.Size(all_arr)
                ai = 0
                WhileLoop LessThan(ai, all_sz) {
                    aobj = Array.Get(all_arr, ai)
                    aname = JSON.GetString(aobj, "name")
                    IfCondition And(NotEqual(pname, 0), NotEqual(aname, 0)) ThenBlock: {
                        IfCondition EqualTo(StringCompare(pname, aname), 0) ThenBlock: {
                            dup = 1
                        }
                    }
                    ai = Add(ai, 1)
                }
                IfCondition EqualTo(dup, 0) ThenBlock: {
                    Array.Push(all_arr, pobj)
                }
                ri = Add(ri, 1)
            }
        }

        // 3. Load user custom connections (~/.halcode/connections)
        c_dir = CC_ExpandHome("~/.halcode/connections")
        c_arr = Backend.LoadProviders(c_dir)
        IfCondition NotEqual(c_arr, 0) ThenBlock: {
            c_sz = Array.Size(c_arr)
            ci = 0
            WhileLoop LessThan(ci, c_sz) {
                Array.Push(all_arr, Array.Get(c_arr, ci))
                ci = Add(ci, 1)
            }
        }

        ReturnValue(all_arr)
    }
}

Function.CC_PromptModelFromProvider {
    Input: prov_obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(prov_obj, 0) ThenBlock: { ReturnValue(1) }

        pname = JSON.GetString(prov_obj, "name")
        IfCondition EqualTo(pname, 0) ThenBlock: { pname = "Provider" }
        def_model = JSON.GetString(prov_obj, "default_model")
        IfCondition EqualTo(def_model, 0) ThenBlock: { def_model = "" }

        models_arr = JSON.GetArray(prov_obj, "models")
        mcount = 0
        IfCondition NotEqual(models_arr, 0) ThenBlock: {
            mcount = JSON.ArrayLength(models_arr)
        }

        IfCondition EqualTo(mcount, 0) ThenBlock: {
            CC_WriteStdout("\n  ")
            CC_WriteStdout(pname)
            CC_WriteStdout(" Model Selection:\n")
            CC_WriteStdout("    1) Default model  (")
            CC_WriteStdout(def_model)
            CC_WriteStdout(")\n")
            CC_WriteStdout("    m) Enter model name manually\n")
            CC_WriteStdout("    q) Back\n\n")
            CC_WriteStdout("  Choice [1]: ")
            mbuf = Allocate(64)
            CC_ReadStdinLine(mbuf, 64)
            mch = GetByte(mbuf, 0)
            Deallocate(mbuf, 64)
            IfCondition Or(EqualTo(mch, 113), EqualTo(mch, 81)) ThenBlock: { ReturnValue(0) }
            IfCondition Or(EqualTo(mch, 109), EqualTo(mch, 77)) ThenBlock: {
                CC_WriteStdout("  Model name: ")
                manbuf = Allocate(128)
                CC_ReadStdinLine(manbuf, 128)
                IfCondition GreaterThan(StringLength(manbuf), 0) ThenBlock: {
                    SelectedProvider.default_model = manbuf
                }
                Deallocate(manbuf, 128)
            }
            ReturnValue(1)
        }

        CC_WriteStdout("\n  ")
        CC_WriteStdout(pname)
        CC_WriteStdout(" Model Selection:\n")

        mi = 0
        WhileLoop LessThan(mi, mcount) {
            met = JSON.ArrayGet(models_arr, mi)
            mobj = JSON.AsObject(met)
            mid = 0
            mdisp = 0
            IfCondition NotEqual(mobj, 0) ThenBlock: {
                mid   = JSON.GetString(mobj, "id")
                mdisp = JSON.GetString(mobj, "display")
            }
            IfCondition EqualTo(mid, 0) ThenBlock: { mid = "?" }
            IfCondition EqualTo(mdisp, 0) ThenBlock: { mdisp = mid }

            CC_WriteStdout("    ")
            CC_WriteStdout(NumberToString(Add(mi, 1)))
            CC_WriteStdout(") ")
            CC_WriteStdout(mdisp)
            IfCondition NotEqual(StringCompare(mdisp, mid), 0) ThenBlock: {
                CC_WriteStdout("  (")
                CC_WriteStdout(mid)
                CC_WriteStdout(")")
            }
            IfCondition EqualTo(StringCompare(mid, def_model), 0) ThenBlock: {
                CC_WriteStdout("  — default")
            }
            CC_WriteStdout("\n")
            mi = Add(mi, 1)
        }

        CC_WriteStdout("    m) Enter model name manually\n")
        CC_WriteStdout("    q) Back\n\n")
        CC_WriteStdout("  Choice [1]: ")

        mbuf = Allocate(64)
        CC_ReadStdinLine(mbuf, 64)
        mch = GetByte(mbuf, 0)
        mval = StringToNumber(mbuf)
        Deallocate(mbuf, 64)

        IfCondition Or(EqualTo(mch, 113), EqualTo(mch, 81)) ThenBlock: { ReturnValue(0) }

        IfCondition Or(EqualTo(mch, 109), EqualTo(mch, 77)) ThenBlock: {
            CC_WriteStdout("  Model name: ")
            manbuf = Allocate(128)
            CC_ReadStdinLine(manbuf, 128)
            IfCondition GreaterThan(StringLength(manbuf), 0) ThenBlock: {
                SelectedProvider.default_model = manbuf
            }
            Deallocate(manbuf, 128)
            ReturnValue(1)
        }

        // If user pressed Enter (mval == 0 and mch == 10 or 0), select default model [1]
        IfCondition And(EqualTo(mval, 0), Or(EqualTo(mch, 10), EqualTo(mch, 0))) ThenBlock: {
            mval = 1
        }

        IfCondition And(GreaterEqual(mval, 1), LessEqual(mval, mcount)) ThenBlock: {
            chosen_met = JSON.ArrayGet(models_arr, Subtract(mval, 1))
            chosen_mobj = JSON.AsObject(chosen_met)
            IfCondition NotEqual(chosen_mobj, 0) ThenBlock: {
                chosen_mid = JSON.GetString(chosen_mobj, "id")
                IfCondition NotEqual(chosen_mid, 0) ThenBlock: {
                    SelectedProvider.default_model = chosen_mid
                    IfCondition Or(EqualTo(StringCompare(chosen_mid, "deepseek-reasoner"), 0), EqualTo(StringCompare(chosen_mid, "deepseek/deepseek-r1"), 0)) ThenBlock: {
                        SelectedProvider.reasoning_effort = "medium"
                    } ElseBlock: {
                        SelectedProvider.reasoning_effort = 0
                    }
                }
            }
        }
        ReturnValue(1)
    }
}

Function.CC_PromptProvider {
    Output: Integer
    Body: {
        prov_arr = CC_LoadAllProviderObjects()
        prov_count = 0
        IfCondition NotEqual(prov_arr, 0) ThenBlock: {
            prov_count = Array.Size(prov_arr)
        }

        prov = 0
        done = 0
        WhileLoop EqualTo(done, 0) {
            CC_PrintStepHeader("STEP 2: Model Selection")
            CC_WriteStdout("  Select AI Provider:\n")

            pi = 0
            WhileLoop LessThan(pi, prov_count) {
                pobj = Array.Get(prov_arr, pi)
                pname = JSON.GetString(pobj, "name")
                pmodel = JSON.GetString(pobj, "default_model")
                IfCondition EqualTo(pname, 0) ThenBlock: { pname = "Custom" }
                IfCondition EqualTo(pmodel, 0) ThenBlock: { pmodel = "" }

                CC_WriteStdout("  ")
                CC_WriteStdout(NumberToString(Add(pi, 1)))
                CC_WriteStdout(". ")
                CC_WriteStdout(pname)
                IfCondition GreaterThan(StringLength(pmodel), 0) ThenBlock: {
                    CC_WriteStdout("  (")
                    CC_WriteStdout(pmodel)
                    CC_WriteStdout(")")
                }
                CC_WriteStdout("\n")
                pi = Add(pi, 1)
            }

            CC_WriteStdout("\n  r. Refresh models from API\n")
            CC_WriteStdout("  a. Add connection\n")
            CC_WriteStdout("  0. Quit\n\n")
            CC_WriteStdout(" Choice [1]: ")

            line_buf = Allocate(16)
            CC_ReadStdinLine(line_buf, 16)
            choice = StringToNumber(line_buf)
            first_ch = GetByte(line_buf, 0)
            Deallocate(line_buf, 16)

            // Refresh models from API — 'r' or 'R'
            IfCondition Or(EqualTo(first_ch, 114), EqualTo(first_ch, 82)) ThenBlock: {
                CC_RunModelScraper()
                prov_arr = CC_LoadAllProviderObjects()
                prov_count = 0
                IfCondition NotEqual(prov_arr, 0) ThenBlock: {
                    prov_count = Array.Size(prov_arr)
                }
                ContinueLoop
            }

            // Add connection — check BEFORE quit so 'a' is not misread as choice=0
            IfCondition Or(EqualTo(first_ch, 97), EqualTo(first_ch, 65)) ThenBlock: {
                added = CC_PromptAddConnection()
                IfCondition EqualTo(added, 1) ThenBlock: {
                    prov_arr = CC_LoadAllProviderObjects()
                    prov_count = 0
                    IfCondition NotEqual(prov_arr, 0) ThenBlock: {
                        prov_count = Array.Size(prov_arr)
                    }
                }
                ContinueLoop
            }

            // Quit / back
            IfCondition Or(EqualTo(choice, 0), EqualTo(first_ch, 113)) ThenBlock: {
                prov = -1
                done = 1
            }

            // Dynamic provider selection from loaded prov_arr (slots 1..prov_count)
            IfCondition EqualTo(done, 0) ThenBlock: {
                // Default choice [1] if user pressed enter (choice==0 and first_ch==10 or 0)
                IfCondition And(EqualTo(choice, 0), Or(EqualTo(first_ch, 10), EqualTo(first_ch, 0))) ThenBlock: {
                    choice = 1
                }

                IfCondition And(GreaterEqual(choice, 1), LessEqual(choice, prov_count)) ThenBlock: {
                    chosen_pobj = Array.Get(prov_arr, Subtract(choice, 1))
                    cn   = JSON.GetString(chosen_pobj, "name")
                    cbk  = JSON.GetString(chosen_pobj, "backend")
                    curl = JSON.GetString(chosen_pobj, "base_url")
                    cap  = JSON.GetString(chosen_pobj, "api_path")
                    cmdl = JSON.GetString(chosen_pobj, "default_model")
                    ckh  = JSON.GetString(chosen_pobj, "key_hint")
                    creas = JSON.GetString(chosen_pobj, "reasoning_effort")

                    IfCondition EqualTo(cn, 0) ThenBlock: { cn = "Custom" }
                    IfCondition EqualTo(cbk, 0) ThenBlock: { cbk = "openai" }
                    IfCondition EqualTo(curl, 0) ThenBlock: { curl = "" }
                    IfCondition EqualTo(cap, 0) ThenBlock: { cap = "/v1/chat/completions" }
                    IfCondition EqualTo(cmdl, 0) ThenBlock: { cmdl = "" }
                    IfCondition EqualTo(ckh, 0) ThenBlock: { ckh = "apikey" }

                    prov = CC_MakeProvider(cn, cbk, curl, cap, cmdl, ckh)
                    IfCondition NotEqual(creas, 0) ThenBlock: {
                        SelectedProvider.reasoning_effort = creas
                    }

                    // Launch interstage model picker for this selected provider!
                    mok = CC_PromptModelFromProvider(chosen_pobj)
                    IfCondition EqualTo(mok, 1) ThenBlock: {
                        done = 1
                    }
                }
            }
        }
        IfCondition NotEqual(prov, -1) ThenBlock: {
            CC_WriteStdout("Using: ")
            CC_WriteStdout(SelectedProvider.name)
            CC_WriteStdout(" / ")
            CC_WriteStdout(SelectedProvider.default_model)
            CC_WriteStdout("\n\n")
            CC_SleepMs(400)
        }
        ReturnValue(prov)
    }
}

// =============================================================================
// PGMEM UNIFIED SESSION MANAGEMENT & COMPACTION
// =============================================================================
Function.CC_RandomUint16 {
    Output: Integer
    Body: {
        buf = Allocate(2)
        fd = SystemCall(CCSys.SYS_OPEN, "/dev/urandom", 0, 0, 0, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(CCSys.SYS_READ, fd, buf, 2, 0, 0)
            SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
            val = Add(GetByte(buf, 0), Multiply(GetByte(buf, 1), 256))
            Deallocate(buf, 2)
            ReturnValue(val)
        }
        Deallocate(buf, 2)
        ReturnValue(12345)
    }
}

Function.CC_GenerateSessionGUID {
    Output: Address
    Body: {
        ts = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        rand_val = CC_RandomUint16()
        ts_str = NumberToString(ts)
        r_str  = NumberToString(rand_val)
        res = StringConcat("sess-", ts_str)
        res = StringConcat(res, "-")
        res = StringConcat(res, r_str)
        ReturnValue(res)
    }
}

Function.CC_SaveSessionToPgmem {
    Output: Integer
    Body: {
        sid = History.GetSessionID()
        IfCondition EqualTo(sid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringLength(sid), 0) ThenBlock: { ReturnValue(0) }

        title = History.GetTitle()
        IfCondition EqualTo(title, 0) ThenBlock: { title = "Untitled Session" }

        hist_json = History.SerializeToJSON()

        // 1. Park history
        h_key = StringConcat("session:", sid)
        h_key = StringConcat(h_key, ":history")

        h_args = JSON.NewObject()
        JSON.SetString(h_args, "op", "park")
        JSON.SetString(h_args, "key", h_key)
        JSON.SetString(h_args, "kind", "session_history")
        JSON.SetString(h_args, "scope", "persistent")
        JSON.SetString(h_args, "content", hist_json)

        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        IPCDispatch.Dispatch("Pgmem", h_args, 0, perr)
        Deallocate(perr, 8)

        // 2. Park metadata
        meta_obj = JSON.NewObject()
        JSON.SetString(meta_obj, "id", sid)
        JSON.SetString(meta_obj, "title", title)
        IfCondition NotEqual(SelectedProvider.name, 0) ThenBlock: {
            JSON.SetString(meta_obj, "provider", SelectedProvider.name)
        }
        IfCondition NotEqual(SelectedProvider.default_model, 0) ThenBlock: {
            JSON.SetString(meta_obj, "model", SelectedProvider.default_model)
        }
        JSON.SetString(meta_obj, "turns", NumberToString(History.Count()))
        ts = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        JSON.SetString(meta_obj, "updated_at", NumberToString(ts))
        meta_json = JSON.SerializeObject(meta_obj)

        m_key = StringConcat("session:", sid)
        m_key = StringConcat(m_key, ":meta")

        m_args = JSON.NewObject()
        JSON.SetString(m_args, "op", "park")
        JSON.SetString(m_args, "key", m_key)
        JSON.SetString(m_args, "kind", "session_meta")
        JSON.SetString(m_args, "scope", "persistent")
        JSON.SetString(m_args, "content", meta_json)

        perr2 = Allocate(8)
        StoreValue(perr2, 0, "dword")
        IPCDispatch.Dispatch("Pgmem", m_args, 0, perr2)
        Deallocate(perr2, 8)

        // 3. Update sessions:last
        l_args = JSON.NewObject()
        JSON.SetString(l_args, "op", "park")
        JSON.SetString(l_args, "key", "sessions:last")
        JSON.SetString(l_args, "kind", "session_meta")
        JSON.SetString(l_args, "scope", "persistent")
        JSON.SetString(l_args, "content", sid)
        perr3 = Allocate(8)
        StoreValue(perr3, 0, "dword")
        IPCDispatch.Dispatch("Pgmem", l_args, 0, perr3)
        Deallocate(perr3, 8)

        ReturnValue(1)
    }
}

Function.CC_LoadSessionFromPgmem {
    Input: sid: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringLength(sid), 0) ThenBlock: { ReturnValue(0) }

        // Fetch history
        h_key = StringConcat("session:", sid)
        h_key = StringConcat(h_key, ":history")

        h_args = JSON.NewObject()
        JSON.SetString(h_args, "op", "pickup")
        JSON.SetString(h_args, "key", h_key)
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        h_resp = IPCDispatch.Dispatch("Pgmem", h_args, 0, perr)
        err = Dereference(perr, "dword")
        Deallocate(perr, 8)

        IfCondition Or(EqualTo(err, 1), EqualTo(h_resp, 0)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringLength(h_resp), 0) ThenBlock: { ReturnValue(0) }

        ok = History.LoadFromJSON(h_resp)
        IfCondition EqualTo(ok, 1) ThenBlock: {
            History.SetSessionID(sid)

            // Fetch meta title
            m_key = StringConcat("session:", sid)
            m_key = StringConcat(m_key, ":meta")
            m_args = JSON.NewObject()
            JSON.SetString(m_args, "op", "pickup")
            JSON.SetString(m_args, "key", m_key)
            perr2 = Allocate(8)
            StoreValue(perr2, 0, "dword")
            m_resp = IPCDispatch.Dispatch("Pgmem", m_args, 0, perr2)
            err2 = Dereference(perr2, "dword")
            Deallocate(perr2, 8)

            IfCondition And(EqualTo(err2, 0), NotEqual(m_resp, 0)) ThenBlock: {
                m_obj = JSON.AsObject(ParseJSON(m_resp))
                IfCondition NotEqual(m_obj, 0) ThenBlock: {
                    title = JSON.GetString(m_obj, "title")
                    IfCondition NotEqual(title, 0) ThenBlock: {
                        History.SetTitle(title)
                    }
                }
            }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.CC_ResumeLastSession {
    Output: Integer
    Body: {
        l_args = JSON.NewObject()
        JSON.SetString(l_args, "op", "pickup")
        JSON.SetString(l_args, "key", "sessions:last")
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        last_sid = IPCDispatch.Dispatch("Pgmem", l_args, 0, perr)
        err = Dereference(perr, "dword")
        Deallocate(perr, 8)

        IfCondition Or(EqualTo(err, 1), EqualTo(last_sid, 0)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringLength(last_sid), 0) ThenBlock: { ReturnValue(0) }

        ReturnValue(CC_LoadSessionFromPgmem(last_sid))
    }
}

Function.CC_SelectAndLoadSession {
    Output: Integer
    Body: {
        s_args = JSON.NewObject()
        JSON.SetString(s_args, "op", "search")
        JSON.SetString(s_args, "query", "session:")
        JSON.SetString(s_args, "kind", "session_meta")
        JSON.SetString(s_args, "scope", "persistent")
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        resp = IPCDispatch.Dispatch("Pgmem", s_args, 0, perr)
        err = Dereference(perr, "dword")
        Deallocate(perr, 8)

        IfCondition Or(EqualTo(err, 1), EqualTo(resp, 0)) ThenBlock: {
            CC_WriteStdout("[session] No saved sessions found in Pgmem.\n")
            ReturnValue(0)
        }

        parsed = JSON.AsObject(ParseJSON(resp))
        IfCondition EqualTo(parsed, 0) ThenBlock: {
            CC_WriteStdout("[session] No saved sessions found in Pgmem.\n")
            ReturnValue(0)
        }

        rows = JSON.GetArray(parsed, "rows")
        IfCondition EqualTo(rows, 0) ThenBlock: {
            CC_WriteStdout("[session] No saved sessions found in Pgmem.\n")
            ReturnValue(0)
        }

        n_rows = JSON.ArrayLength(rows)
        IfCondition LessEqual(n_rows, 0) ThenBlock: {
            CC_WriteStdout("[session] No saved sessions found in Pgmem.\n")
            ReturnValue(0)
        }

        CC_WriteStdout("\nSaved Sessions in Pgmem:\n")
        sids = JSON.NewArray()
        i = 0
        WhileLoop LessThan(i, n_rows) {
            row_tag = JSON.ArrayGet(rows, i)
            row = JSON.AsObject(row_tag)
            IfCondition NotEqual(row, 0) ThenBlock: {
                key = JSON.GetString(row, "key")
                is_meta = 0
                IfCondition NotEqual(key, 0) ThenBlock: {
                    klen = StringLength(key)
                    IfCondition GreaterThan(klen, 5) ThenBlock: {
                        sub_pos = Subtract(klen, 5)
                        IfCondition EqualTo(StringCompare(Add(key, sub_pos), ":meta"), 0) ThenBlock: {
                            is_meta = 1
                        }
                    }
                }

                IfCondition EqualTo(is_meta, 1) ThenBlock: {
                    content_str = JSON.GetString(row, "content")
                    IfCondition NotEqual(content_str, 0) ThenBlock: {
                        m_obj = JSON.AsObject(ParseJSON(content_str))
                        IfCondition NotEqual(m_obj, 0) ThenBlock: {
                            sid = JSON.GetString(m_obj, "id")
                            title = JSON.GetString(m_obj, "title")
                            model = JSON.GetString(m_obj, "model")
                            turns = JSON.GetNumber(m_obj, "turns")
                            turns_str = JSON.GetString(m_obj, "turns")
                            IfCondition EqualTo(turns, 0) ThenBlock: {
                                IfCondition NotEqual(turns_str, 0) ThenBlock: {
                                    turns = StringToNumber(turns_str)
                                }
                            }
                            IfCondition EqualTo(sid, 0) ThenBlock: { sid = "Unknown" }
                            IfCondition EqualTo(title, 0) ThenBlock: { title = "Untitled" }
                            IfCondition EqualTo(model, 0) ThenBlock: { model = "Unknown" }

                            JSON.PushObject(sids, m_obj)

                            sid_count = JSON.ArrayLength(sids)
                            CC_WriteStdout("  ")
                            CC_WriteStdout(NumberToString(sid_count))
                            CC_WriteStdout(". [")
                            CC_WriteStdout(sid)
                            CC_WriteStdout("] ")
                            CC_WriteStdout(title)
                            CC_WriteStdout(" (")
                            CC_WriteStdout(NumberToString(turns))
                            CC_WriteStdout(" turns, ")
                            CC_WriteStdout(model)
                            CC_WriteStdout(")\n")
                        }
                    }
                }
            }
            i = Add(i, 1)
        }

        total_sids = JSON.ArrayLength(sids)
        IfCondition LessEqual(total_sids, 0) ThenBlock: {
            CC_WriteStdout("[session] No valid sessions parsed.\n")
            ReturnValue(0)
        }

        CC_WriteStdout("\nSelect session number to load [1]: ")
        buf = Allocate(64)
        n_in = CC_ReadStdinLine(buf, 64)
        idx = 1
        IfCondition GreaterThan(n_in, 0) ThenBlock: {
            val = StringToInt(buf)
            IfCondition And(GreaterEqual(val, 1), LessEqual(val, total_sids)) ThenBlock: {
                idx = val
            }
        }
        Deallocate(buf, 64)

        chosen_tag = JSON.ArrayGet(sids, Subtract(idx, 1))
        chosen_obj = JSON.AsObject(chosen_tag)
        IfCondition NotEqual(chosen_obj, 0) ThenBlock: {
            target_sid = JSON.GetString(chosen_obj, "id")
            IfCondition NotEqual(target_sid, 0) ThenBlock: {
                CC_WriteStdout("\n[session] Loading session ")
                CC_WriteStdout(target_sid)
                CC_WriteStdout("...\n")
                ReturnValue(CC_LoadSessionFromPgmem(target_sid))
            }
        }
        ReturnValue(0)
    }
}

Function.CC_CompactSession {
    Output: Integer
    Body: {
        sid = History.GetSessionID()
        IfCondition EqualTo(sid, 0) ThenBlock: { ReturnValue(0) }

        ts = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        ts_str = NumberToString(ts)

        snap_key = StringConcat("session:", sid)
        snap_key = StringConcat(snap_key, ":snapshot:")
        snap_key = StringConcat(snap_key, ts_str)

        hist_json = History.SerializeToJSON()

        s_args = JSON.NewObject()
        JSON.SetString(s_args, "op", "park")
        JSON.SetString(s_args, "key", snap_key)
        JSON.SetString(s_args, "kind", "session_snapshot")
        JSON.SetString(s_args, "scope", "persistent")
        JSON.SetString(s_args, "content", hist_json)

        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        IPCDispatch.Dispatch("Pgmem", s_args, 0, perr)
        Deallocate(perr, 8)

        count = History.Count()
        summary_msg = StringConcat("[compaction] Context condensed at ", ts_str)
        summary_msg = StringConcat(summary_msg, ". Raw snapshot parked in pgmem under ")
        summary_msg = StringConcat(summary_msg, snap_key)
        summary_msg = StringConcat(summary_msg, ". (Prior turns: ")
        summary_msg = StringConcat(summary_msg, NumberToString(count))
        summary_msg = StringConcat(summary_msg, ")")

        History.Clear()
        History.AppendAssistantText(summary_msg)

        CC_SaveSessionToPgmem()
        ReturnValue(1)
    }
}

Function.CC_PromptSessionMenu {
    Output: Integer
    Body: {
        CC_PrintStepHeader("STEP 4: Work Scope & Session Management")
        CC_WriteStdout(" Select session option:\n")
        CC_WriteStdout("  [1] Start New Session (Default - auto-generates new GUID)\n")
        CC_WriteStdout("  [2] Load Saved Session from Pgmem\n")
        CC_WriteStdout("  [3] Quick Resume Last Session\n")
        CC_WriteStdout("  [q] Quit\n\n")
        CC_WriteStdout(" Choice [1]: ")

        buf = Allocate(64)
        n = CC_ReadStdinLine(buf, 64)
        choice = 1
        first_ch = 0
        IfCondition GreaterThan(n, 0) ThenBlock: {
            first_ch = GetByte(buf, 0)
            IfCondition Or(EqualTo(first_ch, 113), EqualTo(first_ch, 81)) ThenBlock: {
                Deallocate(buf, 64)
                ReturnValue(0)
            }
            IfCondition And(GreaterEqual(first_ch, 49), LessEqual(first_ch, 51)) ThenBlock: {
                choice = Subtract(first_ch, 48)
            }
        }
        Deallocate(buf, 64)

        IfCondition EqualTo(choice, 1) ThenBlock: {
            guid = CC_GenerateSessionGUID()
            History.SetSessionID(guid)
            History.SetTitle("New Session")
            CC_SaveSessionToPgmem()
            CC_WriteStdout("\n[session] Created new session: ")
            CC_WriteStdout(guid)
            CC_WriteStdout("\n")
        }

        IfCondition EqualTo(choice, 2) ThenBlock: {
            loaded = CC_SelectAndLoadSession()
            IfCondition EqualTo(loaded, 0) ThenBlock: {
                guid = CC_GenerateSessionGUID()
                History.SetSessionID(guid)
                History.SetTitle("New Session")
                CC_SaveSessionToPgmem()
            }
        }

        IfCondition EqualTo(choice, 3) ThenBlock: {
            loaded = CC_ResumeLastSession()
            IfCondition EqualTo(loaded, 0) ThenBlock: {
                CC_WriteStdout("[session] No recent session found in Pgmem. Starting new session.\n")
                guid = CC_GenerateSessionGUID()
                History.SetSessionID(guid)
                History.SetTitle("New Session")
                CC_SaveSessionToPgmem()
            }
        }

        CC_SleepMs(400)
        ReturnValue(1)
    }
}

// =============================================================================
// SYSTEM INITIALIZATION
// =============================================================================
Function.CC_RunAuth {
    Output: Address
    Body: {
        auth_ok = 0
        auth_result = 0
        WhileLoop EqualTo(auth_ok, 0) {
            auth_mode_choice = CC_PromptAuthMode()
            IfCondition EqualTo(auth_mode_choice, -1) ThenBlock: { ReturnValue(0) }
            chosen_provider = CC_PromptProvider()
            IfCondition EqualTo(chosen_provider, -1) ThenBlock: { ReturnValue(0) }

            CC_PrintStepHeader("STEP 3: System Initialization")
            CC_WriteStdout(" Verifying credentials and launching tool services...\n")

            // Resolve config + client + tokens paths (expand ~)
            cfg_dir = CC_ExpandHome("~/.halcode")
            CC_MkdirP(cfg_dir)
            cfg_path = CC_ExpandHome("~/.halcode/oauth_config.json")
            client_path = CC_ExpandHome("~/.halcode/oauth_client.json")
            tok_path = CC_ExpandHome("~/.halcode/oauth_tokens.json")

            prov_key_hint = SelectedProvider.key_hint

            is_google = 0
            IfCondition EqualTo(StringCompare(SelectedProvider.name, "Google"), 0) ThenBlock: { is_google = 1 }

            env_key = CC_GetEnv("ANTHROPIC_API_KEY")
            IfCondition EqualTo(is_google, 1) ThenBlock: { env_key = CC_GetEnv("GEMINI_API_KEY") }
            IfCondition EqualTo(StringCompare(SelectedProvider.name, "DeepSeek"), 0) ThenBlock: { env_key = CC_GetEnv("DEEPSEEK_API_KEY") }
            IfCondition EqualTo(StringCompare(SelectedProvider.name, "OpenAI"), 0) ThenBlock: { env_key = CC_GetEnv("OPENAI_API_KEY") }
            IfCondition EqualTo(StringCompare(SelectedProvider.name, "Grok"), 0) ThenBlock: { env_key = CC_GetEnv("XAI_API_KEY") }
            IfCondition EqualTo(StringCompare(SelectedProvider.name, "OpenRouter"), 0) ThenBlock: { env_key = CC_GetEnv("OPENROUTER_API_KEY") }

            IfCondition EqualTo(auth_mode_choice, 1) ThenBlock: {
                IfCondition EqualTo(is_google, 1) ThenBlock: {
                    CC_WriteStdout("\n[auth] Initiating Google OAuth flow for Gemini...\n")
                    cfg_path = CC_ExpandHome("~/.halcode/google_oauth_config.json")
                    client_path = CC_ExpandHome("~/.halcode/google_oauth_client.json")
                    tok_path = CC_ExpandHome("~/.halcode/google_oauth_tokens.json")
                    auth_result = Auth.RunOAuthFlow(cfg_path, tok_path)
                } ElseBlock: {
                    // OAuth path is built but the token endpoint rejects our exchange
                    // attempts (rate_limit_error). Awaiting Anthropic guidance on issue
                    // #54184. For now, fall back to key file so the UI is usable.
                    CC_WriteStdout("\n[!] OAuth path is implemented but blocked on Anthropic token-endpoint behavior.\n")
                    CC_WriteStdout("    See github.com/anthropics/claude-code issue #54184.\n")
                    CC_WriteStdout("    Falling back to key file for this session.\n\n")
                    auth_result = Auth.RunAPIKeyFlow(env_key, prov_key_hint)
                }
            } ElseBlock: {
                auth_result = Auth.RunAPIKeyFlow(env_key, prov_key_hint)
            }

            status = JSON.GetString(auth_result, "status")

            // Bootstrap on needs_setup_oauth: offer to write default config and retry
            IfCondition EqualTo(StringCompare(status, "needs_setup_oauth"), 0) ThenBlock: {
                CC_WriteStdout("\nNo OAuth config found at ")
                CC_WriteStdout(cfg_path)
                CC_WriteStdout("\nWould you like me to write a default config now? [y/N] ")
                ans = Allocate(16)
                n = CC_ReadStdinLine(ans, 16)
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    first = GetByte(ans, 0)
                    IfCondition Or(EqualTo(first, 121), EqualTo(first, 89)) ThenBlock: {
                        ok = 0
                        IfCondition EqualTo(is_google, 1) ThenBlock: {
                            CC_WriteStdout("\n[setup] To use Google Gemini, you need a Google Cloud Desktop App Client ID.\n")
                            CC_WriteStdout("        (e.g., 123456-abcdef.apps.googleusercontent.com)\n")
                            CC_WriteStdout("Please paste your Client ID here: ")
                            cid_buf = Allocate(256)
                            cid_len = CC_ReadStdinLine(cid_buf, 256)
                            CC_WriteStdout("Please paste your Client Secret here: ")
                            csec_buf = Allocate(256)
                            csec_len = CC_ReadStdinLine(csec_buf, 256)
                            IfCondition GreaterThan(cid_len, 0) ThenBlock: {
                                ok = Auth.WriteGoogleOAuthConfig(cfg_path, cid_buf, csec_buf)
                            } ElseBlock: {
                                CC_WriteStdout("No Client ID provided. Using placeholder.\n")
                                ok = Auth.WriteGoogleOAuthConfig(cfg_path, "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com", "YOUR_CLIENT_SECRET")
                            }
                            Deallocate(cid_buf, 256)
                            Deallocate(csec_buf, 256)
                        } ElseBlock: {
                            ok = Auth.WriteDefaultOAuthConfig(cfg_path)
                        }
                        IfCondition EqualTo(ok, 1) ThenBlock: {
                            CC_WriteStdout("[setup] wrote default config. Re-running OAuth flow...\n")
                            auth_result = Auth.RunOAuthFlow(cfg_path, tok_path)
                            status = JSON.GetString(auth_result, "status")
                        } ElseBlock: {
                            CC_WriteStdout("[setup] failed to write config\n")
                        }
                    }
                }
                Deallocate(ans, 16)
            }

            // Bootstrap on needs_client_id: ask for key directly
            IfCondition EqualTo(StringCompare(status, "needs_client_id"), 0) ThenBlock: {
                CC_WriteStdout("\n[setup] Your Google Client ID or Secret is missing or using the default placeholder.\n")
                CC_WriteStdout("        To use Google Gemini, you need a Google Cloud Desktop App Client ID.\n")
                CC_WriteStdout("        (e.g., 123456-abcdef.apps.googleusercontent.com)\n")
                CC_WriteStdout("Please paste your Client ID here: ")
                cid_buf = Allocate(256)
                cid_len = CC_ReadStdinLine(cid_buf, 256)
                CC_WriteStdout("Please paste your Client Secret here: ")
                csec_buf = Allocate(256)
                csec_len = CC_ReadStdinLine(csec_buf, 256)
                IfCondition GreaterThan(cid_len, 0) ThenBlock: {
                    ok = Auth.WriteGoogleOAuthConfig(cfg_path, cid_buf, csec_buf)
                    CC_WriteStdout("[setup] Saved new Client ID. Restarting flow...\n")
                } ElseBlock: {
                    CC_WriteStdout("No Client ID provided. Please try again.\n")
                }
                Deallocate(cid_buf, 256)
                Deallocate(csec_buf, 256)
                ContinueLoop
            }

            // Bootstrap on needs_setup_apikey: print walk-through and exit
            IfCondition EqualTo(StringCompare(status, "needs_setup_apikey"), 0) ThenBlock: {
                CC_WriteStdout("\nNo API key found for ")
                CC_WriteStdout(SelectedProvider.name)
                CC_WriteStdout(".\n\nPlease paste your API key here (Enter to go back): ")
                key_buf = Allocate(2048)
                key_len = CC_ReadStdinLine(key_buf, 2048)
                IfCondition GreaterThan(key_len, 0) ThenBlock: {
                    kpath = CC_ExpandHome(StringConcat("~/.halcode/", StringConcat(prov_key_hint, "_key")))
                    kfd = SystemCall(CCSys.SYS_OPEN, kpath, 577, 384, 0, 0) // O_WRONLY|O_CREAT|O_TRUNC (577), 0600 (384)
                    IfCondition GreaterEqual(kfd, 0) ThenBlock: {
                        SystemCall(CCSys.SYS_WRITE, kfd, key_buf, key_len, 0, 0)
                        SystemCall(CCSys.SYS_CLOSE, kfd, 0, 0, 0, 0)
                        CC_WriteStdout("[setup] Saved API key. Restarting flow...\n")
                    }
                }
                Deallocate(key_buf, 2048)
                ContinueLoop
            }

            IfCondition NotEqual(StringCompare(status, "ok"), 0) ThenBlock: {
                msg = JSON.GetString(auth_result, "message")
                CC_WriteStdout("\nauth failed: ")
                IfCondition NotEqual(msg, 0) ThenBlock: { CC_WriteStdout(msg) }
                CC_WriteStdout("\n\nType 'r' to reset old configs, or press Enter to restart setup: ")
                ans = Allocate(16)
                n_ans = CC_ReadStdinLine(ans, 16)
                IfCondition GreaterThan(n_ans, 0) ThenBlock: {
                    first_ch = GetByte(ans, 0)
                    IfCondition Or(EqualTo(first_ch, 114), EqualTo(first_ch, 82)) ThenBlock: {
                        SystemCall(87, cfg_path, 0, 0, 0, 0)
                        SystemCall(87, client_path, 0, 0, 0, 0)
                        SystemCall(87, tok_path, 0, 0, 0, 0)
                        CC_WriteStdout("\n[setup] Cleared old configurations.\n")
                    }
                }
                Deallocate(ans, 16)
                ContinueLoop
            }
            auth_ok = 1
            sess_ok = CC_PromptSessionMenu()
            IfCondition EqualTo(sess_ok, 0) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(auth_result)
    }
}

// Interactive waiting indicator for tool registration
Function.CC_RegisterOneTool {
    Input: name: Address
    Input: path: Address
    Input: binary: Address
    Body: {
        CC_WriteStdout("   [Wait] ") CC_WriteStdout(name) CC_WriteStdout("...")
        res = IPCDispatch.RegisterTool(name, path, binary)
        // Carriage return + ANSI Erase Line
        buf = Allocate(16)
        SetByte(buf,0,13) SetByte(buf,1,27) SetByte(buf,2,91) SetByte(buf,3,50) SetByte(buf,4,75) SetByte(buf,5,0)
        CC_WriteStdout(buf)
        Deallocate(buf, 16)
        IfCondition EqualTo(res, 0) ThenBlock: {
            CC_WriteStdout("   [FAIL] ")
        } ElseBlock: {
            CC_WriteStdout("   [ OK ] ")
        }
        CC_WriteStdout(name)
        CC_WriteStdout("\n")
    }
}

// Reads cc_tools.json and launches / registers every tool listed in it.
// do_launch=1: fork+exec each binary (pass 1) then connect+register (pass 2).
// do_launch=0: connect+register only — used by agent workers where the daemons
//              are already running (launched by the parent process).
// buf is intentionally NOT freed — JSON stores raw string pointers into it.
Function.CC_LoadManifest {
    Input: path: Address
    Input: do_launch: Integer
    Output: Integer
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, path, 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            CC_WriteStdout("[tools] WARN: cc_tools.json not found\n")
            ReturnValue(0)
        }
        buf = Allocate(32768)
        n = SystemCall(CCSys.SYS_READ, fd, buf, 32767, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 32768)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        parsed = ParseJSON(buf)
        IfCondition EqualTo(parsed, 0) ThenBlock: {
            CC_WriteStdout("[tools] WARN: cc_tools.json parse failed\n")
            ReturnValue(0)
        }
        obj = JSON.AsObject(parsed)
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        tools_arr = JSON.GetArray(obj, "tools")
        IfCondition EqualTo(tools_arr, 0) ThenBlock: {
            CC_WriteStdout("[tools] WARN: no 'tools' array in cc_tools.json\n")
            ReturnValue(0)
        }
        count = JSON.ArrayLength(tools_arr)

        // Pass 1 (launch mode only): fork+exec all binaries so they bind in parallel.
        IfCondition EqualTo(do_launch, 1) ThenBlock: {
            j = 0
            WhileLoop LessThan(j, count) {
                et = JSON.ArrayGet(tools_arr, j)
                eo = JSON.AsObject(et)
                IfCondition NotEqual(eo, 0) ThenBlock: {
                    bin  = JSON.GetString(eo, "binary")
                    tnam = JSON.GetString(eo, "name")
                    tsoc = JSON.GetString(eo, "socket")
                    IfCondition NotEqual(bin, 0) ThenBlock: {
                        CC_LaunchTool(bin, tnam, tsoc)
                    }
                }
                j = Add(j, 1)
            }
        }

        // Pass 2: connect to each socket, fetch schema, register in dispatch table.
        i = 0
        WhileLoop LessThan(i, count) {
            et = JSON.ArrayGet(tools_arr, i)
            eo = JSON.AsObject(et)
            IfCondition NotEqual(eo, 0) ThenBlock: {
                tool_name   = JSON.GetString(eo, "name")
                tool_socket = JSON.GetString(eo, "socket")
                bin         = JSON.GetString(eo, "binary")
                IfCondition And(NotEqual(tool_name, 0), NotEqual(tool_socket, 0)) ThenBlock: {
                    IfCondition EqualTo(do_launch, 1) ThenBlock: {
                        CC_RegisterOneTool(tool_name, tool_socket, bin)
                    } ElseBlock: {
                        IPCDispatch.RegisterTool(tool_name, tool_socket, bin)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(count)
    }
}

Function.CC_BootTools {
    Body: {
        CCRunState.child_pids = Allocate(Multiply(CCConst.MAX_CHILDREN, 8))
        MemorySet(CCRunState.child_pids, 0, Multiply(CCConst.MAX_CHILDREN, 8))
        CCRunState.child_count = 0

        CC_WriteStdout(" Loading tools from cc_tools.json...\n")
        CC_LoadManifest("./cc_tools.json", 1)

        CC_LoadQuotes("./intrusivethoughts.json")
    }
}

Function.CC_ListSessionsTUI {
    Body: {
        s_args = JSON.NewObject()
        JSON.SetString(s_args, "op", "search")
        JSON.SetString(s_args, "query", "session:")
        JSON.SetString(s_args, "kind", "session_meta")
        JSON.SetString(s_args, "scope", "persistent")
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        resp = IPCDispatch.Dispatch("Pgmem", s_args, 0, perr)
        err = Dereference(perr, "dword")
        Deallocate(perr, 8)

        IfCondition Or(EqualTo(err, 1), EqualTo(resp, 0)) ThenBlock: {
            UI.ChatPrintln("  [session] No saved sessions found in Pgmem.")
            ReturnValue(0)
        }

        parsed = JSON.AsObject(ParseJSON(resp))
        IfCondition EqualTo(parsed, 0) ThenBlock: {
            UI.ChatPrintln("  [session] No saved sessions found in Pgmem.")
            ReturnValue(0)
        }

        rows = JSON.GetArray(parsed, "rows")
        IfCondition EqualTo(rows, 0) ThenBlock: {
            UI.ChatPrintln("  [session] No saved sessions found in Pgmem.")
            ReturnValue(0)
        }

        n_rows = JSON.ArrayLength(rows)
        IfCondition LessEqual(n_rows, 0) ThenBlock: {
            UI.ChatPrintln("  [session] No saved sessions found in Pgmem.")
            ReturnValue(0)
        }

        UI.ChatPrintln("\n  Saved Sessions in Pgmem:")
        i = 0
        WhileLoop LessThan(i, n_rows) {
            row_tag = JSON.ArrayGet(rows, i)
            row = JSON.AsObject(row_tag)
            IfCondition NotEqual(row, 0) ThenBlock: {
                content_str = JSON.GetString(row, "content")
                IfCondition NotEqual(content_str, 0) ThenBlock: {
                    m_obj = JSON.AsObject(ParseJSON(content_str))
                    IfCondition NotEqual(m_obj, 0) ThenBlock: {
                        sid = JSON.GetString(m_obj, "id")
                        title = JSON.GetString(m_obj, "title")
                        model = JSON.GetString(m_obj, "model")
                        turns = JSON.GetNumber(m_obj, "turns")
                        IfCondition EqualTo(title, 0) ThenBlock: { title = "Untitled" }
                        IfCondition EqualTo(model, 0) ThenBlock: { model = "Unknown" }

                        msg = StringConcat("  ", NumberToString(Add(i, 1)))
                        msg = StringConcat(msg, ". [")
                        msg = StringConcat(msg, sid)
                        msg = StringConcat(msg, "] ")
                        msg = StringConcat(msg, title)
                        msg = StringConcat(msg, " (")
                        msg = StringConcat(msg, NumberToString(turns))
                        msg = StringConcat(msg, " turns, ")
                        msg = StringConcat(msg, model)
                        msg = StringConcat(msg, ")")
                        UI.ChatPrintln(msg)
                    }
                }
            }
            i = Add(i, 1)
        }
        UI.ChatPrintln("  Use /resume <session_id> to switch sessions.\n")
    }
}

Function.CC_ChatLoop {
    Output: Integer
    Body: {
        paste_active = 0
        paste_buf = 0
        paste_used = 0

        WhileLoop EqualTo(CCRunState.running, 1) {
            CC_CheckAgentNotify()
            line = UI.ReadLine()
            n = StringLength(line)

            // Detect Bracketed Paste Start: \e[200~
            has_start = 0
            IfCondition GreaterEqual(n, 6) ThenBlock: {
                IfCondition And(EqualTo(GetByte(line,0),27), EqualTo(GetByte(line,1),91)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(line,2),50), EqualTo(GetByte(line,3),48)) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(line,4),48), EqualTo(GetByte(line,5),126)) ThenBlock: {
                            has_start = 1
                        }
                    }
                }
            }

            // Detect Bracketed Paste End: \e[201~
            has_end = 0
            end_idx = 0
            i = 0
            WhileLoop LessEqual(i, Subtract(n, 6)) {
                IfCondition And(EqualTo(GetByte(line,i),27), EqualTo(GetByte(line,Add(i,1)),91)) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(line,Add(i,2)),50), EqualTo(GetByte(line,Add(i,3)),48)) ThenBlock: {
                        IfCondition And(EqualTo(GetByte(line,Add(i,4)),49), EqualTo(GetByte(line,Add(i,5)),126)) ThenBlock: {
                            has_end = 1
                            end_idx = i
                            BreakLoop
                        }
                    }
                }
                i = Add(i, 1)
            }

            IfCondition EqualTo(has_start, 1) ThenBlock: {
                paste_active = 1
                IfCondition EqualTo(paste_buf, 0) ThenBlock: { paste_buf = Allocate(CCConst.INPUT_BUF_SZ) }
                paste_used = 0
                chunk_start = 6
                chunk_len = Subtract(n, 6)
                IfCondition EqualTo(has_end, 1) ThenBlock: { paste_active = 0  chunk_len = Subtract(end_idx, 6) }
                IfCondition GreaterThan(chunk_len, 0) ThenBlock: {
                    MemoryCopy(Add(paste_buf, paste_used), Add(line, chunk_start), chunk_len)
                    paste_used = Add(paste_used, chunk_len)
                }
                IfCondition EqualTo(paste_active, 1) ThenBlock: { SetByte(paste_buf, paste_used, 10) paste_used = Add(paste_used, 1) ContinueLoop }
            } ElseBlock: {
                IfCondition EqualTo(paste_active, 1) ThenBlock: {
                    chunk_start = 0
                    chunk_len = n
                    IfCondition EqualTo(has_end, 1) ThenBlock: { paste_active = 0  chunk_len = end_idx }
                    IfCondition And(GreaterThan(chunk_len, 0), LessThan(Add(paste_used, chunk_len), Subtract(CCConst.INPUT_BUF_SZ, 1))) ThenBlock: {
                        MemoryCopy(Add(paste_buf, paste_used), Add(line, chunk_start), chunk_len)
                        paste_used = Add(paste_used, chunk_len)
                    }
                    IfCondition EqualTo(paste_active, 1) ThenBlock: { SetByte(paste_buf, paste_used, 10) paste_used = Add(paste_used, 1) ContinueLoop }
                }
            }

            IfCondition And(EqualTo(paste_active, 0), GreaterThan(paste_used, 0)) ThenBlock: {
                SetByte(paste_buf, paste_used, 0)
                paste_copy = CC_StrDup(paste_buf)
                paste_used = 0
                CC_SessionLogUser(paste_copy)
                History.AppendUser(paste_copy)
                CC_RunTurn()
                CC_SaveSessionToPgmem()
                ContinueLoop
            }

            IfCondition And(EqualTo(paste_active, 0), GreaterEqual(n, 0)) ThenBlock: {
                IfCondition EqualTo(StringCompare(line, "/quit"), 0) ThenBlock: {
                    CCRunState.running = 0
                }
                IfCondition EqualTo(StringCompare(line, "/home"), 0) ThenBlock: {
                    CCRunState.go_home = 1
                    CCRunState.running = 0
                }
                IfCondition EqualTo(StringCompare(line, "/help"), 0) ThenBlock: {
                    UI.PrintHelp()
                }
                IfCondition EqualTo(StringCompare(line, "/save"), 0) ThenBlock: {
                    CC_SavePinned("docs/last-assistant.md")
                }
                IfCondition EqualTo(CC_StartsWith(line, "/save "), 1) ThenBlock: {
                    save_path = Add(line, 6)
                    WhileLoop EqualTo(GetByte(save_path, 0), 32) {
                        save_path = Add(save_path, 1)
                    }
                    CC_SavePinned(save_path)
                }
                IfCondition EqualTo(CC_StartsWith(line, "save this"), 1) ThenBlock: {
                    CC_SavePinned("docs/last-assistant.md")
                }
                IfCondition Or(EqualTo(StringCompare(line, "/mem"), 0), EqualTo(StringCompare(line, "/stats"), 0)) ThenBlock: {
                    CC_PrintMemoryReport()
                }
                IfCondition Or(EqualTo(StringCompare(line, "/models"), 0), EqualTo(StringCompare(line, "/refresh-models"), 0)) ThenBlock: {
                    UI.ChatTag("→", "Querying provider APIs and updating model definitions...", 2)
                    CC_RunModelScraper()
                    UI.ChatTag("✓", "Models refreshed! Provider files in ~/.halcode/providers updated.", 2)
                }
                IfCondition EqualTo(StringCompare(line, "/sessions"), 0) ThenBlock: {
                    CC_ListSessionsTUI()
                }
                IfCondition EqualTo(StringCompare(line, "/compact"), 0) ThenBlock: {
                    UI.ChatTag("→", "Parking raw context snapshot to Pgmem & compacting active window...", 2)
                    ok = CC_CompactSession()
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        UI.ChatTag("✓", "Context compacted! Raw snapshot saved in Pgmem.", 2)
                    } ElseBlock: {
                        UI.ChatTag("✗", "Compaction failed — active session ID missing.", 1)
                    }
                }
                // /undo — pop the edit/write undo stack. Forms:
                //   /undo        /undo N      /undo list     /undo status     /undo clear
                undo_line_match = 0
                undo_op = 0
                undo_steps = 1
                IfCondition EqualTo(StringCompare(line, "/undo"), 0) ThenBlock: {
                    undo_op = "undo"
                    undo_line_match = 1
                }
                IfCondition EqualTo(StringCompare(line, "/undo list"), 0) ThenBlock: {
                    undo_op = "list"
                    undo_line_match = 1
                }
                IfCondition EqualTo(StringCompare(line, "/undo status"), 0) ThenBlock: {
                    undo_op = "status"
                    undo_line_match = 1
                }
                IfCondition EqualTo(StringCompare(line, "/undo clear"), 0) ThenBlock: {
                    undo_op = "clear"
                    undo_line_match = 1
                }
                IfCondition And(EqualTo(undo_line_match, 0), GreaterThan(StringLength(line), 6)) ThenBlock: {
                    undo_pfx = Allocate(7)
                    undo_k = 0
                    WhileLoop LessThan(undo_k, 6) {
                        SetByte(undo_pfx, undo_k, GetByte(line, undo_k))
                        undo_k = Add(undo_k, 1)
                    }
                    SetByte(undo_pfx, 6, 0)
                    IfCondition EqualTo(StringCompare(undo_pfx, "/undo "), 0) ThenBlock: {
                        undo_rest = Add(line, 6)
                        undo_steps = StringToInt(undo_rest)
                        IfCondition LessEqual(undo_steps, 0) ThenBlock: { undo_steps = 1 }
                        undo_op = "undo"
                        undo_line_match = 1
                    }
                    Deallocate(undo_pfx, 7)
                }
                IfCondition EqualTo(undo_line_match, 1) ThenBlock: {
                    undo_args = JSON.NewObject()
                    JSON.SetString(undo_args, "op", undo_op)
                    IfCondition EqualTo(StringCompare(undo_op, "undo"), 0) ThenBlock: {
                        JSON.SetNumber(undo_args, "steps", undo_steps)
                    }
                    undo_perr = Allocate(8)
                    StoreValue(undo_perr, 0, "dword")
                    undo_res = IPCDispatch.Dispatch("Undo", undo_args, "undo_cmd", undo_perr)
                    undo_perr_val = Dereference(undo_perr, "dword")
                    Deallocate(undo_perr, 8)
                    IfCondition NotEqual(undo_res, 0) ThenBlock: {
                        UI.ChatPrintln(undo_res)
                    } ElseBlock: {
                        UI.ChatTag("✗", "Undo tool execution failed.", 1)
                    }
                }
                // /redo — re-apply undone changes. Forms: /redo    /redo N
                redo_line_match = 0
                redo_steps = 1
                IfCondition EqualTo(StringCompare(line, "/redo"), 0) ThenBlock: {
                    redo_line_match = 1
                }
                IfCondition And(EqualTo(redo_line_match, 0), GreaterThan(StringLength(line), 6)) ThenBlock: {
                    redo_pfx = Allocate(7)
                    redo_k = 0
                    WhileLoop LessThan(redo_k, 6) {
                        SetByte(redo_pfx, redo_k, GetByte(line, redo_k))
                        redo_k = Add(redo_k, 1)
                    }
                    SetByte(redo_pfx, 6, 0)
                    IfCondition EqualTo(StringCompare(redo_pfx, "/redo "), 0) ThenBlock: {
                        redo_rest = Add(line, 6)
                        redo_steps = StringToInt(redo_rest)
                        IfCondition LessEqual(redo_steps, 0) ThenBlock: { redo_steps = 1 }
                        redo_line_match = 1
                    }
                    Deallocate(redo_pfx, 7)
                }
                IfCondition EqualTo(redo_line_match, 1) ThenBlock: {
                    redo_args = JSON.NewObject()
                    JSON.SetString(redo_args, "op", "redo")
                    JSON.SetNumber(redo_args, "steps", redo_steps)
                    redo_perr = Allocate(8)
                    StoreValue(redo_perr, 0, "dword")
                    redo_res = IPCDispatch.Dispatch("Undo", redo_args, "redo_cmd", redo_perr)
                    redo_perr_val = Dereference(redo_perr, "dword")
                    Deallocate(redo_perr, 8)
                    IfCondition NotEqual(redo_res, 0) ThenBlock: {
                        UI.ChatPrintln(redo_res)
                    } ElseBlock: {
                        UI.ChatTag("✗", "Redo tool execution failed.", 1)
                    }
                }
                IfCondition EqualTo(StringCompare(line, "/new"), 0) ThenBlock: {
                    CC_SaveSessionToPgmem()
                    guid = CC_GenerateSessionGUID()
                    History.SetSessionID(guid)
                    History.SetTitle("New Session")
                    History.Clear()
                    CC_ClearHotCache()
                    CC_SaveSessionToPgmem()
                    UI.ChatTag("✓", StringConcat("Started new session: ", guid), 2)
                }
                IfCondition GreaterThan(StringLength(line), 8) ThenBlock: {
                    pfx8 = Allocate(9)
                    k8 = 0
                    WhileLoop LessThan(k8, 8) {
                        SetByte(pfx8, k8, GetByte(line, k8))
                        k8 = Add(k8, 1)
                    }
                    SetByte(pfx8, 8, 0)
                    IfCondition EqualTo(StringCompare(pfx8, "/resume "), 0) ThenBlock: {
                        target_sid = Add(line, 8)
                        ok = CC_LoadSessionFromPgmem(target_sid)
                        IfCondition EqualTo(ok, 1) ThenBlock: {
                            UI.ChatTag("✓", StringConcat("Loaded session: ", target_sid), 2)
                        } ElseBlock: {
                            UI.ChatTag("✗", StringConcat("Session not found in Pgmem: ", target_sid), 1)
                        }
                    }
                    Deallocate(pfx8, 9)
                }
                IfCondition GreaterThan(StringLength(line), 7) ThenBlock: {
                    pfx7 = Allocate(8)
                    k7 = 0
                    WhileLoop LessThan(k7, 7) {
                        SetByte(pfx7, k7, GetByte(line, k7))
                        k7 = Add(k7, 1)
                    }
                    SetByte(pfx7, 7, 0)
                    IfCondition EqualTo(StringCompare(pfx7, "/image "), 0) ThenBlock: {
                        img_target = Add(line, 7)
                        UI.ChatTag("→", StringConcat("Analyzing image via Vision tool: ", img_target), 2)
                        v_args = JSON.NewObject()
                        JSON.SetString(v_args, "path", img_target)
                        perr = Allocate(8)
                        StoreValue(perr, 0, "dword")
                        v_res = IPCDispatch.Dispatch("Vision", v_args, "vision_cmd", perr)
                        perr_val = Dereference(perr, "dword")
                        Deallocate(perr, 8)
                        IfCondition NotEqual(v_res, 0) ThenBlock: {
                            UI.ChatPrintln(v_res)
                        } ElseBlock: {
                            err_msg = "Vision tool execution failed."
                            IfCondition NotEqual(perr_val, 0) ThenBlock: { err_msg = perr_val }
                            UI.ChatTag("✗", err_msg, 1)
                        }
                    }
                    Deallocate(pfx7, 8)
                }
                IfCondition EqualTo(StringCompare(line, "/clear"), 0) ThenBlock: {
                    History.Init()
                    CC_ClearHotCache()
                    ChatLog_Rotate()
                    UI.Shutdown()
                    UI.Init()
                    UI.SessionHeader(0, 0, 0)
                }
                IfCondition EqualTo(StringCompare(line, "/logout"), 0) ThenBlock: {
                    c1 = CC_ExpandHome("~/.halcode/google_oauth_config.json")
                    c2 = CC_ExpandHome("~/.halcode/google_oauth_tokens.json")
                    c3 = CC_ExpandHome("~/.halcode/oauth_config.json")
                    c4 = CC_ExpandHome("~/.halcode/oauth_tokens.json")
                    SystemCall(87, c1, 0, 0, 0, 0) SystemCall(87, c2, 0, 0, 0, 0)
                    SystemCall(87, c3, 0, 0, 0, 0) SystemCall(87, c4, 0, 0, 0, 0)
                    UI.ChatPrintln("Logged out and configs cleared. Please restart HalCode9000.")
                    CCRunState.running = 0
                }
                // /auto — tool chains are not capped in this tree.
                IfCondition EqualTo(StringCompare(line, "/auto"), 0) ThenBlock: {
                    CCRunState.auto_approve = 1
                    UI.ChatTag("✓", "Tool chains are not capped.", 2)
                }
                // /tools — toggle tool call display (compact summary vs expanded per-call)
                IfCondition EqualTo(StringCompare(line, "/tools"), 0) ThenBlock: {
                    IfCondition EqualTo(UILayout.show_tools, 0) ThenBlock: {
                        UILayout.show_tools = 1
                        UI.ChatTag("✓", "Tool display: expanded — each tool shown as it runs. [T] in hint row.", 2)
                    } ElseBlock: {
                        UILayout.show_tools = 0
                        UI.ChatTag("✓", "Tool display: compact — summary line shows names (e.g. ✓ Bash · Read · Write).", 8)
                    }
                }
                // /project — show current project info
                IfCondition EqualTo(StringCompare(line, "/project"), 0) ThenBlock: {
                    CC_ProjectCommand()
                    _pslug = UILayout.proj_slug
                    _tslug = UILayout.thread_slug
                    _has_p = 0
                    IfCondition And(NotEqual(_pslug, 0), GreaterThan(StringLength(_pslug), 0)) ThenBlock: {
                        _has_p = 1
                    }
                    IfCondition EqualTo(_has_p, 1) ThenBlock: {
                        _has_t = 0
                        IfCondition And(NotEqual(_tslug, 0), GreaterThan(StringLength(_tslug), 0)) ThenBlock: {
                            _has_t = 1
                        }
                        IfCondition EqualTo(_has_t, 1) ThenBlock: {
                            UI.ChatTag("·", StringConcat("Context: ", StringConcat(_pslug, StringConcat("/", _tslug))), 8)
                        } ElseBlock: {
                            UI.ChatTag("·", StringConcat("Context: ", _pslug), 8)
                        }
                    } ElseBlock: {
                        UI.ChatPrintln("  No project set. Use /project <name> or /thread <name>.")
                    }
                }
                // /project <name> — set project slug and persist to Pgmem
                IfCondition GreaterThan(StringLength(line), 9) ThenBlock: {
                    _pp_pfx = Allocate(10)
                    _pp_k = 0
                    WhileLoop LessThan(_pp_k, 9) {
                        SetByte(_pp_pfx, _pp_k, GetByte(line, _pp_k))
                        _pp_k = Add(_pp_k, 1)
                    }
                    SetByte(_pp_pfx, 9, 0)
                    IfCondition EqualTo(StringCompare(_pp_pfx, "/project "), 0) ThenBlock: {
                        _pname = Add(line, 9)
                        UI.SetProjectThread(_pname, 0)
                        _pp_args = JSON.NewObject()
                        JSON.SetString(_pp_args, "op", "park")
                        JSON.SetString(_pp_args, "key", "ui.proj_slug")
                        JSON.SetString(_pp_args, "kind", "config")
                        JSON.SetString(_pp_args, "content", _pname)
                        JSON.SetString(_pp_args, "scope", "persistent")
                        _pp_perr = Allocate(8)
                        StoreValue(_pp_perr, 0, "dword")
                        IPCDispatch.Dispatch("Pgmem", _pp_args, 0, _pp_perr)
                        Deallocate(_pp_perr, 8)
                        UI.ChatTag("✓", StringConcat("Project: ", _pname), 2)
                    }
                    Deallocate(_pp_pfx, 10)
                }
                // /thread — show current thread slug
                IfCondition EqualTo(StringCompare(line, "/thread"), 0) ThenBlock: {
                    _tslug2 = UILayout.thread_slug
                    _pslug2 = UILayout.proj_slug
                    IfCondition And(NotEqual(_tslug2, 0), GreaterThan(StringLength(_tslug2), 0)) ThenBlock: {
                        UI.ChatTag("·", StringConcat("Thread: ", _tslug2), 8)
                    } ElseBlock: {
                        UI.ChatPrintln("  No thread set. Use /thread <name> to set.")
                    }
                }
                // /thread <name> — set thread slug and persist to Pgmem
                IfCondition GreaterThan(StringLength(line), 8) ThenBlock: {
                    _th_pfx = Allocate(9)
                    _th_k = 0
                    WhileLoop LessThan(_th_k, 8) {
                        SetByte(_th_pfx, _th_k, GetByte(line, _th_k))
                        _th_k = Add(_th_k, 1)
                    }
                    SetByte(_th_pfx, 8, 0)
                    IfCondition EqualTo(StringCompare(_th_pfx, "/thread "), 0) ThenBlock: {
                        _tname = Add(line, 8)
                        UI.SetProjectThread(0, _tname)
                        _th_args = JSON.NewObject()
                        JSON.SetString(_th_args, "op", "park")
                        JSON.SetString(_th_args, "key", "ui.thread_slug")
                        JSON.SetString(_th_args, "kind", "config")
                        JSON.SetString(_th_args, "content", _tname)
                        JSON.SetString(_th_args, "scope", "persistent")
                        _th_perr = Allocate(8)
                        StoreValue(_th_perr, 0, "dword")
                        IPCDispatch.Dispatch("Pgmem", _th_args, 0, _th_perr)
                        Deallocate(_th_perr, 8)
                        UI.ChatTag("✓", StringConcat("Thread: ", _tname), 2)
                    }
                    Deallocate(_th_pfx, 9)
                }
                // /sysprompt — show/set/clear/apply the per-project system prompt addon
                IfCondition EqualTo(StringCompare(line, "/sysprompt"), 0) ThenBlock: {
                    proj = CC_LoadProjectPrompt()
                    IfCondition EqualTo(proj, 0) ThenBlock: {
                        UI.ChatPrintln("No project prompt set.")
                    } ElseBlock: {
                        UI.ChatPrintln(StringConcat("Project prompt:\n", proj))
                    }
                    UI.ChatPrintln("  /sysprompt set <text>  — save and apply inline")
                    UI.ChatPrintln("  /sysprompt clear       — remove project prompt")
                    UI.ChatPrintln("  /sysprompt apply       — reload from pgmem (e.g. after external edit)")
                }
                IfCondition EqualTo(StringCompare(line, "/sysprompt clear"), 0) ThenBlock: {
                    clr_args = JSON.NewObject()
                    JSON.SetString(clr_args, "op", "park")
                    JSON.SetString(clr_args, "key", "__prompt__")
                    JSON.SetString(clr_args, "kind", "config")
                    JSON.SetString(clr_args, "content", "")
                    JSON.SetString(clr_args, "scope", "global")
                    clr_perr = Allocate(8)
                    StoreValue(clr_perr, 0, "dword")
                    IPCDispatch.Dispatch("Pgmem", clr_args, 0, clr_perr)
                    Deallocate(clr_perr, 8)
                    CCConst.PROJ_PROMPT = 0
                    CC_ApplyProjectPrompt()
                    UI.Shutdown()
                    UI.Init()
                    UI.SessionHeader(0, 0, 0)
                    UI.ChatTag("✓", "Project prompt cleared. History reset.", 2)
                }
                IfCondition EqualTo(StringCompare(line, "/sysprompt apply"), 0) ThenBlock: {
                    CCConst.PROJ_PROMPT = CC_LoadProjectPrompt()
                    CC_ApplyProjectPrompt()
                    UI.Shutdown()
                    UI.Init()
                    UI.SessionHeader(0, 0, 0)
                    IfCondition NotEqual(CCConst.PROJ_PROMPT, 0) ThenBlock: {
                        UI.ChatTag("✓", "Project prompt reloaded. History reset.", 2)
                    } ElseBlock: {
                        UI.ChatTag("✓", "No project prompt in pgmem. History reset.", 3)
                    }
                }
                IfCondition GreaterThan(StringLength(line), 15) ThenBlock: {
                    sp_pfx = Allocate(16)
                    sp_k = 0
                    WhileLoop LessThan(sp_k, 15) {
                        SetByte(sp_pfx, sp_k, GetByte(line, sp_k))
                        sp_k = Add(sp_k, 1)
                    }
                    SetByte(sp_pfx, 15, 0)
                    IfCondition EqualTo(StringCompare(sp_pfx, "/sysprompt set "), 0) ThenBlock: {
                        prompt_text = Add(line, 15)
                        sp_args = JSON.NewObject()
                        JSON.SetString(sp_args, "op", "park")
                        JSON.SetString(sp_args, "key", "__prompt__")
                        JSON.SetString(sp_args, "kind", "config")
                        JSON.SetString(sp_args, "content", prompt_text)
                        JSON.SetString(sp_args, "scope", "global")
                        sp_perr = Allocate(8)
                        StoreValue(sp_perr, 0, "dword")
                        IPCDispatch.Dispatch("Pgmem", sp_args, 0, sp_perr)
                        sp_err = Dereference(sp_perr, "dword")
                        Deallocate(sp_perr, 8)
                        IfCondition EqualTo(sp_err, 1) ThenBlock: {
                            UI.ChatTag("✗", "Failed to save — is pgmem running?", 1)
                        } ElseBlock: {
                            CCConst.PROJ_PROMPT = prompt_text
                            CC_ApplyProjectPrompt()
                            UI.Shutdown()
                            UI.Init()
                            UI.SessionHeader(0, 0, 0)
                            UI.ChatTag("✓", "Project prompt saved and applied. History reset.", 2)
                        }
                    }
                    Deallocate(sp_pfx, 16)
                }
                // /model [name] — show or switch model
                IfCondition EqualTo(StringCompare(line, "/model"), 0) ThenBlock: {
                    UI.ChatPrintln(StringConcat("Current model: ", SelectedProvider.default_model))
                    IfCondition EqualTo(SelectedProvider.kind, BackendKind.OPENAI) ThenBlock: {
                        IfCondition EqualTo(StringCompare(SelectedProvider.name, "OpenRouter"), 0) ThenBlock: {
                            UI.ChatPrintln("  anthropic/claude-sonnet-4    openai/gpt-4o")
                            UI.ChatPrintln("  google/gemini-2.5-flash-preview")
                            UI.ChatPrintln("  meta-llama/llama-3.3-70b-instruct:free")
                            UI.ChatPrintln("  deepseek/deepseek-chat-v3-0324:free")
                        } ElseBlock: {
                            UI.ChatPrintln("  deepseek-v4-pro   deepseek-v4-flash")
                            UI.ChatPrintln("  gpt-4o   gpt-4o-mini")
                        }
                        UI.ChatPrintln("Use: /model <name>")
                    }
                }
                IfCondition GreaterThan(StringLength(line), 7) ThenBlock: {
                    pfx7 = Allocate(8)
                    k7 = 0
                    WhileLoop LessThan(k7, 7) {
                        SetByte(pfx7, k7, GetByte(line, k7))
                        k7 = Add(k7, 1)
                    }
                    SetByte(pfx7, 7, 0)
                    IfCondition EqualTo(StringCompare(pfx7, "/model "), 0) ThenBlock: {
                        new_model = Add(line, 7)
                        SelectedProvider.default_model = new_model
                        OpenAI.SetModel(new_model)
                        UI.ChatPrintln(StringConcat("Model set to: ", new_model))
                    }
                    Deallocate(pfx7, 8)
                }
                // /reasoning [off|min|medium|max]
                IfCondition EqualTo(StringCompare(line, "/reasoning"), 0) ThenBlock: {
                    re = SelectedProvider.reasoning_effort
                    IfCondition EqualTo(re, 0) ThenBlock: {
                        UI.ChatPrintln("Reasoning: off")
                    } ElseBlock: {
                        UI.ChatPrintln(StringConcat("Reasoning: ", re))
                    }
                }
                IfCondition GreaterThan(StringLength(line), 11) ThenBlock: {
                    pfx11 = Allocate(12)
                    k11 = 0
                    WhileLoop LessThan(k11, 11) {
                        SetByte(pfx11, k11, GetByte(line, k11))
                        k11 = Add(k11, 1)
                    }
                    SetByte(pfx11, 11, 0)
                    IfCondition EqualTo(StringCompare(pfx11, "/reasoning "), 0) ThenBlock: {
                        re_val = Add(line, 11)
                        IfCondition EqualTo(StringCompare(re_val, "off"), 0) ThenBlock: {
                            SelectedProvider.reasoning_effort = 0
                            OAICfg.reasoning_effort = 0
                            UI.ChatPrintln("Reasoning disabled")
                        } ElseBlock: {
                            IfCondition NotEqual(SelectedProvider.kind, BackendKind.OPENAI) ThenBlock: {
                                UI.ChatPrintln("Reasoning effort only applies to DeepSeek V4 Pro")
                            } ElseBlock: {
                                SelectedProvider.reasoning_effort = re_val
                                OpenAI.SetReasoningEffort(re_val)
                                UI.ChatPrintln(StringConcat("Reasoning set to: ", re_val))
                            }
                        }
                    }
                    Deallocate(pfx11, 12)
                }
                // Treat anything else as a chat turn
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    first = GetByte(line, 0)
                    IfCondition And(NotEqual(first, 47), EqualTo(CC_StartsWith(line, "save this"), 0)) ThenBlock: {
                        CC_SessionLogUser(line)
                        History.AppendUser(line)
                        CC_RunTurn()
                        CC_SaveSessionToPgmem()
                    }
                }
            }
        }
        ReturnValue(CCRunState.go_home)
    }
}

// =============================================================================
// HEADLESS AGENT MODE — ./HalCode9000.x --agent <provider>[:<model>]
// Reads prompt from stdin, runs one CC_RunTurn, writes response to stdout.
// =============================================================================

// Parse /proc/self/cmdline for flag (e.g. "--agent").
// Returns a heap-allocated copy of the next argument after flag, or 0.
Function.CC_ReadArgValue {
    Input: flag: Address
    Output: Address
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, "/proc/self/cmdline", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(16384)
        n = SystemCall(CCSys.SYS_READ, fd, buf, 16383, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 16384)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        flag_len = StringLength(flag)
        i = 0
        WhileLoop LessThan(i, n) {
            match = 1
            j = 0
            WhileLoop LessThan(j, flag_len) {
                IfCondition NotEqual(GetByte(buf, Add(i, j)), GetByte(flag, j)) ThenBlock: {
                    match = 0
                    BreakLoop
                }
                j = Add(j, 1)
            }
            IfCondition And(EqualTo(match, 1), EqualTo(GetByte(buf, Add(i, flag_len)), 0)) ThenBlock: {
                val_start = Add(i, Add(flag_len, 1))
                IfCondition GreaterEqual(val_start, n) ThenBlock: {
                    Deallocate(buf, 16384)
                    ReturnValue(0)
                }
                val_end = val_start
                WhileLoop LessThan(val_end, n) {
                    IfCondition EqualTo(GetByte(buf, val_end), 0) ThenBlock: { BreakLoop }
                    val_end = Add(val_end, 1)
                }
                val_len = Subtract(val_end, val_start)
                out = Allocate(Add(val_len, 1))
                k = 0
                WhileLoop LessThan(k, val_len) {
                    SetByte(out, k, GetByte(buf, Add(val_start, k)))
                    k = Add(k, 1)
                }
                SetByte(out, val_len, 0)
                Deallocate(buf, 16384)
                ReturnValue(out)
            }
            WhileLoop LessThan(i, n) {
                IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { BreakLoop }
                i = Add(i, 1)
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 16384)
        ReturnValue(0)
    }
}

// chdir to the directory containing the running binary (/proc/self/exe).
// Required in --mcp mode so ./cc_*_ipc.x relative paths resolve correctly.
Function.CC_ChdirToBinDir {
    Body: {
        buf = Allocate(4096)
        n = SystemCall(CCSys.SYS_READLINK, "/proc/self/exe", buf, 4095, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        last_slash = -1
        k = 0
        WhileLoop LessThan(k, n) {
            IfCondition EqualTo(GetByte(buf, k), 47) ThenBlock: { last_slash = k }
            k = Add(k, 1)
        }
        IfCondition GreaterEqual(last_slash, 0) ThenBlock: {
            SetByte(buf, last_slash, 0)
            SystemCall(CCSys.SYS_CHDIR, buf, 0, 0, 0, 0)
        }
        Deallocate(buf, 4096)
    }
}

// Returns 1 if flag is present as its own NUL-terminated token in cmdline, 0 otherwise.
// Use this for bare flags like --mcp that have no following value.
Function.CC_HasArg {
    Input: flag: Address
    Output: Integer
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, "/proc/self/cmdline", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(16384)
        n = SystemCall(CCSys.SYS_READ, fd, buf, 16383, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 16384)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        flag_len = StringLength(flag)
        i = 0
        WhileLoop LessThan(i, n) {
            match = 1
            j = 0
            WhileLoop LessThan(j, flag_len) {
                IfCondition NotEqual(GetByte(buf, Add(i, j)), GetByte(flag, j)) ThenBlock: {
                    match = 0
                    BreakLoop
                }
                j = Add(j, 1)
            }
            IfCondition And(EqualTo(match, 1), EqualTo(GetByte(buf, Add(i, flag_len)), 0)) ThenBlock: {
                Deallocate(buf, 16384)
                ReturnValue(1)
            }
            WhileLoop LessThan(i, n) {
                IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { BreakLoop }
                i = Add(i, 1)
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 16384)
        ReturnValue(0)
    }
}

// Read all of stdin until EOF. Returns bytes read (buf is NUL-terminated).
Function.CC_ReadStdinAll {
    Input: buf: Address
    Input: maxlen: Integer
    Output: Integer
    Body: {
        total = 0
        WhileLoop LessThan(total, Subtract(maxlen, 1)) {
            n = SystemCall(CCSys.SYS_READ, 0, Add(buf, total), Subtract(Subtract(maxlen, 1), total), 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }
            total = Add(total, n)
        }
        SetByte(buf, total, 0)
        ReturnValue(total)
    }
}

// Match the picker stem to a provider JSON key_hint. Returns 0 when no
// JSON matches so the caller keeps its hardcoded list. A match always
// returns a non-zero credential pointer ("" when the provider has no key)
// and never falls through to Anthropic.
Function.CC_ProvFromJSON {
    Input: prov_name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(prov_name, 0) ThenBlock: { ReturnValue(0) }
        all_arr = CC_LoadAllProviderObjects()
        IfCondition EqualTo(all_arr, 0) ThenBlock: { ReturnValue(0) }
        sz = Array.Size(all_arr)
        i = 0
        found = 0
        WhileLoop LessThan(i, sz) {
            pobj = Array.Get(all_arr, i)
            hint = JSON.GetString(pobj, "key_hint")
            IfCondition And(NotEqual(hint, 0), EqualTo(StringCompare(hint, prov_name), 0)) ThenBlock: {
                found = pobj
                i = sz
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(found, 0) ThenBlock: { ReturnValue(0) }
        cn0 = JSON.GetString(found, "name")
        cbk0 = JSON.GetString(found, "backend")
        curl0 = JSON.GetString(found, "base_url")
        cap0 = JSON.GetString(found, "api_path")
        cmdl0 = JSON.GetString(found, "default_model")
        ckh0 = JSON.GetString(found, "key_hint")
        cenv0 = JSON.GetString(found, "key_env")
        creas0 = JSON.GetString(found, "reasoning_effort")
        cauth0 = JSON.GetString(found, "auth")
        cn = CC_Dup(cn0)
        cbk = CC_Dup(cbk0)
        curl = CC_Dup(curl0)
        cap = CC_Dup(cap0)
        cmdl = CC_Dup(cmdl0)
        ckh = CC_Dup(ckh0)
        cenv = CC_Dup(cenv0)
        creas = CC_Dup(creas0)
        cauth = CC_Dup(cauth0)
        IfCondition EqualTo(cn, 0) ThenBlock: { cn = "Custom" }
        IfCondition EqualTo(cbk, 0) ThenBlock: { cbk = "openai" }
        ElseBlock: {
            IfCondition EqualTo(StringLength(cbk), 0) ThenBlock: { cbk = "openai" }
        }
        IfCondition EqualTo(curl, 0) ThenBlock: { curl = "" }
        IfCondition EqualTo(cap, 0) ThenBlock: { cap = "/v1/chat/completions" }
        IfCondition EqualTo(cmdl, 0) ThenBlock: { cmdl = "" }
        IfCondition EqualTo(ckh, 0) ThenBlock: { ckh = prov_name }
        CC_MakeProvider(cn, cbk, curl, cap, cmdl, ckh)
        IfCondition NotEqual(creas, 0) ThenBlock: {
            IfCondition GreaterThan(StringLength(creas), 0) ThenBlock: {
                SelectedProvider.reasoning_effort = creas
            }
        }
        IfCondition NotEqual(cauth, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(cauth, "none"), 0) ThenBlock: {
                ReturnValue("")
            }
        }
        env_key = 0
        IfCondition NotEqual(cenv, 0) ThenBlock: {
            IfCondition GreaterThan(StringLength(cenv), 0) ThenBlock: {
                env_key = CC_GetEnv(cenv)
            }
        }
        auth_res = Auth.RunAPIKeyFlow(env_key, ckh)
        auth_status = 0
        IfCondition NotEqual(auth_res, 0) ThenBlock: {
            auth_status = JSON.GetString(auth_res, "status")
        }
        IfCondition NotEqual(auth_status, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(auth_status, "ok"), 0) ThenBlock: {
                got = CC_Dup(JSON.GetString(auth_res, "credential"))
                IfCondition NotEqual(got, 0) ThenBlock: {
                    IfCondition GreaterThan(StringLength(got), 0) ThenBlock: {
                        ReturnValue(got)
                    }
                }
            }
        }
        ReturnValue("")
    }
}

// Parse "provider[:model]" spec, call CC_MakeProvider, look up the API key.
// Returns the credential string (heap copy from env, or "" for local).
Function.CC_SetupAgentProvider {
    Input: spec: Address
    Output: Address
    Body: {
        prov_name = spec
        model_override = 0

        // Find ':' separator
        colon_pos = -1
        ci = 0
        WhileLoop NotEqual(GetByte(spec, ci), 0) {
            IfCondition EqualTo(GetByte(spec, ci), 58) ThenBlock: {
                colon_pos = ci
                BreakLoop
            }
            ci = Add(ci, 1)
        }
        IfCondition GreaterEqual(colon_pos, 0) ThenBlock: {
            model_override = Add(spec, Add(colon_pos, 1))
            prov_buf = Allocate(64)
            pk = 0
            WhileLoop LessThan(pk, colon_pos) {
                SetByte(prov_buf, pk, GetByte(spec, pk))
                pk = Add(pk, 1)
            }
            SetByte(prov_buf, colon_pos, 0)
            prov_name = prov_buf
        }

        cred = CC_ProvFromJSON(prov_name)
        IfCondition EqualTo(cred, 0) ThenBlock: {
        matched = 0

        IfCondition EqualTo(StringCompare(prov_name, "anthropic"), 0) ThenBlock: {
            CC_MakeProvider("Anthropic", "anthropic", "https://api.anthropic.com",
                            "/v1/messages", "claude-sonnet-4-6", "anthropic")
            cred = CC_GetEnv("ANTHROPIC_API_KEY")
            matched = 1
        }
        IfCondition And(EqualTo(matched, 0), EqualTo(StringCompare(prov_name, "deepseek"), 0)) ThenBlock: {
            CC_MakeProvider("DeepSeek", "openai", "https://api.deepseek.com",
                            "/v1/chat/completions", "deepseek-v4-flash", "deepseek")
            cred = CC_GetEnv("DEEPSEEK_API_KEY")
            matched = 1
        }
        IfCondition And(EqualTo(matched, 0), EqualTo(StringCompare(prov_name, "openai"), 0)) ThenBlock: {
            CC_MakeProvider("OpenAI", "openai", "https://api.openai.com",
                            "/v1/chat/completions", "gpt-4o", "openai")
            cred = CC_GetEnv("OPENAI_API_KEY")
            matched = 1
        }
        IfCondition And(EqualTo(matched, 0), EqualTo(StringCompare(prov_name, "grok"), 0)) ThenBlock: {
            CC_MakeProvider("Grok", "openai", "https://api.x.ai",
                            "/v1/chat/completions", "grok-4.6", "xai")
            cred = CC_GetEnv("XAI_API_KEY")
            matched = 1
        }
        IfCondition And(EqualTo(matched, 0), EqualTo(StringCompare(prov_name, "gemini"), 0)) ThenBlock: {
            CC_MakeProvider("Google", "gemini", "https://generativelanguage.googleapis.com",
                            "/v1beta/openai/chat/completions", "gemini-2.5-flash", "google")
            cred = CC_GetEnv("GEMINI_API_KEY")
            matched = 1
        }
        IfCondition And(EqualTo(matched, 0), EqualTo(StringCompare(prov_name, "local"), 0)) ThenBlock: {
            CC_MakeProvider("Local", "openai", "http://localhost:11434",
                            "/v1/chat/completions", "llama3", "local")
            cred = ""
            matched = 1
        }
        IfCondition EqualTo(matched, 0) ThenBlock: {
            CC_MakeProvider("Anthropic", "anthropic", "https://api.anthropic.com",
                            "/v1/messages", "claude-sonnet-4-6", "anthropic")
            cred = CC_GetEnv("ANTHROPIC_API_KEY")
        }
        }

        IfCondition NotEqual(model_override, 0) ThenBlock: {
            IfCondition GreaterThan(StringLength(model_override), 0) ThenBlock: {
                SelectedProvider.default_model = model_override
            }
        }
        // Fall back to key file if env var not set
        IfCondition EqualTo(cred, 0) ThenBlock: {
            auth_res = Auth.RunAPIKeyFlow(0, SelectedProvider.key_hint)
            auth_status = JSON.GetString(auth_res, "status")
            IfCondition EqualTo(StringCompare(auth_status, "ok"), 0) ThenBlock: {
                cred = JSON.GetString(auth_res, "credential")
            }
        }
        IfCondition EqualTo(cred, 0) ThenBlock: { cred = "" }
        ReturnValue(cred)
    }
}

// Resolve the worker provider[:model] spec for headless workers.
// Precedence: HALCODE_WORKER env var > built-in default "deepseek".
Function.CC_ResolveWorkerSpec {
    Output: Address
    Body: {
        spec = CC_GetEnv("HALCODE_WORKER")
        IfCondition NotEqual(spec, 0) ThenBlock: {
            IfCondition GreaterThan(StringLength(spec), 0) ThenBlock: { ReturnValue(spec) }
        }
        ReturnValue("deepseek")
    }
}

// Connect to already-running tool sockets without launching new processes.
// Used in headless mode where the parent HalCode9000.x already launched tools.
// ConnectProxy fails fast when leftover --mcp has no AgentProxy — do not hang.
Function.CC_RegisterToolsOnly {
    Body: {
        CCRunState.child_pids = Allocate(Multiply(CCConst.MAX_CHILDREN, 8))
        MemorySet(CCRunState.child_pids, 0, Multiply(CCConst.MAX_CHILDREN, 8))
        CCRunState.child_count = 0
        proxy_ok = IPCDispatch.ConnectProxy()
        CC_AgentLog(StringConcat("[init] ConnectProxy=", NumberToString(proxy_ok)))
        IfCondition EqualTo(proxy_ok, 0) ThenBlock: {
            CC_AgentLog("[init] no AgentProxy — tools not attached")
        }
    }
}

Function.CC_PgmemPickupKey {
    Input: key: Address
    Output: Address
    Body: {
        args = JSON.NewObject()
        JSON.SetString(args, "op", "pickup")
        JSON.SetString(args, "key", key)
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        resp = IPCDispatch.Dispatch("Pgmem", args, 0, perr)
        err = Dereference(perr, "dword")
        Deallocate(perr, 8)
        IfCondition EqualTo(err, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(resp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringLength(resp), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(resp)
    }
}

Function.CC_SanitizeOneLine {
    Input: src: Address
    Input: maxn: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        n = StringLength(src)
        IfCondition GreaterThan(n, maxn) ThenBlock: { n = maxn }
        out = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(src, i)
            IfCondition EqualTo(c, 10) ThenBlock: { c = 32 }
            IfCondition EqualTo(c, 13) ThenBlock: { c = 32 }
            SetByte(out, i, c)
            i = Add(i, 1)
        }
        SetByte(out, n, 0)
        ReturnValue(out)
    }
}

Function.CC_WriteAppFile {
    Input: path: Address
    Input: data: Address
    Body: {
        IfCondition EqualTo(data, 0) ThenBlock: { data = "" }
        fd = SystemCall(CCSys.SYS_OPEN, path, 577, 420, 0, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(CCSys.SYS_WRITE, fd, data, StringLength(data), 0, 0)
            SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        }
    }
}

Function.CC_ReadAppFile {
    Input: path: Address
    Input: buf: Address
    Input: maxlen: Integer
    Output: Integer
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, path, 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        n = SystemCall(CCSys.SYS_READ, fd, buf, Subtract(maxlen, 1), 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            SetByte(buf, 0, 0)
            ReturnValue(0)
        }
        WhileLoop And(GreaterThan(n, 0), Or(EqualTo(GetByte(buf, Subtract(n, 1)), 10), EqualTo(GetByte(buf, Subtract(n, 1)), 13))) {
            n = Subtract(n, 1)
        }
        SetByte(buf, n, 0)
        ReturnValue(n)
    }
}

// Same keys the TUI pickups after BootScroll. Writes /tmp/halcode_app/pickup.txt
// so the GTK desk can show project/thread/sessions with no TUI/GUI split.

Function.CC_ReadPromptFile {
    Input: path: Address
    Output: Address
    Body: {
        buf = Allocate(65536)
        n = CC_ReadAppFile(path, buf, 65536)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 65536)
            ReturnValue(0)
        }
        ReturnValue(buf)
    }
}

Function.CC_EnsureSystemPrompt {
    Output: Address
    Body: {
        CC_MkdirP(CC_ExpandHome("~/.halcode"))
        home_p = CC_ExpandHome("~/.halcode/system_prompt.txt")
        got = CC_ReadPromptFile(home_p)
        IfCondition NotEqual(got, 0) ThenBlock: { ReturnValue(got) }
        got = CC_ReadPromptFile("config/system_prompt.txt")
        IfCondition NotEqual(got, 0) ThenBlock: {
            CC_WriteAppFile(home_p, got)
            ReturnValue(got)
        }
        ReturnValue("You are HAL Code 9000.")
    }
}

Function.CC_LoadHalcodeConfig {
    Body: {
        pth = CC_ExpandHome("~/.halcode/halcode.json")
        buf = Allocate(4096)
        n = CC_ReadAppFile(pth, buf, 4096)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0)
        }
        obj = JSON.AsObject(ParseJSON(buf))
        Deallocate(buf, 4096)
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        mt = JSON.GetNumber(obj, "max_tokens")
        IfCondition GreaterThan(mt, 0) ThenBlock: {
            Backend.SetMaxTokens(mt)
        }
    }
}

Function.CC_WritePickupSnapshot {
    Body: {
        SystemCall(CCSys.SYS_MKDIR, "/tmp/halcode_app", 493, 0, 0, 0)
        out = ""
        proj = CCRunState.ui_proj
        thread = CCRunState.ui_thread
        state = CCRunState.ui_state
        IfCondition EqualTo(proj, 0) ThenBlock: { proj = "" }
        IfCondition EqualTo(thread, 0) ThenBlock: { thread = "" }
        IfCondition EqualTo(state, 0) ThenBlock: { state = "" }
        p1 = CC_SanitizeOneLine(proj, 60)
        p2 = CC_SanitizeOneLine(thread, 60)
        p3 = CC_SanitizeOneLine(state, 200)
        IfCondition EqualTo(p1, 0) ThenBlock: { p1 = "" }
        IfCondition EqualTo(p2, 0) ThenBlock: { p2 = "" }
        IfCondition EqualTo(p3, 0) ThenBlock: { p3 = "" }
        out = StringConcat(out, "P ")
        out = StringConcat(out, p1)
        out = StringConcat(out, "\nT ")
        out = StringConcat(out, p2)
        out = StringConcat(out, "\nW ")
        out = StringConcat(out, p3)
        out = StringConcat(out, "\n")

        s_args = JSON.NewObject()
        JSON.SetString(s_args, "op", "search")
        JSON.SetString(s_args, "query", "session:")
        JSON.SetString(s_args, "kind", "session_meta")
        JSON.SetString(s_args, "scope", "persistent")
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        resp = IPCDispatch.Dispatch("Pgmem", s_args, 0, perr)
        err = Dereference(perr, "dword")
        Deallocate(perr, 8)
        IfCondition EqualTo(err, 1) ThenBlock: {
            out = StringConcat(out, "E pgmem not attached\n")
        }
        IfCondition And(EqualTo(err, 0), NotEqual(resp, 0)) ThenBlock: {
            parsed = JSON.AsObject(ParseJSON(resp))
            IfCondition NotEqual(parsed, 0) ThenBlock: {
                rows = JSON.GetArray(parsed, "rows")
                IfCondition NotEqual(rows, 0) ThenBlock: {
                    n_rows = JSON.ArrayLength(rows)
                    written = 0
                    i = 0
                    last_sid = ""
                    WhileLoop And(LessThan(i, n_rows), LessThan(written, 8)) {
                        row_tag = JSON.ArrayGet(rows, i)
                        row = JSON.AsObject(row_tag)
                        IfCondition NotEqual(row, 0) ThenBlock: {
                            key = JSON.GetString(row, "key")
                            is_meta = 0
                            IfCondition NotEqual(key, 0) ThenBlock: {
                                klen = StringLength(key)
                                IfCondition GreaterThan(klen, 5) ThenBlock: {
                                    sub_pos = Subtract(klen, 5)
                                    IfCondition EqualTo(StringCompare(Add(key, sub_pos), ":meta"), 0) ThenBlock: {
                                        is_meta = 1
                                    }
                                }
                            }
                            IfCondition EqualTo(is_meta, 1) ThenBlock: {
                                content_str = JSON.GetString(row, "content")
                                IfCondition NotEqual(content_str, 0) ThenBlock: {
                                    m_obj = JSON.AsObject(ParseJSON(content_str))
                                    IfCondition NotEqual(m_obj, 0) ThenBlock: {
                                        sid = JSON.GetString(m_obj, "id")
                                        title = JSON.GetString(m_obj, "title")
                                        IfCondition EqualTo(sid, 0) ThenBlock: { sid = "" }
                                        IfCondition EqualTo(title, 0) ThenBlock: { title = "Untitled" }
                                        sid_s = CC_SanitizeOneLine(sid, 40)
                                        tit_s = CC_SanitizeOneLine(title, 36)
                                        IfCondition EqualTo(sid_s, 0) ThenBlock: { sid_s = "" }
                                        IfCondition EqualTo(tit_s, 0) ThenBlock: { tit_s = "Untitled" }
                                        dup = 0
                                        IfCondition GreaterThan(StringLength(last_sid), 0) ThenBlock: {
                                            IfCondition EqualTo(StringCompare(sid_s, last_sid), 0) ThenBlock: { dup = 1 }
                                        }
                                        IfCondition EqualTo(dup, 0) ThenBlock: {
                                            out = StringConcat(out, "S ")
                                            out = StringConcat(out, sid_s)
                                            out = StringConcat(out, " ")
                                            out = StringConcat(out, tit_s)
                                            out = StringConcat(out, "\n")
                                            last_sid = sid_s
                                            written = Add(written, 1)
                                        }
                                    }
                                }
                            }
                        }
                        i = Add(i, 1)
                    }
                }
            }
        }
        CC_WriteAppFile("/tmp/halcode_app/pickup.tmp", out)
        SystemCall(CCSys.SYS_RENAME, "/tmp/halcode_app/pickup.tmp", "/tmp/halcode_app/pickup.txt", 0, 0, 0)
    }
}

Function.CC_RestorePgmemUi {
    Input: apply_ui: Integer
    Body: {
        CCRunState.ui_proj = 0
        CCRunState.ui_thread = 0
        CCRunState.ui_state = 0
        proj = CC_PgmemPickupKey("ui.proj_slug")
        thread = CC_PgmemPickupKey("ui.thread_slug")
        state = CC_PgmemPickupKey("working_state")
        IfCondition And(NotEqual(proj, 0), GreaterThan(StringLength(proj), 0)) ThenBlock: {
            CCRunState.ui_proj = proj
        }
        IfCondition And(NotEqual(thread, 0), GreaterThan(StringLength(thread), 0)) ThenBlock: {
            CCRunState.ui_thread = thread
        }
        IfCondition And(NotEqual(state, 0), GreaterThan(StringLength(state), 0)) ThenBlock: {
            CCRunState.ui_state = state
        }
        IfCondition EqualTo(apply_ui, 1) ThenBlock: {
            IfCondition NotEqual(CCRunState.ui_proj, 0) ThenBlock: {
                UI.SetProjectThread(CCRunState.ui_proj, CCRunState.ui_thread)
            }
        }
    }
}

// Drop in-memory handoff only. Parked sessions and working_state stay readable.
Function.CC_ClearHotCache {
    Body: {
        CCRunState.ui_state = 0
        CCRunState.fresh = 1
    }
}

Function.CC_MarkNoPickup {
    Input: sid: Address
    Body: {
        CCRunState.fresh = 1
        IfCondition NotEqual(sid, 0) ThenBlock: {
            CC_WriteAppFile("/tmp/halcode_app/nopickup.txt", sid)
        }
    }
}

Function.CC_SessionIsFresh {
    Input: sid: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sid, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(128)
        n = CC_ReadAppFile("/tmp/halcode_app/nopickup.txt", buf, 128)
        IfCondition And(GreaterThan(n, 0), EqualTo(StringCompare(buf, sid), 0)) ThenBlock: {
            Deallocate(buf, 128)
            ReturnValue(1)
        }
        Deallocate(buf, 128)
        ReturnValue(0)
    }
}

// GUI --agent is a new process each turn. session.txt "new" or empty starts
// clean. "last" resumes the previous session. Any other value is a selected id.
// Never fall back to sessions:last when nothing was selected.
Function.CC_GuiApplySession {
    Output: Integer
    Body: {
        CCRunState.fresh = 0
        buf = Allocate(128)
        n = CC_ReadAppFile("/tmp/halcode_app/session.txt", buf, 128)
        is_last = 0
        is_new = 1
        IfCondition GreaterThan(n, 0) ThenBlock: {
            is_new = 0
            IfCondition EqualTo(StringCompare(buf, "last"), 0) ThenBlock: { is_last = 1 }
            IfCondition EqualTo(StringCompare(buf, "new"), 0) ThenBlock: { is_new = 1 }
        }
        IfCondition EqualTo(is_last, 1) ThenBlock: {
            SystemCall(87, "/tmp/halcode_app/nopickup.txt", 0, 0, 0, 0)
            loaded = CC_ResumeLastSession()
            IfCondition EqualTo(loaded, 1) ThenBlock: {
                sid = History.GetSessionID()
                IfCondition NotEqual(sid, 0) ThenBlock: {
                    CC_WriteAppFile("/tmp/halcode_app/session.txt", sid)
                }
                Deallocate(buf, 128)
                ReturnValue(1)
            }
            is_new = 1
        }
        IfCondition EqualTo(is_new, 0) ThenBlock: {
            ok = CC_LoadSessionFromPgmem(buf)
            IfCondition EqualTo(ok, 1) ThenBlock: {
                IfCondition EqualTo(CC_SessionIsFresh(buf), 1) ThenBlock: {
                    CCRunState.fresh = 1
                }
                Deallocate(buf, 128)
                ReturnValue(1)
            }
        }
        guid = CC_GenerateSessionGUID()
        History.Clear()
        History.SetSessionID(guid)
        History.SetTitle("New Session")
        CC_ClearHotCache()
        CC_MarkNoPickup(guid)
        CC_SaveSessionToPgmem()
        CC_WriteAppFile("/tmp/halcode_app/session.txt", guid)
        Deallocate(buf, 128)
        ReturnValue(0)
    }
}

// Non-blocking reap of launch pids. wr==-10 is ECHILD (already collected).
Function.CC_ReapChildren {
    Body: {
        IfCondition EqualTo(CCRunState.child_pids, 0) ThenBlock: { ReturnValue(0) }
        st = Allocate(8)
        i = 0
        WhileLoop LessThan(i, CCRunState.child_count) {
            slot = Multiply(i, 8)
            pid = Dereference(Add(CCRunState.child_pids, slot))
            IfCondition GreaterThan(pid, 0) ThenBlock: {
                StoreValue(st, 0)
                wr = SystemCall(CCSys.SYS_WAIT4, pid, st, 1, 0, 0)
                IfCondition GreaterThan(wr, 0) ThenBlock: {
                    StoreValue(Add(CCRunState.child_pids, slot), 0)
                }
                IfCondition EqualTo(wr, -10) ThenBlock: {
                    StoreValue(Add(CCRunState.child_pids, slot), 0)
                }
            }
            i = Add(i, 1)
        }
        Deallocate(st, 8)
    }
}

// Block SIGTERM and SIGINT and return a signalfd. -1 if signalfd is unavailable
// (signals stay at their current disposition).
Function.CC_HostArmSig {
    Output: Integer
    Body: {
        mask = Allocate(8)
        StoreValue(mask, 16386)
        SystemCall(CCSys.SYS_RT_SIGPROCMASK, 0, mask, 0, 8, 0)
        sfd = SystemCall(CCSys.SYS_SIGNALFD, -1, mask, 8, 526336, 0)
        IfCondition LessThan(sfd, 0) ThenBlock: {
            SystemCall(CCSys.SYS_RT_SIGPROCMASK, 1, mask, 0, 8, 0)
        }
        Deallocate(mask, 8)
        ReturnValue(sfd)
    }
}

// Localhost listener. One line, "shutdown", asks the host to exit.
// Port is written to /tmp/halcode_app/host.port for the shell and the launcher.
Function.CC_HostCtlOpen {
    Output: Integer
    Body: {
        fd = Socket.Create(2, 1)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        Socket.SetReuseAddr(fd)
        br = Socket.BindInet(fd, "127.0.0.1", 47631)
        IfCondition LessThan(br, 0) ThenBlock: {
            CC_WriteStdout("[host] ctl bind 127.0.0.1:47631 failed\n")
            Socket.Close(fd)
            ReturnValue(-1)
        }
        Socket.Listen(fd, 2)
        Socket.SetNonBlock(fd)
        CC_WriteAppFile("/tmp/halcode_app/host.port", "47631\n")
        CC_WriteStdout("[host] ctl 127.0.0.1:47631\n")
        ReturnValue(fd)
    }
}

// Kill every tool we launched and every tool we respawned, plus the shells
// in those process groups. Then collect any zombie we missed.
Function.CC_HostShutdown {
    Body: {
        CC_WriteStdout("[host] shutdown tools\n")
        IPCDispatch.Shutdown()
        CC_KillAllChildren()
        st = Allocate(8)
        WhileLoop 1 {
            StoreValue(st, 0)
            wr = SystemCall(CCSys.SYS_WAIT4, -1, st, 1, 0, 0)
            IfCondition LessEqual(wr, 0) ThenBlock: { BreakLoop }
        }
        Deallocate(st, 8)
        SystemCall(CCSys.SYS_UNLINK, "/tmp/halcode_app/ready.txt", 0, 0, 0, 0)
        SystemCall(CCSys.SYS_UNLINK, "/tmp/halcode_app/host.port", 0, 0, 0, 0)
        CC_WriteStdout("[host] tools stopped\n")
    }
}

// Persistent tool parent for the GTK desk. Same BootTools + AgentProxy as TUI.
// Shutdown is the ctl port (127.0.0.1:47631, line "shutdown") or SIGTERM/SIGINT.
Function.CC_RunHostMode {
    Body: {
        CC_ChdirToBinDir()
        SystemCall(CCSys.SYS_MKDIR, "/tmp/halcode_app", 493, 0, 0, 0)
        CC_WriteStdout("[host] begin\n")
        History.Init()
        IPCDispatch.Init()
        IPCDState.host_sig = CC_HostArmSig()
        CC_WriteStdout("[host] KillStaleTools\n")
        CC_KillStaleTools()
        CC_WriteStdout("[host] BootTools\n")
        CC_BootTools()
        CC_WriteStdout("[host] StartProxy\n")
        IPCDispatch.StartProxy()
        IPCDState.host_ctl = CC_HostCtlOpen()
        CC_WriteAppFile("/tmp/halcode_app/ready.txt", "1")
        CC_WriteStdout("[host] ready.txt\n")
        CC_RestorePgmemUi(0)
        CC_WritePickupSnapshot()
        CC_WriteStdout("[host] pgmem pickup written\n")
        WhileLoop 1 {
            IPCDispatch.PollProxy()
            CC_ReapChildren()
            IPCDispatch_ReapRespawns()
            IfCondition EqualTo(IPCDispatch_HostCheck(16), 1) ThenBlock: { BreakLoop }
        }
        IfCondition GreaterEqual(IPCDState.host_ctl, 0) ThenBlock: {
            Socket.Close(IPCDState.host_ctl)
            IPCDState.host_ctl = -1
        }
        CC_HostShutdown()
    }
}

// Write a debug line to stderr (fd 2). In agent mode stderr → log file via 2>>.
Function.CC_AgentLog {
    Input: msg: Address
    Body: {
        IfCondition EqualTo(msg, 0) ThenBlock: { ReturnValue(0) }
        alen = StringLength(msg)
        SystemCall(CCSys.SYS_WRITE, 2, msg, alen, 0, 0)
        anl = Allocate(4)
        SetByte(anl, 0, 10) SetByte(anl, 1, 0)
        SystemCall(CCSys.SYS_WRITE, 2, anl, 1, 0, 0)
        Deallocate(anl, 4)
    }
}

Function.CC_FinishDirectReply {
    Input: text: Address
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { text = "" }
        CC_WriteAppFile("/tmp/halcode_app/reply.tmp", text)
        SystemCall(CCSys.SYS_RENAME, "/tmp/halcode_app/reply.tmp", "/tmp/halcode_app/reply.txt", 0, 0, 0)
        CC_WriteStdout(text)
        CC_WriteStdout("\n")
    }
}

Function.CC_FormatSessionList {
    Output: Address
    Body: {
        out = "Sessions (none loaded until you select one):\n"
        s_args = JSON.NewObject()
        JSON.SetString(s_args, "op", "search")
        JSON.SetString(s_args, "query", "session:")
        JSON.SetString(s_args, "kind", "session_meta")
        JSON.SetString(s_args, "scope", "persistent")
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        resp = IPCDispatch.Dispatch("Pgmem", s_args, 0, perr)
        err = Dereference(perr, "dword")
        Deallocate(perr, 8)
        IfCondition EqualTo(err, 1) ThenBlock: {
            ReturnValue("Sessions unavailable (pgmem not attached).")
        }
        IfCondition EqualTo(resp, 0) ThenBlock: {
            ReturnValue(StringConcat(out, "(none)\n"))
        }
        parsed = JSON.AsObject(ParseJSON(resp))
        IfCondition EqualTo(parsed, 0) ThenBlock: {
            ReturnValue(StringConcat(out, "(none)\n"))
        }
        rows = JSON.GetArray(parsed, "rows")
        IfCondition EqualTo(rows, 0) ThenBlock: {
            ReturnValue(StringConcat(out, "(none)\n"))
        }
        n_rows = JSON.ArrayLength(rows)
        written = 0
        i = 0
        WhileLoop And(LessThan(i, n_rows), LessThan(written, 20)) {
            row = JSON.AsObject(JSON.ArrayGet(rows, i))
            IfCondition NotEqual(row, 0) ThenBlock: {
                key = JSON.GetString(row, "key")
                is_meta = 0
                IfCondition NotEqual(key, 0) ThenBlock: {
                    klen = StringLength(key)
                    IfCondition GreaterThan(klen, 5) ThenBlock: {
                        sub_pos = Subtract(klen, 5)
                        IfCondition EqualTo(StringCompare(Add(key, sub_pos), ":meta"), 0) ThenBlock: { is_meta = 1 }
                    }
                }
                IfCondition EqualTo(is_meta, 1) ThenBlock: {
                    content_str = JSON.GetString(row, "content")
                    IfCondition NotEqual(content_str, 0) ThenBlock: {
                        m_obj = JSON.AsObject(ParseJSON(content_str))
                        IfCondition NotEqual(m_obj, 0) ThenBlock: {
                            del = JSON.GetString(m_obj, "deleted")
                            IfCondition EqualTo(del, 0) ThenBlock: {
                                sid = JSON.GetString(m_obj, "id")
                                title = JSON.GetString(m_obj, "title")
                                IfCondition EqualTo(sid, 0) ThenBlock: { sid = "" }
                                IfCondition EqualTo(title, 0) ThenBlock: { title = "Untitled" }
                                IfCondition GreaterThan(StringLength(sid), 0) ThenBlock: {
                                    out = StringConcat(out, sid)
                                    out = StringConcat(out, "  ")
                                    out = StringConcat(out, title)
                                    out = StringConcat(out, "\n")
                                    written = Add(written, 1)
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(written, 0) ThenBlock: {
            out = StringConcat(out, "(none)\n")
        }
        out = StringConcat(out, "Read: /read <id>    Reopen: /resume <id>    New: /new\n")
        ReturnValue(out)
    }
}

// Slash commands that touch the session store without calling the model.
// Natural-language reads go through Pgmem; these are the explicit selectors.
Function.CC_TrySessionCmd {
    Input: prompt: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(prompt, 0) ThenBlock: { ReturnValue(0) }
        ntrim = StringLength(prompt)
        WhileLoop GreaterThan(ntrim, 0) {
            ctrim = GetByte(prompt, Subtract(ntrim, 1))
            IfCondition Or(EqualTo(ctrim, 10), EqualTo(ctrim, 13)) ThenBlock: {
                ntrim = Subtract(ntrim, 1)
                SetByte(prompt, ntrim, 0)
            } ElseBlock: { BreakLoop }
        }
        IfCondition EqualTo(StringCompare(prompt, "/sessions"), 0) ThenBlock: {
            CC_FinishDirectReply(CC_FormatSessionList())
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(prompt, "/new"), 0) ThenBlock: {
            guid = CC_GenerateSessionGUID()
            History.Clear()
            History.SetSessionID(guid)
            History.SetTitle("New Session")
            CC_ClearHotCache()
            CC_MarkNoPickup(guid)
            CC_SaveSessionToPgmem()
            CC_WriteAppFile("/tmp/halcode_app/session.txt", guid)
            msg = StringConcat("New session ", guid)
            msg = StringConcat(msg, ". Prior sessions were not loaded.")
            CC_FinishDirectReply(msg)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(prompt, "/resume"), 0) ThenBlock: {
            loaded = CC_ResumeLastSession()
            IfCondition EqualTo(loaded, 1) ThenBlock: {
                sid = History.GetSessionID()
                IfCondition NotEqual(sid, 0) ThenBlock: {
                    CC_WriteAppFile("/tmp/halcode_app/session.txt", sid)
                }
                SystemCall(87, "/tmp/halcode_app/nopickup.txt", 0, 0, 0, 0)
                CCRunState.fresh = 0
                CC_SaveSessionToPgmem()
                msg = StringConcat("Reopened last session ", sid)
                CC_FinishDirectReply(msg)
            } ElseBlock: {
                CC_FinishDirectReply("No last session to reopen.")
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(CC_StartsWith(prompt, "/resume "), 1) ThenBlock: {
            sid = Add(prompt, 8)
            ok = CC_LoadSessionFromPgmem(sid)
            IfCondition EqualTo(ok, 1) ThenBlock: {
                CC_WriteAppFile("/tmp/halcode_app/session.txt", sid)
                SystemCall(87, "/tmp/halcode_app/nopickup.txt", 0, 0, 0, 0)
                CCRunState.fresh = 0
                CC_SaveSessionToPgmem()
                msg = StringConcat("Reopened session ", sid)
                CC_FinishDirectReply(msg)
            } ElseBlock: {
                msg = StringConcat("Session not found: ", sid)
                CC_FinishDirectReply(msg)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(CC_StartsWith(prompt, "/read "), 1) ThenBlock: {
            sid = Add(prompt, 6)
            hkey = StringConcat("session:", sid)
            hkey = StringConcat(hkey, ":history")
            mkey = StringConcat("session:", sid)
            mkey = StringConcat(mkey, ":meta")
            meta = CC_PgmemPickupKey(mkey)
            hist = CC_PgmemPickupKey(hkey)
            IfCondition EqualTo(hist, 0) ThenBlock: {
                msg = StringConcat("No history for ", sid)
                CC_FinishDirectReply(msg)
                ReturnValue(1)
            }
            body = hist
            IfCondition GreaterThan(StringLength(hist), 4000) ThenBlock: {
                body = StringSubstring(hist, 0, 4000)
                body = StringConcat(body, "\n...[truncated]")
            }
            IfCondition EqualTo(meta, 0) ThenBlock: { meta = "" }
            msg = StringConcat("session ", sid)
            msg = StringConcat(msg, " meta: ")
            msg = StringConcat(msg, meta)
            msg = StringConcat(msg, "\nhistory:\n")
            msg = StringConcat(msg, body)
            CC_FinishDirectReply(msg)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Headless agentic loop: redirect fd 1 to /dev/null, init TUI (escape seqs
// discarded, raw-mode ioctl fails silently on pipe), loop CC_RunTurn until the
// model stops requesting tools (same keep_going logic as CC_ChatLoop), restore
// fd 1, then write the final assistant response to stdout.
Function.CC_RunAgentMode {
    Input: prompt: Address
    Body: {
        CC_AgentLog("[worker] CC_RunAgentMode starting")
        CCRunState.auto_approve = 1

        // Redirect stdout → /dev/null so all TUI/ANSI output is discarded
        devnull = SystemCall(CCSys.SYS_OPEN, "/dev/null", 2, 0, 0, 0)
        saved_stdout = SystemCall(CCSys.SYS_DUP, 1, 0, 0, 0, 0)
        IfCondition GreaterEqual(devnull, 0) ThenBlock: {
            SystemCall(CCSys.SYS_DUP2, devnull, 1, 0, 0, 0)
            SystemCall(CCSys.SYS_CLOSE, devnull, 0, 0, 0, 0)
        }

        CC_AgentLog("[worker] UI.Init")
        UI.Init()
        CC_AgentLog("[worker] appending prompt to history")
        History.AppendUser(prompt)

        CC_AgentLog("[worker] CCFan init")
        fan_ok = CCFan_Init()
        fan_sum = 0
        IfCondition EqualTo(fan_ok, 1) ThenBlock: {
            fan_sum = CCFan_SelfTest()
        }
        CC_AgentLog(StringConcat("[worker] CCFan self-test sum=", NumberToString(fan_sum)))

        // Agentic loop: keep calling CC_RunTurn as long as the model requests
        // tools. After each turn, if the last history entry is a "user" role
        // block (i.e. tool results were just appended), the model needs another
        // round. There is no tool-chain cap. A failed turn still stops.
        agent_turn = 0
        agent_keep_going = 1
        WhileLoop EqualTo(agent_keep_going, 1) {
            agent_keep_going = 0
            CC_AgentLog(StringConcat("[worker] CC_RunTurn turn=", NumberToString(agent_turn)))
            turn_ok = CC_RunTurn()
            CC_AgentLog(StringConcat("[worker] CC_RunTurn complete ok=", NumberToString(turn_ok)))
            IfCondition EqualTo(turn_ok, 0) ThenBlock: {
                CC_AgentLog("[worker] turn failed — stopping")
                agent_keep_going = 0
            }

            // Tool results are appended as role:"user" messages by
            // Backend.AppendToolResultsToHistory. If the last history entry
            // has role "user", the model made tool calls this round and needs
            // another API call to process the results. A failed turn does not
            // continue, even if that last entry is still a user message.
            IfCondition NotEqual(turn_ok, 0) ThenBlock: {
                _am_msgs = History.GetMessagesArray()
                _am_cnt = History.Count()
                IfCondition GreaterThan(_am_cnt, 0) ThenBlock: {
                    _am_last_tag = JSON.ArrayGet(_am_msgs, Subtract(_am_cnt, 1))
                    _am_last_msg = JSON.AsObject(_am_last_tag)
                    IfCondition NotEqual(_am_last_msg, 0) ThenBlock: {
                        _am_last_role = JSON.GetString(_am_last_msg, "role")
                        IfCondition NotEqual(_am_last_role, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(_am_last_role, "user"), 0) ThenBlock: {
                                agent_keep_going = 1
                            }
                        }
                    }
                }
            }
            agent_turn = Add(agent_turn, 1)
        }

        CC_AgentLog("[worker] CCFan shutdown")
        CCFan_Shutdown()

        UI.Shutdown()

        // Restore stdout before writing result
        IfCondition GreaterEqual(saved_stdout, 0) ThenBlock: {
            SystemCall(CCSys.SYS_DUP2, saved_stdout, 1, 0, 0, 0)
            SystemCall(CCSys.SYS_CLOSE, saved_stdout, 0, 0, 0, 0)
        }

        // Walk history backward to find the last assistant message
        msgs = History.GetMessagesArray()
        cnt = History.Count()
        i = Subtract(cnt, 1)
        found = 0
        result = ""
        WhileLoop And(GreaterEqual(i, 0), EqualTo(found, 0)) {
            tag = JSON.ArrayGet(msgs, i)
            msg = JSON.AsObject(tag)
            IfCondition NotEqual(msg, 0) ThenBlock: {
                role = JSON.GetString(msg, "role")
                IfCondition NotEqual(role, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(role, "assistant"), 0) ThenBlock: {
                        c = JSON.GetString(msg, "content")
                        IfCondition NotEqual(c, 0) ThenBlock: { result = c }
                        found = 1
                    }
                }
            }
            i = Subtract(i, 1)
        }

        CC_AgentLog(StringConcat("[worker] result chars=", NumberToString(StringLength(result))))
        IfCondition EqualTo(result, 0) ThenBlock: { result = "" }
        IfCondition EqualTo(Backend.HitLength(), 1) ThenBlock: {
            CC_AgentLog("[worker] finish_reason=length")
            result = StringConcat(result, "\n\n[reply truncated: hit max_tokens — raise max_tokens in ~/.halcode/halcode.json]")
        }
        CC_WriteAppFile("/tmp/halcode_app/reply.tmp", result)
        SystemCall(CCSys.SYS_RENAME, "/tmp/halcode_app/reply.tmp", "/tmp/halcode_app/reply.txt", 0, 0, 0)
        CC_AgentLog("[worker] wrote reply.txt")
        CC_AgentLog("[worker] think dump was during CC_SessionLogResponse (before Reset)")
        CC_WriteStdout(result)
        CC_WriteStdout("\n")
        CC_SaveSessionToPgmem()
        sid_out = History.GetSessionID()
        IfCondition NotEqual(sid_out, 0) ThenBlock: {
            CC_WriteAppFile("/tmp/halcode_app/session.txt", sid_out)
        }
        CC_AgentLog("[worker] done")
    }
}

// =============================================================================
// PARALLEL FAN-OUT POOL — Phase 1: safe leaf ops for the --agent worker.
// Persistent worker pool built on Library.ThreadTrampoline (clone + futex,
// own 4MB mmap heap, no Arena). Workers run read-only leaf ops (StringLength,
// Dereference/StoreValue on pre-allocated slots) in parallel.
//
// RULES (see test_threading.ailang):
//   - Workers must NOT touch the Arena allocator: no Allocate/Deallocate,
//     no PrintMessage/PrintNumber, no StringConcat/NumberToString.
//   - All shared mutable state is one mutex-protected job cursor.
//   - Input strings must stay alive until the batch completes.
//
// Layout (heap blocks allocated by the main thread before any spawn):
//   jobs    = array of max_jobs Address (8 bytes each)
//   results = array of max_jobs Integer (8 bytes each)
//   tids    = array of worker_count Integer (8 bytes each)
// =============================================================================

FixedPool.CCFanState {
    "worker_count":  Initialize=7, CanChange=True
    "max_jobs":      Initialize=64, CanChange=True
    "jobs":          Initialize=0, CanChange=True
    "results":       Initialize=0, CanChange=True
    "tids":          Initialize=0, CanChange=True
    "job_count":     Initialize=0, CanChange=True
    "next_job":      Initialize=0, CanChange=True
    "completed":     Initialize=0, CanChange=True
    "head_mutex":    Initialize=0, CanChange=True
    "active":        Initialize=1, CanChange=True
    "selftest_sum":  Initialize=0, CanChange=True
}

// Worker entry point. cookie = worker index (kept for CallIndirect signature).
Function.CCFan_WorkerEntry {
    Input: cookie: Integer
    Output: Integer
    Body: {
        m = CCFanState.head_mutex
        WhileLoop EqualTo(1, 1) {
            my_job = -1
            Mutex_Lock(m)
            IfCondition LessThan(CCFanState.next_job, CCFanState.job_count) ThenBlock: {
                my_job = CCFanState.next_job
                CCFanState.next_job = Add(my_job, 1)
            }
            Mutex_Unlock(m)

            IfCondition GreaterEqual(my_job, 0) ThenBlock: {
                s = Dereference(Add(CCFanState.jobs, Multiply(my_job, 8)))
                slen = StringLength(s)
                StoreValue(Add(CCFanState.results, Multiply(my_job, 8)), slen)
                Mutex_Lock(m)
                CCFanState.completed = Add(CCFanState.completed, 1)
                Mutex_Unlock(m)
            } ElseBlock: {
                IfCondition EqualTo(CCFanState.active, 0) ThenBlock: {
                    ReturnValue(0)
                }
                Thread_Sleep(1)
            }
        }
        ReturnValue(0)
    }
}

// Spin up the persistent pool. Returns 1 on success, 0 on failure.
Function.CCFan_Init {
    Output: Integer
    Body: {
        Thread_Init()

        CCFanState.jobs = Allocate(Multiply(CCFanState.max_jobs, 8))
        CCFanState.results = Allocate(Multiply(CCFanState.max_jobs, 8))
        CCFanState.tids = Allocate(Multiply(CCFanState.worker_count, 8))
        CCFanState.head_mutex = Mutex_Create()

        IfCondition EqualTo(CCFanState.jobs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CCFanState.results, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CCFanState.tids, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CCFanState.head_mutex, 0) ThenBlock: { ReturnValue(0) }

        CCFanState.active = 1
        CCFanState.job_count = 0
        CCFanState.next_job = 0
        CCFanState.completed = 0

        i = 0
        WhileLoop LessThan(i, CCFanState.worker_count) {
            tid = Thread_Spawn(AddressOf(CCFan_WorkerEntry), i)
            IfCondition EqualTo(tid, 0) ThenBlock: {
                CCFanState.active = 0
                ReturnValue(0)
            }
            StoreValue(Add(CCFanState.tids, Multiply(i, 8)), tid)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Run a batch of N string pointers in parallel; write each StringLength into
// out (N Integers). Blocks until complete. Returns 1 on success.
Function.CCFan_RunBatch {
    Input: strs: Address
    Input: count: Integer
    Input: out: Address
    Output: Integer
    Body: {
        IfCondition GreaterThan(count, CCFanState.max_jobs) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CCFanState.active, 0) ThenBlock: { ReturnValue(0) }

        i = 0
        WhileLoop LessThan(i, count) {
            s = Dereference(Add(strs, Multiply(i, 8)))
            StoreValue(Add(CCFanState.jobs, Multiply(i, 8)), s)
            i = Add(i, 1)
        }

        CCFanState.job_count = count
        CCFanState.next_job = 0
        CCFanState.completed = 0

        WhileLoop LessThan(CCFanState.completed, count) {
            CC_SleepMs(1)
        }

        i = 0
        WhileLoop LessThan(i, count) {
            r = Dereference(Add(CCFanState.results, Multiply(i, 8)))
            StoreValue(Add(out, Multiply(i, 8)), r)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Tear down the pool: signal shutdown, join workers, free heap blocks.
Function.CCFan_Shutdown {
    Body: {
        CCFanState.active = 0
        i = 0
        WhileLoop LessThan(i, CCFanState.worker_count) {
            tid = Dereference(Add(CCFanState.tids, Multiply(i, 8)))
            IfCondition NotEqual(tid, 0) ThenBlock: {
                Thread_Join(tid)
            }
            i = Add(i, 1)
        }
        IfCondition NotEqual(CCFanState.head_mutex, 0) ThenBlock: {
            Mutex_Destroy(CCFanState.head_mutex)
        }
        IfCondition NotEqual(CCFanState.jobs, 0) ThenBlock: {
            Deallocate(CCFanState.jobs, Multiply(CCFanState.max_jobs, 8))
        }
        IfCondition NotEqual(CCFanState.results, 0) ThenBlock: {
            Deallocate(CCFanState.results, Multiply(CCFanState.max_jobs, 8))
        }
        IfCondition NotEqual(CCFanState.tids, 0) ThenBlock: {
            Deallocate(CCFanState.tids, Multiply(CCFanState.worker_count, 8))
        }
        CCFanState.head_mutex = 0
        CCFanState.jobs = 0
        CCFanState.results = 0
        CCFanState.tids = 0
    }
}

// Self-test: 4 strings ("abcd","abcdefgh","abcdefghijkl","abcd") through the
// pool; expected length sum = 4+8+12+4 = 28. Returns the computed sum.
Function.CCFan_SelfTest {
    Output: Integer
    Body: {
        strs = Allocate(Multiply(4, 8))
        s0 = "abcd"
        s1 = "abcdefgh"
        s2 = "abcdefghijkl"
        s3 = "abcd"
        StoreValue(Add(strs, 0), s0)
        StoreValue(Add(strs, 8), s1)
        StoreValue(Add(strs, 16), s2)
        StoreValue(Add(strs, 24), s3)

        out = Allocate(Multiply(4, 8))
        ok = CCFan_RunBatch(strs, 4, out)

        sum = 0
        IfCondition EqualTo(ok, 1) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, 4) {
                sum = Add(sum, Dereference(Add(out, Multiply(i, 8))))
                i = Add(i, 1)
            }
        }
        CCFanState.selftest_sum = sum

        Deallocate(out, Multiply(4, 8))
        Deallocate(strs, Multiply(4, 8))
        ReturnValue(sum)
    }
}

// =============================================================================
// MCP SERVER MODE — ./HalCode9000.x --mcp
// Boots all cc_tools, then speaks MCP JSON-RPC 2.0 over stdio.
// Claude Code (or any MCP client) registers this as an MCP server.
// All tool calls route through the running @halcode/* sockets.
// =============================================================================

// Write one JSONL MCP message: JSON string + newline.
// Claude Code MCP transport uses newline-delimited JSON (JSONL), not Content-Length framing.
Function.CC_MCP_WriteFrame {
    Input: str: Address
    Body: {
        slen = StringLength(str)
        SystemCall(CCSys.SYS_WRITE, 1, str, slen, 0, 0)
        nl = Allocate(4)
        SetByte(nl, 0, 10) SetByte(nl, 1, 0)
        SystemCall(CCSys.SYS_WRITE, 1, nl, 1, 0, 0)
        Deallocate(nl, 4)
    }
}

// Reads one JSONL MCP message from stdin (reads until '\n').
// Returns bytes in buf (excluding the newline), or -1 on EOF/error.
Function.CC_MCP_ReadFrame {
    Input: buf: Address
    Input: maxlen: Integer
    Output: Integer
    Body: {
        total = 0
        lim = Subtract(maxlen, 1)
        WhileLoop LessThan(total, lim) {
            n = SystemCall(CCSys.SYS_READ, 0, Add(buf, total), 1, 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: {
                IfCondition EqualTo(total, 0) ThenBlock: { ReturnValue(-1) }
                BreakLoop
            }
            ch = GetByte(buf, total)
            IfCondition EqualTo(ch, 10) ThenBlock: { BreakLoop }
            total = Add(total, 1)
        }
        // Strip trailing \r if present
        IfCondition And(GreaterThan(total, 0), EqualTo(GetByte(buf, Subtract(total, 1)), 13)) ThenBlock: {
            total = Subtract(total, 1)
        }
        SetByte(buf, total, 0)
        ReturnValue(total)
    }
}

// Extract raw JSON id value (e.g. 1 or "abc") from a JSON-RPC string.
// Returns heap copy of the raw fragment, or 0 if not found.
Function.CC_MCP_ExtractID {
    Input: json_str: Address
    Output: Address
    Body: {
        key = "\"id\":"
        klen = 5
        jlen = StringLength(json_str)
        i = 0
        WhileLoop LessThan(i, Subtract(jlen, klen)) {
            IfCondition EqualTo(MemCompare(Add(json_str, i), key, klen), 0) ThenBlock: {
                j = Add(i, klen)
                WhileLoop LessThan(j, jlen) {
                    c = GetByte(json_str, j)
                    IfCondition Or(EqualTo(c, 32), EqualTo(c, 9)) ThenBlock: {
                        j = Add(j, 1)
                    } ElseBlock: { BreakLoop }
                }
                start = j
                WhileLoop LessThan(j, jlen) {
                    c = GetByte(json_str, j)
                    IfCondition Or(EqualTo(c, 44), EqualTo(c, 125)) ThenBlock: { BreakLoop }
                    j = Add(j, 1)
                }
                id_len = Subtract(j, start)
                IfCondition LessEqual(id_len, 0) ThenBlock: { ReturnValue(0) }
                id_buf = Allocate(Add(id_len, 1))
                MemoryCopy(id_buf, Add(json_str, start), id_len)
                SetByte(id_buf, id_len, 0)
                ReturnValue(id_buf)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.CC_MCP_SendResult {
    Input: id_raw: Address
    Input: result_json: Address
    Body: {
        id_part = id_raw
        IfCondition EqualTo(id_raw, 0) ThenBlock: { id_part = "null" }
        msg = StringConcat("{\"jsonrpc\":\"2.0\",\"id\":", id_part)
        msg = StringConcat(msg, ",\"result\":")
        msg = StringConcat(msg, result_json)
        msg = StringConcat(msg, "}")
        CC_MCP_WriteFrame(msg)
    }
}

Function.CC_MCP_SendError {
    Input: id_raw: Address
    Input: code: Address
    Input: msg_str: Address
    Body: {
        id_part = id_raw
        IfCondition EqualTo(id_raw, 0) ThenBlock: { id_part = "null" }
        escaped = JSON.EscapeString(msg_str)
        frame = StringConcat("{\"jsonrpc\":\"2.0\",\"id\":", id_part)
        frame = StringConcat(frame, ",\"error\":{\"code\":")
        frame = StringConcat(frame, code)
        frame = StringConcat(frame, ",\"message\":\"")
        frame = StringConcat(frame, escaped)
        frame = StringConcat(frame, "\"}}")
        CC_MCP_WriteFrame(frame)
    }
}

Function.CC_MCP_HandleInitialize {
    Input: id_raw: Address
    Body: {
        result = "{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{\"tools\":{\"listChanged\":false}},\"serverInfo\":{\"name\":\"HalCode9000\",\"version\":\"1.0\"}}"
        CC_MCP_SendResult(id_raw, result)
    }
}

Function.CC_MCP_HandleToolsList {
    Input: id_raw: Address
    Body: {
        tools_arr = JSON.NewArray()
        i = 0
        WhileLoop LessThan(i, IPCDState.count) {
            base = Add(IPCDState.table, Multiply(i, IPCDConst.ENTRY_SIZE))
            fd_val = Dereference(Add(base, IPCDOff.FD))
            sch   = Dereference(Add(base, IPCDOff.SCHEMA))
            IfCondition And(GreaterEqual(fd_val, 0), NotEqual(sch, 0)) ThenBlock: {
                tname = JSON.GetString(sch, "name")
                tdesc = JSON.GetString(sch, "description")
                tin   = JSON.GetObject(sch, "input_schema")
                tool  = JSON.NewObject()
                IfCondition NotEqual(tname, 0) ThenBlock: { JSON.SetString(tool, "name", tname) }
                IfCondition NotEqual(tdesc, 0) ThenBlock: { JSON.SetString(tool, "description", tdesc) }
                IfCondition NotEqual(tin, 0)   ThenBlock: { JSON.SetObject(tool, "inputSchema", tin) }
                JSON.PushObject(tools_arr, tool)
            }
            i = Add(i, 1)
        }
        res_obj = JSON.NewObject()
        JSON.SetArray(res_obj, "tools", tools_arr)
        CC_MCP_SendResult(id_raw, JSON.SerializeObject(res_obj))
    }
}

// MCP on-demand boot: parse manifest, launch each worker just long enough to
// fetch its schema, then kill it immediately. No persistent workers.
Function.CC_MCP_BootSchemas {
    Body: {
        CCRunState.child_pids = Allocate(Multiply(CCConst.MAX_CHILDREN, 8))
        MemorySet(CCRunState.child_pids, 0, Multiply(CCConst.MAX_CHILDREN, 8))
        CCRunState.child_count = 0
        MCPToolTable.entries = Allocate(768)   // 32 slots × 24 bytes
        MemorySet(MCPToolTable.entries, 0, 768)
        MCPToolTable.count = 0

        fd = SystemCall(CCSys.SYS_OPEN, "./cc_tools.json", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        mbuf = Allocate(32768)
        n = SystemCall(CCSys.SYS_READ, fd, mbuf, 32767, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { Deallocate(mbuf, 32768) ReturnValue(0) }
        SetByte(mbuf, n, 0)
        parsed = ParseJSON(mbuf)
        IfCondition EqualTo(parsed, 0) ThenBlock: { ReturnValue(0) }
        obj = JSON.AsObject(parsed)
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        tools_arr = JSON.GetArray(obj, "tools")
        IfCondition EqualTo(tools_arr, 0) ThenBlock: { ReturnValue(0) }
        tcount = JSON.ArrayLength(tools_arr)

        // For each tool: store manifest entry, launch, register schema, kill.
        j = 0
        WhileLoop LessThan(j, tcount) {
            et = JSON.ArrayGet(tools_arr, j)
            eo = JSON.AsObject(et)
            IfCondition NotEqual(eo, 0) ThenBlock: {
                bin  = JSON.GetString(eo, "binary")
                tnam = JSON.GetString(eo, "name")
                tsoc = JSON.GetString(eo, "socket")
                IfCondition And(NotEqual(bin, 0), And(NotEqual(tnam, 0), NotEqual(tsoc, 0))) ThenBlock: {
                    // Store in manifest lookup table
                    IfCondition LessThan(MCPToolTable.count, 32) ThenBlock: {
                        slot = Multiply(MCPToolTable.count, 24)
                        StoreValue(Add(MCPToolTable.entries, slot),       tnam)
                        StoreValue(Add(MCPToolTable.entries, Add(slot, 8)),  bin)
                        StoreValue(Add(MCPToolTable.entries, Add(slot, 16)), tsoc)
                        MCPToolTable.count = Add(MCPToolTable.count, 1)
                    }
                    // Launch worker, register schema, kill worker
                    pid = CC_LaunchTool(bin, tnam, tsoc)
                    IfCondition GreaterThan(pid, 0) ThenBlock: {
                        IPCDispatch.RegisterTool(tnam, tsoc, bin)
                        // Kill this worker — we only needed its schema
                        SystemCall(CCSys.SYS_KILL, pid, CCSys.SIGTERM, 0, 0, 0)
                        _ws = Allocate(8)
                        StoreValue(_ws, 0)
                        SystemCall(CCSys.SYS_WAIT4, pid, _ws, 0, 0, 0)
                        Deallocate(_ws, 8)
                    }
                }
            }
            j = Add(j, 1)
        }
        // All workers killed, schemas cached in IPCDState. Clear child tracking.
        CCRunState.child_count = 0
    }
}

// Look up a tool's binary and socket path by name from the manifest table.
// Returns binary path via output, stores socket path at out_sock_ptr.
Function.CC_MCP_FindTool {
    Input: name: Address
    Input: out_sock_ptr: Address
    Output: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, MCPToolTable.count) {
            slot = Multiply(i, 24)
            tnam = Dereference(Add(MCPToolTable.entries, slot))
            IfCondition EqualTo(StringCompare(tnam, name), 0) ThenBlock: {
                bin  = Dereference(Add(MCPToolTable.entries, Add(slot, 8)))
                tsoc = Dereference(Add(MCPToolTable.entries, Add(slot, 16)))
                StoreValue(out_sock_ptr, tsoc)
                ReturnValue(bin)
            }
            i = Add(i, 1)
        }
        StoreValue(out_sock_ptr, 0)
        ReturnValue(0)
    }
}

// Spawn a worker on demand, dispatch one tool call, kill the worker.
// Returns the content string from the tool response.
Function.CC_MCP_DispatchOnDemand {
    Input: tname: Address
    Input: targs: Address
    Input: tool_use_id: Address
    Input: out_is_error_ptr: Address
    Output: Address
    Body: {
        StoreValue(out_is_error_ptr, 0, "dword")
        sock_ptr = Allocate(8)
        bin = CC_MCP_FindTool(tname, sock_ptr)
        tsoc = Dereference(sock_ptr)
        Deallocate(sock_ptr, 8)
        IfCondition EqualTo(bin, 0) ThenBlock: {
            StoreValue(out_is_error_ptr, 1, "dword")
            ReturnValue(StringConcat("tool not found: ", tname))
        }

        // Launch worker
        pid = CC_LaunchTool(bin, tname, tsoc)
        IfCondition LessEqual(pid, 0) ThenBlock: {
            StoreValue(out_is_error_ptr, 1, "dword")
            ReturnValue(StringConcat("failed to launch: ", tname))
        }

        // Connect to worker socket (retry loop — worker needs time to bind)
        cfd = Socket.Create(1, 1)
        attempts = 0
        cr = -1
        WhileLoop LessThan(attempts, 100) {
            cr = Socket.ConnectUnix(cfd, tsoc)
            IfCondition GreaterEqual(cr, 0) ThenBlock: { BreakLoop }
            Socket.Close(cfd)
            cfd = Socket.Create(1, 1)
            _ts = Allocate(16)
            StoreValue(Add(_ts, 0), 0)
            StoreValue(Add(_ts, 8), 100000000)
            SystemCall(CCSys.SYS_NANOSLEEP, _ts, 0, 0, 0, 0)
            Deallocate(_ts, 16)
            attempts = Add(attempts, 1)
        }
        IfCondition LessThan(cr, 0) ThenBlock: {
            SystemCall(CCSys.SYS_KILL, pid, CCSys.SIGKILL, 0, 0, 0)
            _ws = Allocate(8) StoreValue(_ws, 0)
            SystemCall(CCSys.SYS_WAIT4, pid, _ws, 0, 0, 0) Deallocate(_ws, 8)
            StoreValue(out_is_error_ptr, 1, "dword")
            ReturnValue(StringConcat("connect failed: ", tname))
        }

        // Build and send request
        req = JSON.NewObject()
        JSON.SetString(req, "method", "call")
        IfCondition NotEqual(tool_use_id, 0) ThenBlock: {
            JSON.SetString(req, "id", tool_use_id)
        }
        IfCondition NotEqual(targs, 0) ThenBlock: {
            JSON.SetObject(req, "args", targs)
        }
        req_str = JSON.SerializeObject(req)
        sr = Socket.SendMsg(cfd, req_str)
        IfCondition LessThan(sr, 0) ThenBlock: {
            Socket.Close(cfd)
            SystemCall(CCSys.SYS_KILL, pid, CCSys.SIGKILL, 0, 0, 0)
            _ws = Allocate(8) StoreValue(_ws, 0)
            SystemCall(CCSys.SYS_WAIT4, pid, _ws, 0, 0, 0) Deallocate(_ws, 8)
            StoreValue(out_is_error_ptr, 1, "dword")
            ReturnValue(StringConcat("send failed: ", tname))
        }

        // Wait for response with 60s timeout
        Socket.SetRecvTimeout(cfd, 60000)
        resp_str = Socket.RecvMsg(cfd)
        Socket.Close(cfd)

        // Kill the worker
        SystemCall(CCSys.SYS_KILL, pid, CCSys.SIGTERM, 0, 0, 0)
        _ws = Allocate(8) StoreValue(_ws, 0)
        // Non-blocking reap first
        wr = SystemCall(CCSys.SYS_WAIT4, pid, _ws, 1, 0, 0)
        IfCondition EqualTo(wr, 0) ThenBlock: {
            SystemCall(CCSys.SYS_KILL, pid, CCSys.SIGKILL, 0, 0, 0)
            SystemCall(CCSys.SYS_WAIT4, pid, _ws, 0, 0, 0)
        }
        Deallocate(_ws, 8)
        // Remove from child_pids tracking
        _ci = 0
        WhileLoop LessThan(_ci, CCRunState.child_count) {
            _cslot = Multiply(_ci, 8)
            _cpid = Dereference(Add(CCRunState.child_pids, _cslot))
            IfCondition EqualTo(_cpid, pid) ThenBlock: {
                StoreValue(Add(CCRunState.child_pids, _cslot), 0)
            }
            _ci = Add(_ci, 1)
        }

        // Parse response
        IfCondition EqualTo(resp_str, 0) ThenBlock: {
            StoreValue(out_is_error_ptr, 1, "dword")
            ReturnValue(StringConcat("tool timed out or crashed: ", tname))
        }
        IfCondition EqualTo(resp_str, -1) ThenBlock: {
            StoreValue(out_is_error_ptr, 1, "dword")
            ReturnValue(StringConcat("tool response too large: ", tname))
        }
        rparsed = ParseJSON(resp_str)
        IfCondition EqualTo(rparsed, 0) ThenBlock: {
            StoreValue(out_is_error_ptr, 1, "dword")
            ReturnValue("invalid JSON response from tool")
        }
        robj = JSON.AsObject(rparsed)
        IfCondition EqualTo(robj, 0) ThenBlock: {
            StoreValue(out_is_error_ptr, 1, "dword")
            ReturnValue("tool response was not an object")
        }
        ok = JSON.GetBool(robj, "ok")
        IfCondition EqualTo(ok, 1) ThenBlock: {
            content = JSON.GetString(robj, "content")
            IfCondition EqualTo(content, 0) ThenBlock: { ReturnValue(resp_str) }
            ReturnValue(content)
        }
        StoreValue(out_is_error_ptr, 1, "dword")
        err = JSON.GetString(robj, "error")
        IfCondition EqualTo(err, 0) ThenBlock: { ReturnValue("tool returned error (no detail)") }
        ReturnValue(err)
    }
}

Function.CC_MCP_HandleToolsCall {
    Input: id_raw: Address
    Input: params_obj: Address
    Body: {
        IfCondition EqualTo(params_obj, 0) ThenBlock: {
            CC_MCP_SendError(id_raw, "-32602", "missing params")
            ReturnValue(0)
        }
        tname = JSON.GetString(params_obj, "name")
        targs = JSON.GetObject(params_obj, "arguments")
        IfCondition EqualTo(tname, 0) ThenBlock: {
            CC_MCP_SendError(id_raw, "-32602", "missing tool name")
            ReturnValue(0)
        }
        is_err_buf = Allocate(8)
        StoreValue(is_err_buf, 0, "dword")
        content = CC_MCP_DispatchOnDemand(tname, targs, id_raw, is_err_buf)
        is_err = Dereference(is_err_buf)
        Deallocate(is_err_buf, 8)
        IfCondition EqualTo(content, 0) ThenBlock: { content = "" }
        item = JSON.NewObject()
        JSON.SetString(item, "type", "text")
        JSON.SetString(item, "text", content)
        arr = JSON.NewArray()
        JSON.PushObject(arr, item)
        res = JSON.NewObject()
        JSON.SetArray(res, "content", arr)
        IfCondition EqualTo(is_err, 1) ThenBlock: { JSON.SetBool(res, "isError", 1) }
        CC_MCP_SendResult(id_raw, JSON.SerializeObject(res))
    }
}

Function.CC_RunMCPMode {
    Body: {
        buf = Allocate(131072)
        done = 0
        WhileLoop EqualTo(done, 0) {
            n = CC_MCP_ReadFrame(buf, 131072)
            IfCondition LessThan(n, 0) ThenBlock: { done = 1 }
            IfCondition And(EqualTo(done, 0), GreaterThan(n, 0)) ThenBlock: {
                id_raw = CC_MCP_ExtractID(buf)
                parsed = ParseJSON(buf)
                IfCondition EqualTo(parsed, 0) ThenBlock: {
                    CC_MCP_SendError(id_raw, "-32700", "Parse error")
                } ElseBlock: {
                    obj = JSON.AsObject(parsed)
                    IfCondition EqualTo(obj, 0) ThenBlock: {
                        CC_MCP_SendError(id_raw, "-32600", "Invalid Request")
                    } ElseBlock: {
                        method = JSON.GetString(obj, "method")
                        IfCondition EqualTo(method, 0) ThenBlock: {
                            IfCondition NotEqual(id_raw, 0) ThenBlock: {
                                CC_MCP_SendError(id_raw, "-32600", "missing method")
                            }
                        } ElseBlock: {
                            handled = 0
                            IfCondition EqualTo(StringCompare(method, "initialize"), 0) ThenBlock: {
                                CC_MCP_HandleInitialize(id_raw)
                                handled = 1
                            }
                            IfCondition And(EqualTo(handled,0), EqualTo(StringCompare(method,"notifications/initialized"),0)) ThenBlock: {
                                handled = 1
                            }
                            IfCondition And(EqualTo(handled,0), EqualTo(StringCompare(method,"ping"),0)) ThenBlock: {
                                CC_MCP_SendResult(id_raw, "{}")
                                handled = 1
                            }
                            IfCondition And(EqualTo(handled,0), EqualTo(StringCompare(method,"tools/list"),0)) ThenBlock: {
                                CC_MCP_HandleToolsList(id_raw)
                                handled = 1
                            }
                            IfCondition And(EqualTo(handled,0), EqualTo(StringCompare(method,"tools/call"),0)) ThenBlock: {
                                params = JSON.GetObject(obj, "params")
                                CC_MCP_HandleToolsCall(id_raw, params)
                                handled = 1
                            }
                            IfCondition And(EqualTo(handled,0), NotEqual(id_raw,0)) ThenBlock: {
                                CC_MCP_SendError(id_raw, "-32601", "Method not found")
                            }
                        }
                    }
                    JSON.Free(parsed)
                }
            }
        }
        Deallocate(buf, 131072)
    }
}

// =============================================================================
// WEB API MODE — ./HalCode9000.x --serve [--port N]
// Phase 1: GET /healthz + POST /v1/chat (SSE). Reuses the existing --agent
// loop by spawning a worker child per turn. Self-contained tool parent (same
// boot path as --host): boot tools, start AgentProxy, serve HTTP.
// =============================================================================
Function.CC_Serve_WriteStr {
    Input: fd: Integer
    Input: s: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(s)
        IfCondition GreaterThan(slen, 0) ThenBlock: {
            SystemCall(CCSys.SYS_WRITE, fd, s, slen, 0, 0)
        }
    }
}

Function.CC_Serve_SendEvent {
    Input: fd: Integer
    Input: event: Address
    Input: data: Address
    Body: {
        ev = "event: "
        ev = StringConcat(ev, event)
        ev = StringConcat(ev, "\ndata: ")
        ev = StringConcat(ev, data)
        ev = StringConcat(ev, "\n\n")
        CC_Serve_WriteStr(fd, ev)
    }
}

Function.CC_Serve_SendResponse {
    Input: fd: Integer
    Input: status_line: Address
    Input: content_type: Address
    Input: body: Address
    Body: {
        blen = StringLength(body)
        r = "HTTP/1.1 "
        r = StringConcat(r, status_line)
        r = StringConcat(r, "\r\nContent-Type: ")
        r = StringConcat(r, content_type)
        r = StringConcat(r, "\r\nContent-Length: ")
        r = StringConcat(r, NumberToString(blen))
        r = StringConcat(r, "\r\nConnection: close\r\n\r\n")
        r = StringConcat(r, body)
        CC_Serve_WriteStr(fd, r)
    }
}

// Byte search. The compiler StringIndexOf matches only the first byte of
// the needle, so HTTP header and path scans have to walk the whole needle.
Function.CC_Serve_Find {
    Input: hay: Address
    Input: needle: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(hay, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(needle, 0) ThenBlock: { ReturnValue(-1) }
        n_len = StringLength(needle)
        IfCondition EqualTo(n_len, 0) ThenBlock: { ReturnValue(-1) }
        h_len = StringLength(hay)
        IfCondition GreaterThan(n_len, h_len) ThenBlock: { ReturnValue(-1) }
        limit = Subtract(h_len, n_len)
        i = 0
        WhileLoop LessEqual(i, limit) {
            match = 1
            j = 0
            WhileLoop LessThan(j, n_len) {
                IfCondition NotEqual(GetByte(hay, Add(i, j)), GetByte(needle, j)) ThenBlock: {
                    match = 0
                    BreakLoop
                }
                j = Add(j, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: { ReturnValue(i) }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.CC_Serve_GetContentLength {
    Input: headers: Address
    Output: Integer
    Body: {
        p = CC_Serve_Find(headers, "Content-Length:")
        IfCondition LessThan(p, 0) ThenBlock: {
            p = CC_Serve_Find(headers, "content-length:")
        }
        IfCondition LessThan(p, 0) ThenBlock: { ReturnValue(0) }
        p = Add(p, 15)
        WhileLoop EqualTo(GetByte(headers, p), 32) {
            p = Add(p, 1)
        }
        val = 0
        WhileLoop 1 {
            c = GetByte(headers, p)
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: { BreakLoop }
            val = Add(Multiply(val, 10), Subtract(c, 48))
            p = Add(p, 1)
        }
        ReturnValue(val)
    }
}

Function.CC_Serve_ReadRequest {
    Input: fd: Integer
    Input: buf: Address
    Input: buf_size: Integer
    Output: Integer
    Body: {
        total = 0
        header_end = -1
        content_len = 0
        WhileLoop LessThan(total, Subtract(buf_size, 1)) {
            n = SystemCall(CCSys.SYS_READ, fd, Add(buf, total), Subtract(Subtract(buf_size, 1), total), 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }
            total = Add(total, n)
            SetByte(buf, total, 0)
            header_end = CC_Serve_Find(buf, "\r\n\r\n")
            IfCondition GreaterEqual(header_end, 0) ThenBlock: {
                content_len = CC_Serve_GetContentLength(buf)
                body_start = Add(header_end, 4)
                IfCondition GreaterEqual(total, Add(body_start, content_len)) ThenBlock: {
                    BreakLoop
                }
            }
        }
        SetByte(buf, total, 0)
        ReturnValue(total)
    }
}

Function.CC_Serve_RunAgent {
    Input: spec: Address
    Input: prompt: Address
    Input: out_buf: Address
    Input: out_max: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(spec, 0) ThenBlock: { spec = "deepseek" }

        in_path = "/tmp/hal_serve_in.txt"
        out_path = "/tmp/hal_serve_out.txt"
        log_path = "/tmp/hal_serve.log"

        fd = SystemCall(CCSys.SYS_OPEN, in_path, 577, 384, 0, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(CCSys.SYS_WRITE, fd, prompt, StringLength(prompt), 0, 0)
            SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        }
        SystemCall(CCSys.SYS_UNLINK, out_path, 0, 0, 0, 0)

        envp = CC_BuildInheritedEnvp()

        cmd = "./HalCode9000.x --agent "
        cmd = StringConcat(cmd, spec)
        cmd = StringConcat(cmd, " < ")
        cmd = StringConcat(cmd, in_path)
        cmd = StringConcat(cmd, " > ")
        cmd = StringConcat(cmd, out_path)
        cmd = StringConcat(cmd, " 2>>")
        cmd = StringConcat(cmd, log_path)

        pid = SystemCall(CCSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            argv = Allocate(32)
            StoreValue(Add(argv, 0), "/bin/sh")
            StoreValue(Add(argv, 8), "-c")
            StoreValue(Add(argv, 16), cmd)
            StoreValue(Add(argv, 24), 0)
            SystemCall(CCSys.SYS_EXECVE, "/bin/sh", argv, envp)
            SystemCall(CCSys.SYS_EXIT, 1, 0, 0, 0, 0)
        }

        // The agent dials @halcode/AgentProxy while this process would
        // otherwise sit in wait4. Poll the proxy or the dial never completes
        // and the reply stays stuck after it has already been written.
        wstat = Allocate(8)
        WhileLoop 1 {
            StoreValue(wstat, 0)
            wr = SystemCall(CCSys.SYS_WAIT4, pid, wstat, 1, 0, 0)
            IfCondition NotEqual(wr, 0) ThenBlock: { BreakLoop }
            IPCDispatch.PollProxy()
            ts = Allocate(16)
            StoreValue(Add(ts, 0), 0)
            StoreValue(Add(ts, 8), 15000000)
            SystemCall(35, ts, 0, 0, 0, 0)
            Deallocate(ts, 16)
        }
        Deallocate(wstat, 8)

        n = 0
        ofd = SystemCall(CCSys.SYS_OPEN, out_path, 0, 0, 0, 0)
        IfCondition GreaterEqual(ofd, 0) ThenBlock: {
            n = SystemCall(CCSys.SYS_READ, ofd, out_buf, Subtract(out_max, 1), 0, 0)
            SystemCall(CCSys.SYS_CLOSE, ofd, 0, 0, 0, 0)
        }
        IfCondition LessThan(n, 0) ThenBlock: { n = 0 }
        SetByte(out_buf, n, 0)
        ReturnValue(n)
    }
}

// ---------------------------------------------------------------------------
// AUTH — bearer token for --serve mode. Precedence: --token arg -> env
// HALBOT_SERVE_TOKEN -> ~/.halcode/keys.env (HALBOT_SERVE_TOKEN=...). If none
// exist, generate one, persist it to ~/.halcode/keys.env (mode 0600), and
// print it to stdout once at boot so the operator can copy it.
// ---------------------------------------------------------------------------
Function.CC_Serve_KeysEnvPath {
    Output: Address
    Body: {
        home = CC_GetEnv("HOME")
        IfCondition EqualTo(home, 0) ThenBlock: { home = "/root" }
        ReturnValue(StringConcat(home, "/.halcode/keys.env"))
    }
}

Function.CC_Serve_ReadKeysEnvToken {
    Input: path: Address
    Output: Address
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, path, 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(16384)
        n = SystemCall(CCSys.SYS_READ, fd, buf, 16383, 0, 0)
        SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 16384)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        name = "HALBOT_SERVE_TOKEN="
        CC_WriteStdout("[dbg] name_literal=[")
        CC_WriteStdout(name)
        CC_WriteStdout("]\n")
        p = CC_Serve_Find(buf, name)
        CC_WriteStdout("[dbg] n=")
        CC_WriteStdout(NumberToString(n))
        CC_WriteStdout(" name_len=")
        CC_WriteStdout(NumberToString(StringLength(name)))
        CC_WriteStdout(" p=")
        CC_WriteStdout(NumberToString(p))
        CC_WriteStdout("\n")
        IfCondition GreaterEqual(p, 0) ThenBlock: {
            ctx_len = 40
            ctx_end = Add(p, ctx_len)
            IfCondition GreaterThan(ctx_end, n) ThenBlock: { ctx_end = n }
            ctx_start = p
            IfCondition LessThan(ctx_start, 0) ThenBlock: { ctx_start = 0 }
            ctxlen = Subtract(ctx_end, ctx_start)
            ctxbuf = Allocate(Add(ctxlen, 1))
            zz = 0
            WhileLoop LessThan(zz, ctxlen) {
                SetByte(ctxbuf, zz, GetByte(buf, Add(ctx_start, zz)))
                zz = Add(zz, 1)
            }
            SetByte(ctxbuf, ctxlen, 0)
            CC_WriteStdout("[dbg] buf@p..p+40=[")
            CC_WriteStdout(ctxbuf)
            CC_WriteStdout("]\n")
            Deallocate(ctxbuf, Add(ctxlen, 1))
        }
        IfCondition LessThan(p, 0) ThenBlock: {
            Deallocate(buf, 16384)
            ReturnValue(0)
        }
        val_start = Add(p, StringLength(name))
        val_end = val_start
        WhileLoop LessThan(val_end, n) {
            c = GetByte(buf, val_end)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 10) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 13) ThenBlock: { BreakLoop }
            val_end = Add(val_end, 1)
        }
        len = Subtract(val_end, val_start)
        IfCondition LessEqual(len, 0) ThenBlock: {
            Deallocate(buf, 16384)
            ReturnValue(0)
        }
        out = Allocate(Add(len, 1))
        k = 0
        WhileLoop LessThan(k, len) {
            SetByte(out, k, GetByte(buf, Add(val_start, k)))
            k = Add(k, 1)
        }
        SetByte(out, len, 0)
        Deallocate(buf, 16384)
        ReturnValue(out)
    }
}

Function.CC_Serve_AppendKeysEnv {
    Input: path: Address
    Input: line: Address
    Body: {
        fd = SystemCall(CCSys.SYS_OPEN, path, 1089, 384, 0, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(CCSys.SYS_WRITE, fd, line, StringLength(line), 0, 0)
            SystemCall(CCSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        }
    }
}

Function.CC_Serve_GenerateToken {
    Output: Address
    Body: {
        ts = SystemCall(CCSys.SYS_TIME, 0, 0, 0, 0, 0)
        r1 = CC_RandomUint16()
        r2 = CC_RandomUint16()
        r3 = CC_RandomUint16()
        r4 = CC_RandomUint16()
        tok = "hb-"
        tok = StringConcat(tok, NumberToString(ts))
        tok = StringConcat(tok, "-")
        tok = StringConcat(tok, NumberToString(r1))
        tok = StringConcat(tok, NumberToString(r2))
        tok = StringConcat(tok, NumberToString(r3))
        tok = StringConcat(tok, NumberToString(r4))
        ReturnValue(tok)
    }
}

Function.CC_Serve_LoadOrCreateToken {
    Output: Address
    Body: {
        t = CC_ReadArgValue("--token")
        IfCondition NotEqual(t, 0) ThenBlock: {
            IfCondition GreaterThan(StringLength(t), 0) ThenBlock: {
                CC_WriteStdout("[dbg] branch=ARG len=")
                CC_WriteStdout(NumberToString(StringLength(t)))
                CC_WriteStdout("\n")
                ReturnValue(t)
            }
        }
        t = CC_GetEnv("HALBOT_SERVE_TOKEN")
        IfCondition NotEqual(t, 0) ThenBlock: {
            IfCondition GreaterThan(StringLength(t), 0) ThenBlock: {
                CC_WriteStdout("[dbg] branch=ENV len=")
                CC_WriteStdout(NumberToString(StringLength(t)))
                CC_WriteStdout("\n")
                ReturnValue(t)
            }
        }
        path = CC_Serve_KeysEnvPath()
        CC_WriteStdout("[dbg] keys.env path=")
        CC_WriteStdout(path)
        CC_WriteStdout("\n")
        t = CC_Serve_ReadKeysEnvToken(path)
        IfCondition NotEqual(t, 0) ThenBlock: {
            CC_WriteStdout("[dbg] branch=FILE len=")
            CC_WriteStdout(NumberToString(StringLength(t)))
            CC_WriteStdout("\n")
            ReturnValue(t)
        }

        CC_WriteStdout("[dbg] branch=GENERATE\n")
        t = CC_Serve_GenerateToken()
        home = CC_GetEnv("HOME")
        IfCondition EqualTo(home, 0) ThenBlock: { home = "/root" }
        haldir = StringConcat(home, "/.halcode")
        SystemCall(CCSys.SYS_MKDIR, haldir, 448, 0, 0, 0)
        line = "HALBOT_SERVE_TOKEN="
        line = StringConcat(line, t)
        line = StringConcat(line, "\n")
        CC_Serve_AppendKeysEnv(path, line)
        ReturnValue(t)
    }
}

// Returns 1 if the request carries a matching "Authorization: Bearer <t>".
// Sends a 401 and returns 0 otherwise. An empty expected token disables auth.
Function.CC_Serve_CheckAuth {
    Input: fd: Integer
    Input: buf: Address
    Input: expected: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(expected, 0) ThenBlock: { ReturnValue(1) }
        IfCondition LessEqual(StringLength(expected), 0) ThenBlock: { ReturnValue(1) }

        hdr = CC_Serve_Find(buf, "Authorization:")
        IfCondition LessThan(hdr, 0) ThenBlock: {
            hdr = CC_Serve_Find(buf, "authorization:")
        }
        IfCondition LessThan(hdr, 0) ThenBlock: {
            CC_Serve_SendResponse(fd, "401 Unauthorized", "application/json", "{\"ok\":false,\"error\":\"missing authorization header\"}")
            ReturnValue(0)
        }

        val_pos = Add(hdr, 14)
        WhileLoop EqualTo(GetByte(buf, val_pos), 32) {
            val_pos = Add(val_pos, 1)
        }

        scheme = StringSubstring(buf, val_pos, 7)
        IfCondition NotEqual(StringCompare(scheme, "Bearer "), 0) ThenBlock: {
            CC_Serve_SendResponse(fd, "401 Unauthorized", "application/json", "{\"ok\":false,\"error\":\"unsupported auth scheme\"}")
            ReturnValue(0)
        }

        tok_start = Add(val_pos, 7)
        tok_end = tok_start
        WhileLoop 1 {
            c = GetByte(buf, tok_end)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 13) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 10) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 32) ThenBlock: { BreakLoop }
            tok_end = Add(tok_end, 1)
        }
        tok = StringSubstring(buf, tok_start, Subtract(tok_end, tok_start))
        IfCondition NotEqual(StringCompare(tok, expected), 0) ThenBlock: {
            CC_Serve_SendResponse(fd, "401 Unauthorized", "application/json", "{\"ok\":false,\"error\":\"invalid token\"}")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// ---------------------------------------------------------------------------
// SESSIONS — persisted via Pgmem (session:<sid>:meta + session:<sid>:history),
// the same keys the TUI/GUI use, so a --serve session is resumable anywhere.
// ---------------------------------------------------------------------------

// Ensure a session exists (create an empty one if it doesn't). Returns 1.
Function.CC_Serve_EnsureSession {
    Input: sid: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(sid, 0) ThenBlock: { ReturnValue(0) }
        m_key = StringConcat("session:", sid)
        m_key = StringConcat(m_key, ":meta")
        args = JSON.NewObject()
        JSON.SetString(args, "op", "pickup")
        JSON.SetString(args, "key", m_key)
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        resp = IPCDispatch.Dispatch("Pgmem", args, 0, perr)
        err = Dereference(perr, "dword")
        Deallocate(perr, 8)
        IfCondition And(EqualTo(err, 0), NotEqual(resp, 0)) ThenBlock: {
            IfCondition GreaterThan(StringLength(resp), 0) ThenBlock: { ReturnValue(1) }
        }
        History.Clear()
        History.SetSessionID(sid)
        History.SetTitle("New Session")
        CC_SaveSessionToPgmem()
        ReturnValue(1)
    }
}

// Run one chat turn for a session (create a new one if sid==0) and emit SSE.
Function.CC_Serve_RunChatTurn {
    Input: fd: Integer
    Input: body_ptr: Address
    Input: sid: Address
    Body: {
        msg = ""
        prov = 0
        model = 0
        IfCondition NotEqual(body_ptr, 0) ThenBlock: {
            parsed = ParseJSON(body_ptr)
            IfCondition NotEqual(parsed, 0) ThenBlock: {
                obj = JSON.AsObject(parsed)
                IfCondition NotEqual(obj, 0) ThenBlock: {
                    m = JSON.GetString(obj, "message")
                    IfCondition NotEqual(m, 0) ThenBlock: { msg = m }
                    prov = JSON.GetString(obj, "provider")
                    model = JSON.GetString(obj, "model")
                }
            }
        }

        IfCondition EqualTo(StringLength(msg), 0) ThenBlock: {
            CC_Serve_SendResponse(fd, "400 Bad Request", "application/json", "{\"ok\":false,\"error\":\"missing message\"}")
            ReturnValue(0)
        }

        spec = 0
        IfCondition And(NotEqual(prov, 0), NotEqual(model, 0)) ThenBlock: {
            spec = StringConcat(prov, ":")
            spec = StringConcat(spec, model)
        } ElseBlock: {
            IfCondition NotEqual(prov, 0) ThenBlock: {
                spec = prov
            } ElseBlock: {
                spec = CC_ResolveWorkerSpec()
            }
        }

        // Decide + persist the session before spawning the worker so the
        // --agent child resumes exactly this session (CC_GuiApplySession reads
        // /tmp/halcode_app/session.txt). nopickup.txt suppresses the desktop
        // working_state recap from being prepended to the prompt.
        IfCondition EqualTo(sid, 0) ThenBlock: {
            sid = CC_GenerateSessionGUID()
        }
        CC_Serve_EnsureSession(sid)
        CC_WriteAppFile("/tmp/halcode_app/session.txt", sid)
        CC_WriteAppFile("/tmp/halcode_app/nopickup.txt", sid)

        CC_Serve_WriteStr(fd, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: close\r\n\r\n")

        sobj = JSON.NewObject()
        JSON.SetString(sobj, "session_id", sid)
        JSON.SetString(sobj, "model", spec)
        CC_Serve_SendEvent(fd, "session", JSON.SerializeObject(sobj))

        out_buf = Allocate(1048576)
        n = CC_Serve_RunAgent(spec, msg, out_buf, 1048576)

        IfCondition GreaterThan(n, 0) ThenBlock: {
            tobj = JSON.NewObject()
            JSON.SetString(tobj, "text", out_buf)
            CC_Serve_SendEvent(fd, "text_delta", JSON.SerializeObject(tobj))
        }

        dobj = JSON.NewObject()
        JSON.SetString(dobj, "stop_reason", "end_turn")
        CC_Serve_SendEvent(fd, "turn_done", JSON.SerializeObject(dobj))
    }
}

Function.CC_Serve_HandleChat {
    Input: fd: Integer
    Input: body_ptr: Address
    Body: {
        CC_Serve_RunChatTurn(fd, body_ptr, 0)
    }
}

Function.CC_Serve_HandleTools {
    Input: fd: Integer
    Body: {
        schemas = IPCDispatch.GetToolSchemasArray()
        resp = JSON.NewObject()
        JSON.SetArray(resp, "tools", schemas)
        CC_Serve_SendResponse(fd, "200 OK", "application/json", JSON.SerializeObject(resp))
    }
}

Function.CC_Serve_HandleSessionsList {
    Input: fd: Integer
    Body: {
        args = JSON.NewObject()
        JSON.SetString(args, "op", "search")
        JSON.SetString(args, "query", "session:")
        JSON.SetString(args, "kind", "session_meta")
        JSON.SetString(args, "scope", "persistent")
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        resp = IPCDispatch.Dispatch("Pgmem", args, 0, perr)
        err = Dereference(perr, "dword")
        Deallocate(perr, 8)

        out = JSON.NewObject()
        out_arr = JSON.NewArray()
        IfCondition And(EqualTo(err, 0), NotEqual(resp, 0)) ThenBlock: {
            parsed = JSON.AsObject(ParseJSON(resp))
            IfCondition NotEqual(parsed, 0) ThenBlock: {
                rows = JSON.GetArray(parsed, "rows")
                IfCondition NotEqual(rows, 0) ThenBlock: {
                    n_rows = JSON.ArrayLength(rows)
                    i = 0
                    WhileLoop LessThan(i, n_rows) {
                        row = JSON.AsObject(JSON.ArrayGet(rows, i))
                        IfCondition NotEqual(row, 0) ThenBlock: {
                            key = JSON.GetString(row, "key")
                            IfCondition NotEqual(key, 0) ThenBlock: {
                                klen = StringLength(key)
                                IfCondition GreaterThan(klen, 5) ThenBlock: {
                                    sub_pos = Subtract(klen, 5)
                                    IfCondition EqualTo(StringCompare(Add(key, sub_pos), ":meta"), 0) ThenBlock: {
                                        content_str = JSON.GetString(row, "content")
                                        IfCondition NotEqual(content_str, 0) ThenBlock: {
                                            m_obj = JSON.AsObject(ParseJSON(content_str))
                                            IfCondition NotEqual(m_obj, 0) ThenBlock: {
                                                del = JSON.GetString(m_obj, "deleted")
                                                IfCondition EqualTo(del, 0) ThenBlock: {
                                                    JSON.PushObject(out_arr, m_obj)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        i = Add(i, 1)
                    }
                }
            }
        }
        JSON.SetArray(out, "sessions", out_arr)
        CC_Serve_SendResponse(fd, "200 OK", "application/json", JSON.SerializeObject(out))
    }
}

Function.CC_Serve_HandleSessionGet {
    Input: fd: Integer
    Input: sid: Address
    Body: {
        m_key = StringConcat("session:", sid)
        m_key = StringConcat(m_key, ":meta")
        m_args = JSON.NewObject()
        JSON.SetString(m_args, "op", "pickup")
        JSON.SetString(m_args, "key", m_key)
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        m_resp = IPCDispatch.Dispatch("Pgmem", m_args, 0, perr)
        err = Dereference(perr, "dword")
        Deallocate(perr, 8)
        IfCondition Or(EqualTo(err, 1), EqualTo(m_resp, 0)) ThenBlock: {
            CC_Serve_SendResponse(fd, "404 Not Found", "application/json", "{\"ok\":false,\"error\":\"session not found\"}")
            ReturnValue(0)
        }
        meta_obj = JSON.AsObject(ParseJSON(m_resp))
        IfCondition EqualTo(meta_obj, 0) ThenBlock: {
            CC_Serve_SendResponse(fd, "500 Internal Server Error", "application/json", "{\"ok\":false,\"error\":\"bad meta\"}")
            ReturnValue(0)
        }
        del = JSON.GetString(meta_obj, "deleted")
        IfCondition NotEqual(del, 0) ThenBlock: {
            CC_Serve_SendResponse(fd, "404 Not Found", "application/json", "{\"ok\":false,\"error\":\"session deleted\"}")
            ReturnValue(0)
        }

        h_key = StringConcat("session:", sid)
        h_key = StringConcat(h_key, ":history")
        h_args = JSON.NewObject()
        JSON.SetString(h_args, "op", "pickup")
        JSON.SetString(h_args, "key", h_key)
        perr2 = Allocate(8)
        StoreValue(perr2, 0, "dword")
        h_resp = IPCDispatch.Dispatch("Pgmem", h_args, 0, perr2)
        err2 = Dereference(perr2, "dword")
        Deallocate(perr2, 8)
        hist_arr = 0
        IfCondition And(EqualTo(err2, 0), NotEqual(h_resp, 0)) ThenBlock: {
            hist_arr = JSON.AsArray(ParseJSON(h_resp))
        }
        IfCondition EqualTo(hist_arr, 0) ThenBlock: { hist_arr = JSON.NewArray() }

        t_args = JSON.NewObject()
        JSON.SetString(t_args, "op", "task_list")
        JSON.SetString(t_args, "session_id", sid)
        perr3 = Allocate(8)
        StoreValue(perr3, 0, "dword")
        t_resp = IPCDispatch.Dispatch("Pgmem", t_args, 0, perr3)
        err3 = Dereference(perr3, "dword")
        Deallocate(perr3, 8)
        tasks_arr = 0
        IfCondition And(EqualTo(err3, 0), NotEqual(t_resp, 0)) ThenBlock: {
            t_obj = JSON.AsObject(ParseJSON(t_resp))
            IfCondition NotEqual(t_obj, 0) ThenBlock: {
                tasks_arr = JSON.GetArray(t_obj, "tasks")
            }
        }
        IfCondition EqualTo(tasks_arr, 0) ThenBlock: { tasks_arr = JSON.NewArray() }

        JSON.SetArray(meta_obj, "history", hist_arr)
        JSON.SetArray(meta_obj, "tasks", tasks_arr)
        CC_Serve_SendResponse(fd, "200 OK", "application/json", JSON.SerializeObject(meta_obj))
    }
}

Function.CC_Serve_HandleSessionDelete {
    Input: fd: Integer
    Input: sid: Address
    Body: {
        del_meta = JSON.NewObject()
        JSON.SetString(del_meta, "id", sid)
        JSON.SetString(del_meta, "title", "Deleted Session")
        JSON.SetString(del_meta, "deleted", "true")

        m_key = StringConcat("session:", sid)
        m_key = StringConcat(m_key, ":meta")
        m_args = JSON.NewObject()
        JSON.SetString(m_args, "op", "park")
        JSON.SetString(m_args, "key", m_key)
        JSON.SetString(m_args, "kind", "session_meta")
        JSON.SetString(m_args, "scope", "persistent")
        JSON.SetString(m_args, "content", JSON.SerializeObject(del_meta))
        perr = Allocate(8)
        StoreValue(perr, 0, "dword")
        IPCDispatch.Dispatch("Pgmem", m_args, 0, perr)
        Deallocate(perr, 8)

        h_key = StringConcat("session:", sid)
        h_key = StringConcat(h_key, ":history")
        h_args = JSON.NewObject()
        JSON.SetString(h_args, "op", "park")
        JSON.SetString(h_args, "key", h_key)
        JSON.SetString(h_args, "kind", "session_history")
        JSON.SetString(h_args, "scope", "persistent")
        JSON.SetString(h_args, "content", "[]")
        perr2 = Allocate(8)
        StoreValue(perr2, 0, "dword")
        IPCDispatch.Dispatch("Pgmem", h_args, 0, perr2)
        Deallocate(perr2, 8)

        out = JSON.NewObject()
        JSON.SetBool(out, "ok", 1)
        JSON.SetString(out, "deleted", sid)
        CC_Serve_SendResponse(fd, "200 OK", "application/json", JSON.SerializeObject(out))
    }
}

Function.CC_Serve_HandleSessionMessages {
    Input: fd: Integer
    Input: body_ptr: Address
    Input: sid: Address
    Body: {
        CC_Serve_RunChatTurn(fd, body_ptr, sid)
    }
}

// Parse "/v1/sessions/<id>[/messages]" — copies <id> into out (NUL-terminated).
Function.CC_Serve_ParseSessionPath {
    Input: path: Address
    Input: out: Address
    Output: Integer
    Body: {
        prefix = "/v1/sessions/"
        IfCondition NotEqual(CC_Serve_Find(path, prefix), 0) ThenBlock: { ReturnValue(0) }
        start = 13
        end = start
        WhileLoop 1 {
            c = GetByte(path, end)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 47) ThenBlock: { BreakLoop }
            end = Add(end, 1)
        }
        id_len = Subtract(end, start)
        IfCondition LessEqual(id_len, 0) ThenBlock: { ReturnValue(0) }
        k = 0
        WhileLoop LessThan(k, id_len) {
            SetByte(out, k, GetByte(path, Add(start, k)))
            k = Add(k, 1)
        }
        SetByte(out, id_len, 0)
        ReturnValue(1)
    }
}

// 1 if path is "/v1/sessions/<id>/messages", else 0.
Function.CC_Serve_IsMessagesPath {
    Input: path: Address
    Output: Integer
    Body: {
        plen = StringLength(path)
        IfCondition LessThan(plen, 9) ThenBlock: { ReturnValue(0) }
        pos = Subtract(plen, 9)
        IfCondition EqualTo(StringCompare(Add(path, pos), "/messages"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.CC_Serve_HandleClient {
    Input: fd: Integer
    Input: buf: Address
    Input: buf_size: Integer
    Body: {
        total = CC_Serve_ReadRequest(fd, buf, buf_size)
        IfCondition LessEqual(total, 0) ThenBlock: { ReturnValue(0) }

        sp = StringIndexOf(buf, " ")
        IfCondition LessThan(sp, 0) ThenBlock: {
            CC_Serve_SendResponse(fd, "400 Bad Request", "application/json", "{\"ok\":false}")
            ReturnValue(0)
        }

        method = StringSubstring(buf, 0, sp)
        rest_start = Add(sp, 1)
        sp2 = StringIndexOf(Add(buf, rest_start), " ")
        IfCondition LessThan(sp2, 0) ThenBlock: {
            CC_Serve_SendResponse(fd, "400 Bad Request", "application/json", "{\"ok\":false}")
            ReturnValue(0)
        }
        path = StringSubstring(buf, rest_start, sp2)

        header_end = CC_Serve_Find(buf, "\r\n\r\n")
        body_ptr = 0
        IfCondition GreaterEqual(header_end, 0) ThenBlock: {
            body_ptr = Add(buf, Add(header_end, 4))
        }

        is_get = StringCompare(method, "GET")
        is_post = StringCompare(method, "POST")
        is_delete = StringCompare(method, "DELETE")

        // Liveness is unauthenticated; everything else requires the bearer.
        IfCondition And(EqualTo(StringCompare(path, "/healthz"), 0), EqualTo(is_get, 0)) ThenBlock: {
            CC_Serve_SendResponse(fd, "200 OK", "application/json", "{\"ok\":true}")
            ReturnValue(0)
        }

        IfCondition EqualTo(CC_Serve_CheckAuth(fd, buf, CCRunState.serve_token), 0) ThenBlock: {
            ReturnValue(0)
        }

        IfCondition And(EqualTo(StringCompare(path, "/v1/tools"), 0), EqualTo(is_get, 0)) ThenBlock: {
            CC_Serve_HandleTools(fd)
            ReturnValue(0)
        }

        IfCondition And(EqualTo(StringCompare(path, "/v1/chat"), 0), EqualTo(is_post, 0)) ThenBlock: {
            CC_Serve_HandleChat(fd, body_ptr)
            ReturnValue(0)
        }

        IfCondition And(EqualTo(StringCompare(path, "/v1/sessions"), 0), EqualTo(is_get, 0)) ThenBlock: {
            CC_Serve_HandleSessionsList(fd)
            ReturnValue(0)
        }

        IfCondition EqualTo(CC_Serve_Find(path, "/v1/sessions/"), 0) ThenBlock: {
            sid = Allocate(256)
            SetByte(sid, 0, 0)
            IfCondition EqualTo(CC_Serve_ParseSessionPath(path, sid), 1) ThenBlock: {
                IfCondition EqualTo(CC_Serve_IsMessagesPath(path), 1) ThenBlock: {
                    IfCondition EqualTo(is_post, 0) ThenBlock: {
                        CC_Serve_HandleSessionMessages(fd, body_ptr, sid)
                    } ElseBlock: {
                        CC_Serve_SendResponse(fd, "405 Method Not Allowed", "application/json", "{\"ok\":false,\"error\":\"use POST\"}")
                    }
                } ElseBlock: {
                    IfCondition EqualTo(is_get, 0) ThenBlock: {
                        CC_Serve_HandleSessionGet(fd, sid)
                    } ElseBlock: {
                        IfCondition EqualTo(is_delete, 0) ThenBlock: {
                            CC_Serve_HandleSessionDelete(fd, sid)
                        } ElseBlock: {
                            CC_Serve_SendResponse(fd, "405 Method Not Allowed", "application/json", "{\"ok\":false,\"error\":\"method not allowed\"}")
                        }
                    }
                }
            } ElseBlock: {
                CC_Serve_SendResponse(fd, "400 Bad Request", "application/json", "{\"ok\":false,\"error\":\"bad session path\"}")
            }
            Deallocate(sid, 256)
            ReturnValue(0)
        }

        CC_Serve_SendResponse(fd, "404 Not Found", "application/json", "{\"ok\":false,\"error\":\"not found\"}")
        ReturnValue(0)
    }
}

Function.CC_RunServeMode {
    Body: {
        CC_ChdirToBinDir()
        SystemCall(CCSys.SYS_MKDIR, "/tmp/halcode_app", 493, 0, 0, 0)
        History.Init()
        IPCDispatch.Init()
        CC_KillStaleTools()
        CC_BootTools()
        IPCDispatch.StartProxy()
        CC_RestorePgmemUi(0)

        CCRunState.serve_token = CC_Serve_LoadOrCreateToken()
        CC_WriteStdout("[serve] bearer token: ")
        CC_WriteStdout(CCRunState.serve_token)
        CC_WriteStdout("\n")

        port = 8080
        port_str = CC_ReadArgValue("--port")
        IfCondition NotEqual(port_str, 0) ThenBlock: {
            pv = StringToInt(port_str)
            IfCondition GreaterThan(pv, 0) ThenBlock: { port = pv }
        }

        server_fd = Socket.Create(2, 1)
        IfCondition LessThan(server_fd, 0) ThenBlock: {
            CC_WriteStdout("[serve] socket create failed\n")
            ReturnValue(0)
        }

        opt = Allocate(4)
        StoreValue(opt, 1, "dword")
        SystemCall(54, server_fd, 1, 2, opt, 4)
        Deallocate(opt, 4)

        addr = Socket.CreateAddr("127.0.0.1", port)
        brc = SystemCall(49, server_fd, addr, 16, 0, 0)
        Deallocate(addr, 16)
        IfCondition LessThan(brc, 0) ThenBlock: {
            CC_WriteStdout("[serve] bind failed (port busy?)\n")
            Socket.Close(server_fd)
            ReturnValue(0)
        }

        lrc = Socket.Listen(server_fd, 16)
        IfCondition LessThan(lrc, 0) ThenBlock: {
            CC_WriteStdout("[serve] listen failed\n")
            Socket.Close(server_fd)
            ReturnValue(0)
        }

        CC_WriteStdout("[serve] listening on 127.0.0.1:")
        CC_WriteStdout(NumberToString(port))
        CC_WriteStdout("\n")

        buf = Allocate(65536)
        WhileLoop 1 {
            client_fd = Socket.Accept(server_fd)
            IfCondition GreaterEqual(client_fd, 0) ThenBlock: {
                Socket.SetRecvTimeout(client_fd, 30000)
                CC_Serve_HandleClient(client_fd, buf, 65536)
                Socket.Close(client_fd)
            }
        }
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {

    // Ignore SIGPIPE, SIGINT, SIGTERM — prevents abrupt process death.
    // SIGPIPE: broken pipe returns EPIPE from write() instead of killing us.
    // SIGINT:  Ctrl+C is handled as byte 0x03 in UI.ReadLine (requires ISIG cleared).
    // SIGTERM: external kill -15 is ignored; use /quit or kill -9 to force exit.
    // Without SIGINT/SIGTERM ignored, the process dies before CC_KillAllChildren
    // can reap children, leaving zombie tool services.
    sigact = Allocate(32)
    StoreValue(Add(sigact, 0), 1)    // sa_handler = SIG_IGN (1)
    StoreValue(Add(sigact, 8), 0)    // sa_flags = 0
    StoreValue(Add(sigact, 16), 0)   // sa_restorer = 0
    StoreValue(Add(sigact, 24), 0)   // sa_mask = 0
    SystemCall(13, 13, sigact, 0, 8, 0)  // rt_sigaction(SIGPIPE=13, &act, NULL, 8)
    SystemCall(13, 2, sigact, 0, 8, 0)   // rt_sigaction(SIGINT=2,  &act, NULL, 8)
    SystemCall(13, 15, sigact, 0, 8, 0)  // rt_sigaction(SIGTERM=15, &act, NULL, 8)
    Deallocate(sigact, 32)

    // MCP server mode: ./HalCode9000.x --mcp
    // On-demand architecture: workers are spawned per tool call and killed after.
    // No persistent daemon workers — zero zombies, zero idle CPU.
    mcp_flag = CC_HasArg("--mcp")
    IfCondition EqualTo(mcp_flag, 1) ThenBlock: {
        // Restore default SIGINT/SIGTERM so Claude Code can kill us cleanly.
        // MCP mode has no persistent children to protect.
        mcp_sigact = Allocate(32)
        StoreValue(Add(mcp_sigact, 0), 0)    // sa_handler = SIG_DFL (0)
        StoreValue(Add(mcp_sigact, 8), 0)
        StoreValue(Add(mcp_sigact, 16), 0)
        StoreValue(Add(mcp_sigact, 24), 0)
        SystemCall(13, 2, mcp_sigact, 0, 8, 0)   // rt_sigaction(SIGINT=2)
        SystemCall(13, 15, mcp_sigact, 0, 8, 0)  // rt_sigaction(SIGTERM=15)
        Deallocate(mcp_sigact, 32)

        CC_ChdirToBinDir()
        CC_KillStaleTools()
        History.Init()
        IPCDispatch.Init()
        cred = CC_SetupAgentProvider(CC_ResolveWorkerSpec())
        CCConst.SYSTEM_PROMPT = CC_EnsureSystemPrompt()
        Backend.Init("apikey", cred, CCConst.SYSTEM_PROMPT)
        // Respond to initialize immediately so health checks pass before schema boot.
        mcp_init_buf = Allocate(16384)
        mcp_init_n = CC_MCP_ReadFrame(mcp_init_buf, 16384)
        IfCondition LessThan(mcp_init_n, 0) ThenBlock: {
            SystemCall(CCSys.SYS_EXIT, 0, 0, 0, 0, 0)
        }
        IfCondition GreaterThan(mcp_init_n, 0) ThenBlock: {
            mcp_init_id = CC_MCP_ExtractID(mcp_init_buf)
            CC_MCP_HandleInitialize(mcp_init_id)
        }
        // Boot schemas: launch each worker, fetch schema, kill it.
        // Redirect boot messages to stderr to keep MCP stream clean.
        saved_out = SystemCall(CCSys.SYS_DUP, 1, 0, 0, 0, 0)
        SystemCall(CCSys.SYS_DUP2, 2, 1, 0, 0, 0)
        CC_MCP_BootSchemas()
        IfCondition GreaterEqual(saved_out, 0) ThenBlock: {
            SystemCall(CCSys.SYS_DUP2, saved_out, 1, 0, 0, 0)
            SystemCall(CCSys.SYS_CLOSE, saved_out, 0, 0, 0, 0)
        }
        CC_RunMCPMode()
        SystemCall(CCSys.SYS_EXIT, 0, 0, 0, 0, 0)
    }

    // Web API mode: ./HalCode9000.x --serve [--port N]
    // Self-contained HTTP+SSE backend; boots tools + AgentProxy like --host.
    serve_flag = CC_HasArg("--serve")
    IfCondition EqualTo(serve_flag, 1) ThenBlock: {
        serve_sig = Allocate(32)
        StoreValue(Add(serve_sig, 0), 0)
        StoreValue(Add(serve_sig, 8), 0)
        StoreValue(Add(serve_sig, 16), 0)
        StoreValue(Add(serve_sig, 24), 0)
        SystemCall(13, 2, serve_sig, 0, 8, 0)
        SystemCall(13, 15, serve_sig, 0, 8, 0)
        Deallocate(serve_sig, 32)
        CC_RunServeMode()
        SystemCall(CCSys.SYS_EXIT, 0, 0, 0, 0, 0)
    }

    // GUI tool parent: ./HalCode9000.x --host
    // Boots cc_tools + AgentProxy like the TUI, pickups pgmem, stays up.
    host_flag = CC_HasArg("--host")
    IfCondition EqualTo(host_flag, 1) ThenBlock: {
        host_sigact = Allocate(32)
        StoreValue(Add(host_sigact, 0), 0)
        StoreValue(Add(host_sigact, 8), 0)
        StoreValue(Add(host_sigact, 16), 0)
        StoreValue(Add(host_sigact, 24), 0)
        SystemCall(13, 2, host_sigact, 0, 8, 0)
        SystemCall(13, 15, host_sigact, 0, 8, 0)
        Deallocate(host_sigact, 32)
        CC_RunHostMode()
        SystemCall(CCSys.SYS_EXIT, 0, 0, 0, 0, 0)
    }

    // Headless agent mode: ./HalCode9000.x --agent <provider>[:<model>]
    // Must be detected before the splash so nothing writes to stdout.
    agent_spec = CC_ReadArgValue("--agent")
    IfCondition NotEqual(agent_spec, 0) ThenBlock: {
        ag_sig = Allocate(32)
        StoreValue(Add(ag_sig, 0), 0)
        StoreValue(Add(ag_sig, 8), 0)
        StoreValue(Add(ag_sig, 16), 0)
        StoreValue(Add(ag_sig, 24), 0)
        SystemCall(13, 2, ag_sig, 0, 8, 0)
        SystemCall(13, 15, ag_sig, 0, 8, 0)
        Deallocate(ag_sig, 32)
        CC_AgentLog("[init] agent mode detected SIGTERM=DFL")
        prompt_buf = Allocate(CCConst.INPUT_BUF_SZ)
        CC_AgentLog("[init] reading stdin")
        n_read = CC_ReadStdinAll(prompt_buf, CCConst.INPUT_BUF_SZ)
        CC_AgentLog(StringConcat("[init] stdin bytes=", NumberToString(n_read)))
        IfCondition LessEqual(n_read, 0) ThenBlock: {
            CC_AgentLog("[init] empty stdin — exiting")
            SystemCall(CCSys.SYS_EXIT, 1, 0, 0, 0, 0)
        }
        CC_AgentLog("[init] CC_SetupAgentProvider")
        cred = CC_SetupAgentProvider(agent_spec)
        CC_AgentLog("[init] SYSTEM_PROMPT assign")
        CCConst.SYSTEM_PROMPT = CC_EnsureSystemPrompt()
        CC_AgentLog("[init] History.Init")
        History.Init()
        CC_AgentLog("[init] IPCDispatch.Init")
        IPCDispatch.Init()
        CC_AgentLog("[init] Backend.Init")
        Backend.Init("apikey", cred, CCConst.SYSTEM_PROMPT)
        CC_LoadHalcodeConfig()
        CC_AgentLog("[init] CC_RegisterToolsOnly")
        CC_RegisterToolsOnly()
        CC_AgentLog("[init] CC_RestorePgmemUi")
        CC_RestorePgmemUi(0)
        CC_AgentLog("[init] session command?")
        IfCondition EqualTo(CC_TrySessionCmd(prompt_buf), 1) ThenBlock: {
            CC_AgentLog("[init] session command handled")
            SystemCall(CCSys.SYS_EXIT, 0, 0, 0, 0, 0)
        }
        CC_AgentLog("[init] CC_GuiApplySession")
        CC_GuiApplySession()
        CC_AgentLog("[init] CC_RunAgentMode")
        CC_RunAgentMode(prompt_buf)
        SystemCall(CCSys.SYS_EXIT, 0, 0, 0, 0, 0)
    }

    // Startup animation — HALCODE assembles from both sides, eye orbits O.
    UI.StartupAnimation()

    // Demo mode: skip auth + tool launches + real API; just render the UI
    // primitives so the operator can eyeball the look. Demo handles its own UI.Init.
    demo_active = 0
    demo_env = CC_GetEnv("CC_DEMO")
    IfCondition NotEqual(demo_env, 0) ThenBlock: {
        IfCondition GreaterThan(StringLength(demo_env), 0) ThenBlock: {
            demo_active = 1
        }
    }
    IfCondition EqualTo(demo_active, 1) ThenBlock: {
        CC_RunDemo()
        SystemCall(CCSys.SYS_EXIT, 0, 0, 0, 0, 0)
    }

    // Auth runs in COOKED mode (line input from kernel, no raw-mode TUI).
    // Tool registration logs print via PrintMessage; both happen before
    // we grab the screen.

    CCConst.SYSTEM_PROMPT = CC_EnsureSystemPrompt()

    CC_ChdirToBinDir()
    CC_KillStaleTools()
    CC_SessionInit()

    // Tools are provider-agnostic — boot once for the lifetime of the process.
    History.Init()
    IPCDispatch.Init()
    CC_BootTools()
    IPCDispatch.StartProxy()

    // Outer loop: /home returns here to pick a different provider without restarting.
    // auth_result == 0 means user quit from the provider menu — exit immediately.
    go_home = 1
    WhileLoop EqualTo(go_home, 1) {
        auth_result = CC_RunAuth()

        IfCondition EqualTo(auth_result, 0) ThenBlock: { go_home = 0 }
        IfCondition NotEqual(auth_result, 0) ThenBlock: {
            auth_mode_str = JSON.GetString(auth_result, "mode")
            credential = JSON.GetString(auth_result, "credential")
            CCRunState.auth_mode = auth_mode_str
            CCRunState.auth_cred = credential

            CCConst.PROJ_PROMPT = CC_LoadProjectPrompt()
            Backend.Init(auth_mode_str, credential, CC_BuildFullPrompt())
            CC_LoadHalcodeConfig()

            // Now grab the terminal — auth is done, no more cooked-mode prints.
            // Rotate previous session's chat log before opening a new one.
            ChatLog_Rotate()
            UI.Init()

            // Enable Terminal Bracketed Paste (\e[?2004h)
            bp_on = Allocate(16)
            SetByte(bp_on,0,27) SetByte(bp_on,1,91) SetByte(bp_on,2,63) SetByte(bp_on,3,50) SetByte(bp_on,4,48) SetByte(bp_on,5,48) SetByte(bp_on,6,52) SetByte(bp_on,7,104) SetByte(bp_on,8,0)
            CC_WriteStdout(bp_on)
            Deallocate(bp_on, 16)

            UI.BootScroll()

            // Restore project/thread/working_state from Pgmem — same path as GUI.
            CC_RestorePgmemUi(1)

            // Compact in-chat session header — small mascot + version/model/cwd
            UI.SessionHeader(0, 0, 0)

            CCRunState.running = 1
            CCRunState.go_home = 0
            go_home = CC_ChatLoop()

            // Release terminal before looping back to cooked-mode provider menu.
            UI.Shutdown()
        }
    }

    CC_SessionCleanup()
    IPCDispatch.Shutdown()
    CC_KillAllChildren()
    SystemCall(CCSys.SYS_EXIT, 0, 0, 0, 0, 0)
}

RunTask(Main)
