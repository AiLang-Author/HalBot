Function.Op_Graph {
    Input: args: Address
    Input: err_buf: Address
    Output: Address
    Body: {
        symbol = JSON.GetString(args, "symbol")
        IfCondition EqualTo(symbol, 0) ThenBlock: {
            MemoryCopy(err_buf, "missing 'symbol' for op=graph", 29)
            SetByte(err_buf, 29, 0)
            ReturnValue(0)
        }
        limit = JSON.GetNumber(args, "limit")
        IfCondition LessEqual(limit, 0) ThenBlock: { limit = 50 }
        Buf_Reset()
        proj_str = NumberToString(CCRelState.project_id)
        esc_sym = Rel_EscStr(symbol)
        limit_str = NumberToString(limit)

        // Outbound edges: symbol -> ?
        sql = StringConcat("SELECT DISTINCT e.callee, e.kind, f.rel_path FROM hc_symbol_edges e LEFT JOIN hc_files f ON e.file_id=f.id WHERE e.project_id=", proj_str)
        sql = StringConcat(sql, " AND lower(e.caller)=lower('")
        sql = StringConcat(sql, esc_sym)
        sql = StringConcat(sql, "') ORDER BY e.kind, e.callee LIMIT ")
        sql = StringConcat(sql, limit_str)
        rows = PG_Query(CCRelState.conn, sql)
        out_cnt = 0
        IfCondition NotEqual(rows, 0) ThenBlock: {
            out_cnt = Array.Size(rows)
            IfCondition GreaterThan(out_cnt, 0) ThenBlock: {
                Buf_AppendStr(symbol)
                Buf_AppendStr(" outbound (")
                Buf_AppendInt(out_cnt)
                Buf_AppendStr("):\n")
                i = 0
                WhileLoop LessThan(i, out_cnt) {
                    row = Array.Get(rows, i)
                    callee = Hash.Get(row, "callee")
                    ekind  = Hash.Get(row, "kind")
                    rpath  = Hash.Get(row, "rel_path")
                    Buf_AppendStr("  ")
                    IfCondition NotEqual(ekind, 0) ThenBlock: { Buf_AppendStr(ekind) } ElseBlock: { Buf_AppendStr("calls") }
                    Buf_AppendStr(" -> ")
                    IfCondition NotEqual(callee, 0) ThenBlock: { Buf_AppendStr(callee) }
                    IfCondition NotEqual(rpath, 0) ThenBlock: { Buf_AppendStr("  (")  Buf_AppendStr(rpath)  Buf_AppendStr(")") }
                    Buf_AppendNL()
                    i = Add(i, 1)
                }
            }
            PG_DestroyResult(rows)
        }

        // Inbound edges: ? -> symbol
        sql2 = StringConcat("SELECT DISTINCT e.caller, e.kind, f.rel_path FROM hc_symbol_edges e LEFT JOIN hc_files f ON e.file_id=f.id WHERE e.project_id=", proj_str)
        sql2 = StringConcat(sql2, " AND lower(e.callee)=lower('")
        sql2 = StringConcat(sql2, esc_sym)
        sql2 = StringConcat(sql2, "') ORDER BY e.kind, e.caller LIMIT ")
        sql2 = StringConcat(sql2, limit_str)
        rows2 = PG_Query(CCRelState.conn, sql2)
        IfCondition NotEqual(rows2, 0) ThenBlock: {
            in_cnt = Array.Size(rows2)
            IfCondition GreaterThan(in_cnt, 0) ThenBlock: {
                Buf_AppendStr(symbol)
                Buf_AppendStr(" inbound (")
                Buf_AppendInt(in_cnt)
                Buf_AppendStr("):\n")
                i2 = 0
                WhileLoop LessThan(i2, in_cnt) {
                    row2 = Array.Get(rows2, i2)
                    caller2 = Hash.Get(row2, "caller")
                    ekind2  = Hash.Get(row2, "kind")
                    rpath2  = Hash.Get(row2, "rel_path")
                    Buf_AppendStr("  ")
                    IfCondition NotEqual(caller2, 0) ThenBlock: { Buf_AppendStr(caller2) }
                    Buf_AppendStr(" -")
                    IfCondition NotEqual(ekind2, 0) ThenBlock: { Buf_AppendStr(ekind2) } ElseBlock: { Buf_AppendStr("calls") }
                    Buf_AppendStr("-> ")
                    Buf_AppendStr(symbol)
                    IfCondition NotEqual(rpath2, 0) ThenBlock: { Buf_AppendStr("  (")  Buf_AppendStr(rpath2)  Buf_AppendStr(")") }
                    Buf_AppendNL()
                    i2 = Add(i2, 1)
                }
            }
            PG_DestroyResult(rows2)
        }

        IfCondition EqualTo(RespBuf.len, 0) ThenBlock: {
            Buf_AppendStr("[no edges found for: ")
            Buf_AppendStr(symbol)
            Buf_AppendStr("]\n")
        }
        ReturnValue(Buf_Content())
    }
}

Function.Op_Imports {
    Input: args: Address
    Input: err_buf: Address
    Output: Address
    Body: {
        path = JSON.GetString(args, "path")
        symbol = JSON.GetString(args, "symbol")
        IfCondition And(EqualTo(path, 0), EqualTo(symbol, 0)) ThenBlock: {
            MemoryCopy(err_buf, "op=imports requires 'path' or 'symbol'", 38)
            SetByte(err_buf, 38, 0)
            ReturnValue(0)
        }
        Buf_Reset()
        proj_str = NumberToString(CCRelState.project_id)

        IfCondition NotEqual(path, 0) ThenBlock: {
            // What does this file import?
            esc_path = Rel_EscStr(path)
            sql = StringConcat("SELECT DISTINCT e.callee FROM hc_symbol_edges e JOIN hc_files f ON e.file_id=f.id WHERE e.project_id=", proj_str)
            sql = StringConcat(sql, " AND e.kind='imports' AND (f.path='")
            sql = StringConcat(sql, esc_path)
            sql = StringConcat(sql, "' OR f.rel_path='")
            sql = StringConcat(sql, esc_path)
            sql = StringConcat(sql, "') ORDER BY e.callee LIMIT 100")
            rows = PG_Query(CCRelState.conn, sql)
            IfCondition NotEqual(rows, 0) ThenBlock: {
                cnt = Array.Size(rows)
                Buf_AppendStr(path)
                Buf_AppendStr(" imports (")
                Buf_AppendInt(cnt)
                Buf_AppendStr("):\n")
                i = 0
                WhileLoop LessThan(i, cnt) {
                    row = Array.Get(rows, i)
                    callee = Hash.Get(row, "callee")
                    IfCondition NotEqual(callee, 0) ThenBlock: { Buf_AppendStr("  ")  Buf_AppendStr(callee)  Buf_AppendNL() }
                    i = Add(i, 1)
                }
                PG_DestroyResult(rows)
            }
        }

        IfCondition NotEqual(symbol, 0) ThenBlock: {
            // Who imports this module/symbol?
            esc_sym2 = Rel_EscStr(symbol)
            sql2 = StringConcat("SELECT DISTINCT f.rel_path FROM hc_symbol_edges e JOIN hc_files f ON e.file_id=f.id WHERE e.project_id=", proj_str)
            sql2 = StringConcat(sql2, " AND e.kind='imports' AND lower(e.callee) LIKE lower('%")
            sql2 = StringConcat(sql2, esc_sym2)
            sql2 = StringConcat(sql2, "%') ORDER BY f.rel_path LIMIT 50")
            rows2 = PG_Query(CCRelState.conn, sql2)
            IfCondition NotEqual(rows2, 0) ThenBlock: {
                cnt2 = Array.Size(rows2)
                Buf_AppendStr(symbol)
                Buf_AppendStr(" imported by (")
                Buf_AppendInt(cnt2)
                Buf_AppendStr("):\n")
                i2 = 0
                WhileLoop LessThan(i2, cnt2) {
                    row2 = Array.Get(rows2, i2)
                    rp = Hash.Get(row2, "rel_path")
                    IfCondition NotEqual(rp, 0) ThenBlock: { Buf_AppendStr("  ")  Buf_AppendStr(rp)  Buf_AppendNL() }
                    i2 = Add(i2, 1)
                }
                PG_DestroyResult(rows2)
            }
        }

        IfCondition EqualTo(RespBuf.len, 0) ThenBlock: { Buf_AppendStr("[no import edges found]\n") }
        ReturnValue(Buf_Content())
    }
}

Function.Op_Dependents {
    Input: args: Address
    Input: err_buf: Address
    Output: Address
    Body: {
        symbol = JSON.GetString(args, "symbol")
        IfCondition EqualTo(symbol, 0) ThenBlock: {
            MemoryCopy(err_buf, "missing 'symbol' for op=dependents", 35)
            SetByte(err_buf, 35, 0)
            ReturnValue(0)
        }
        limit = JSON.GetNumber(args, "limit")
        IfCondition LessEqual(limit, 0) ThenBlock: { limit = 50 }
        Buf_Reset()
        proj_str = NumberToString(CCRelState.project_id)
        esc_sym = Rel_EscStr(symbol)
        limit_str = NumberToString(limit)
        sql = StringConcat("SELECT DISTINCT e.caller, e.kind, f.rel_path FROM hc_symbol_edges e LEFT JOIN hc_files f ON e.file_id=f.id WHERE e.project_id=", proj_str)
        sql = StringConcat(sql, " AND lower(e.callee)=lower('")
        sql = StringConcat(sql, esc_sym)
        sql = StringConcat(sql, "') ORDER BY e.kind, e.caller LIMIT ")
        sql = StringConcat(sql, limit_str)
        rows = PG_Query(CCRelState.conn, sql)
        IfCondition EqualTo(rows, 0) ThenBlock: {
            Buf_AppendStr("[query error]\n")
            ReturnValue(Buf_Content())
        }
        cnt = Array.Size(rows)
        IfCondition EqualTo(cnt, 0) ThenBlock: {
            PG_DestroyResult(rows)
            Buf_AppendStr("[no dependents found for: ")
            Buf_AppendStr(symbol)
            Buf_AppendStr("]\n")
            ReturnValue(Buf_Content())
        }
        Buf_AppendStr("dependents of ")
        Buf_AppendStr(symbol)
        Buf_AppendStr(" (")
        Buf_AppendInt(cnt)
        Buf_AppendStr("):\n")
        i = 0
        WhileLoop LessThan(i, cnt) {
            row = Array.Get(rows, i)
            caller = Hash.Get(row, "caller")
            ekind  = Hash.Get(row, "kind")
            rpath  = Hash.Get(row, "rel_path")
            Buf_AppendStr("  ")
            IfCondition NotEqual(caller, 0) ThenBlock: { Buf_AppendStr(caller) }
            Buf_AppendStr(" via ")
            IfCondition NotEqual(ekind, 0) ThenBlock: { Buf_AppendStr(ekind) } ElseBlock: { Buf_AppendStr("calls") }
            IfCondition NotEqual(rpath, 0) ThenBlock: { Buf_AppendStr("  (")  Buf_AppendStr(rpath)  Buf_AppendStr(")") }
            Buf_AppendNL()
            i = Add(i, 1)
        }
        PG_DestroyResult(rows)
        ReturnValue(Buf_Content())
    }
}

// Build the comma-wrapped extension allowlist from a user csv arg
// (e.g. "ailang,py,sh,md") into ",ailang,py,sh,md," form for substring
// matching. Stored in OpScratch.tmp (caller consumes immediately).
Function.Index_BuildExtCSV {
    Input: user_csv: Address
    Output: Address
    Body: {
        IfCondition EqualTo(user_csv, 0) ThenBlock: {
            user_csv = "ailang,py,sh,md,c,zig,html,json"
        }
        ulen = StringLength(user_csv)
        SetByte(OpScratch.tmp, 0, 44)
        i = 0
        out = 1
        WhileLoop LessThan(i, ulen) {
            ch = GetByte(user_csv, i)
            IfCondition NotEqual(ch, 32) ThenBlock: {
                IfCondition NotEqual(ch, 46) ThenBlock: {
                    IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ch = Add(ch, 32) }
                    IfCondition LessThan(out, Subtract(OpScratch.cap, 2)) ThenBlock: {
                        SetByte(OpScratch.tmp, out, ch)
                        out = Add(out, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition GreaterThan(out, 1) ThenBlock: {
            IfCondition NotEqual(GetByte(OpScratch.tmp, Subtract(out, 1)), 44) ThenBlock: {
                SetByte(OpScratch.tmp, out, 44)
                out = Add(out, 1)
            }
        }
        SetByte(OpScratch.tmp, out, 0)
        ReturnValue(OpScratch.tmp)
    }
}

Function.Op_Index {
    Input: args: Address
    Input: err_buf: Address
    Output: Address
    Body: {
        path = JSON.GetString(args, "path")
        IfCondition EqualTo(path, 0) ThenBlock: {
            MemoryCopy(err_buf, "missing 'path' for op=index", 27)
            SetByte(err_buf, 27, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(FS_Exists(path), 0) ThenBlock: {
            n = StringLength(path)
            IfCondition GreaterThan(n, 200) ThenBlock: { n = 200 }
            MemoryCopy(err_buf, "path does not exist: ", 21)
            MemoryCopy(Add(err_buf, 21), path, n)
            SetByte(err_buf, Add(21, n), 0)
            ReturnValue(0)
        }
        blocked = 0
        IfCondition EqualTo(StringCompare(path, "/"), 0)         ThenBlock: { blocked = 1 }
        IfCondition EqualTo(StringCompare(path, "/mnt"), 0)      ThenBlock: { blocked = 1 }
        IfCondition EqualTo(StringCompare(path, "/home"), 0)     ThenBlock: { blocked = 1 }
        IfCondition EqualTo(StringStartsWith(path, "/mnt/c"), 1) ThenBlock: { blocked = 1 }
        IfCondition EqualTo(blocked, 1) ThenBlock: {
            n = StringLength(path)
            IfCondition GreaterThan(n, 200) ThenBlock: { n = 200 }
            MemoryCopy(err_buf, "op=index refused: path would cause unbounded walk: ", 50)
            MemoryCopy(Add(err_buf, 50), path, n)
            SetByte(err_buf, Add(50, n), 0)
            ReturnValue(0)
        }
        Buf_Reset()
        path_dup = Str_Dup(path)
        user_exts = JSON.GetString(args, "exts")
        ext_csv = Str_Dup(Index_BuildExtCSV(user_exts))
        Walker_Walk(path_dup, 0, ext_csv)
        bn = Path_Basename(path_dup)
        Buf_AppendChar(91)
        Buf_AppendStr(bn)
        Buf_AppendStr("] ")
        Buf_AppendInt(Walker.n_new)
        Buf_AppendStr(" new, ")
        Buf_AppendInt(Walker.n_updated)
        Buf_AppendStr(" updated, ")
        Buf_AppendInt(Walker.n_skipped)
        Buf_AppendStr(" unchanged, ")
        Buf_AppendInt(Walker.n_failed)
        Buf_AppendStr(" failed\n")
        ReturnValue(Buf_Content())
    }
}

Function.Op_Forget {
    Input: args: Address
    Input: err_buf: Address
    Output: Address
    Body: {
        path = JSON.GetString(args, "path")
        IfCondition EqualTo(path, 0) ThenBlock: {
            MemoryCopy(err_buf, "missing 'path' for op=forget", 28)
            SetByte(err_buf, 28, 0)
            ReturnValue(0)
        }
        Buf_Reset()
        proj_str = NumberToString(CCRelState.project_id)
        esc_path = Rel_EscStr(path)
        // Remove edges + symbols first (FK: hc_symbols -> hc_files).
        sql = StringConcat("DELETE FROM hc_symbol_edges WHERE file_id IN (SELECT id FROM hc_files WHERE project_id=", proj_str)
        sql = StringConcat(sql, " AND (path='")
        sql = StringConcat(sql, esc_path)
        sql = StringConcat(sql, "' OR rel_path='")
        sql = StringConcat(sql, esc_path)
        sql = StringConcat(sql, "' OR path LIKE '%")
        sql = StringConcat(sql, esc_path)
        sql = StringConcat(sql, "'))")
        PG_Query(CCRelState.conn, sql)
        sql = StringConcat("DELETE FROM hc_symbols WHERE file_id IN (SELECT id FROM hc_files WHERE project_id=", proj_str)
        sql = StringConcat(sql, " AND (path='")
        sql = StringConcat(sql, esc_path)
        sql = StringConcat(sql, "' OR rel_path='")
        sql = StringConcat(sql, esc_path)
        sql = StringConcat(sql, "' OR path LIKE '%")
        sql = StringConcat(sql, esc_path)
        sql = StringConcat(sql, "'))")
        PG_Query(CCRelState.conn, sql)
        sql = StringConcat("DELETE FROM hc_files WHERE project_id=", proj_str)
        sql = StringConcat(sql, " AND (path='")
        sql = StringConcat(sql, esc_path)
        sql = StringConcat(sql, "' OR rel_path='")
        sql = StringConcat(sql, esc_path)
        sql = StringConcat(sql, "' OR path LIKE '%")
        sql = StringConcat(sql, esc_path)
        sql = StringConcat(sql, "')")
        PG_Query(CCRelState.conn, sql)
        Buf_AppendStr("forgot ")
        Buf_AppendStr(path)
        Buf_AppendNL()
        ReturnValue(Buf_Content())
    }
}

Function.Op_Drop {
    Input: args: Address
    Input: err_buf: Address
    Output: Address
    Body: {
        Buf_Reset()
        Rel_DropProject()
        Buf_AppendStr("dropped all indexed files for project\n")
        ReturnValue(Buf_Content())
    }
}


// =============================================================================
// IPC ENVELOPE
// =============================================================================
Function.CCRelmem_SendError {
    Input: client_fd: Integer
    Input: id: Address
    Input: error_msg: Address
    Body: {
        resp = JSON.NewObject()
        JSON.SetString(resp, "method", "result")
        IfCondition NotEqual(id, 0) ThenBlock: { JSON.SetString(resp, "id", id) }
        JSON.SetBool(resp, "ok", 0)
        JSON.SetString(resp, "error", error_msg)
        Socket.SendMsg(client_fd, JSON.SerializeObject(resp))
    }
}

Function.CCRelmem_SendResult {
    Input: client_fd: Integer
    Input: id: Address
    Input: content: Address
    Body: {
        // Cap content at MAX_OUTPUT so the IPC message stays within the socket
        // sanity limit regardless of how large the index response grows.
        IfCondition NotEqual(content, 0) ThenBlock: {
            clen = StringLength(content)
            IfCondition GreaterThan(clen, CCRelConst.MAX_OUTPUT) ThenBlock: {
                SetByte(content, CCRelConst.MAX_OUTPUT, 0)
            }
        }
        resp = JSON.NewObject()
        JSON.SetString(resp, "method", "result")
        IfCondition NotEqual(id, 0) ThenBlock: { JSON.SetString(resp, "id", id) }
        JSON.SetBool(resp, "ok", 1)
        IfCondition NotEqual(content, 0) ThenBlock: { JSON.SetString(resp, "content", content) }
        Socket.SendMsg(client_fd, JSON.SerializeObject(resp))
    }
}

Function.CCRelmem_SendSchema {
    Input: client_fd: Integer
    Body: {
        schema_str = UtilArgs_ExportToolSchema(CCRelState.schema)
        parsed = ParseJSON(schema_str)
        schema_obj = JSON.AsObject(parsed)
        resp = JSON.NewObject()
        JSON.SetString(resp, "method", "schema_response")
        IfCondition NotEqual(schema_obj, 0) ThenBlock: { JSON.SetObject(resp, "schema", schema_obj) }
        Socket.SendMsg(client_fd, JSON.SerializeObject(resp))
    }
}

// Dispatch on `op` field of `args`. Returns content string or 0+err_buf.
Function.CCRelmem_Dispatch {
    Input: args: Address
    Input: err_buf: Address
    Output: Address
    Body: {
        op = JSON.GetString(args, "op")
        IfCondition EqualTo(op, 0) ThenBlock: {
            MemoryCopy(err_buf, "missing required arg: op", 25)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(op, "status"), 0) ThenBlock: { ReturnValue(Op_Status(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "summary"), 0) ThenBlock: { ReturnValue(Op_Summary(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "query"), 0) ThenBlock: { ReturnValue(Op_Query(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "where"), 0) ThenBlock: { ReturnValue(Op_Where(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "symbols"), 0) ThenBlock: { ReturnValue(Op_Symbols(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "focus"), 0) ThenBlock: { ReturnValue(Op_Focus(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "callers"), 0) ThenBlock: { ReturnValue(Op_Callers(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "calls"), 0) ThenBlock: { ReturnValue(Op_Calls(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "graph"), 0) ThenBlock: { ReturnValue(Op_Graph(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "imports"), 0) ThenBlock: { ReturnValue(Op_Imports(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "dependents"), 0) ThenBlock: { ReturnValue(Op_Dependents(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "index"), 0) ThenBlock: { ReturnValue(Op_Index(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "forget"), 0) ThenBlock: { ReturnValue(Op_Forget(args, err_buf)) }
        IfCondition EqualTo(StringCompare(op, "drop"), 0) ThenBlock: { ReturnValue(Op_Drop(args, err_buf)) }

        msg = StringConcat("unknown op: ", op)
        n = StringLength(msg)
        IfCondition GreaterThan(n, 250) ThenBlock: { n = 250 }
        MemoryCopy(err_buf, msg, n)
        SetByte(err_buf, n, 0)
        Deallocate(msg, Add(StringLength(msg), 1))
        ReturnValue(0)
    }
}

Function.CCRelmem_HandleRequest {
    Input: client_fd: Integer
    Input: req_str: Address
    Body: {
        parsed = ParseJSON(req_str)
        IfCondition EqualTo(parsed, 0) ThenBlock: {
            CCRelmem_SendError(client_fd, 0, "invalid JSON")  ReturnValue(0)
        }
        obj = JSON.AsObject(parsed)
        IfCondition EqualTo(obj, 0) ThenBlock: {
            CCRelmem_SendError(client_fd, 0, "request must be a JSON object")  ReturnValue(0)
        }
        method = JSON.GetString(obj, "method")
        IfCondition EqualTo(method, 0) ThenBlock: {
            CCRelmem_SendError(client_fd, 0, "missing method")  ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(method, "schema"), 0) ThenBlock: {
            CCRelmem_SendSchema(client_fd)  ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(method, "call"), 0) ThenBlock: {
            id = JSON.GetString(obj, "id")
            args = JSON.GetObject(obj, "args")
            validated = UtilArgs_ParseIPC(CCRelState.schema, args)
            IfCondition EqualTo(validated, 0) ThenBlock: {
                CCRelmem_SendError(client_fd, id, "missing required argument 'op'")  ReturnValue(0)
            }
            err_buf = Allocate(256)
            SetByte(err_buf, 0, 0)
            content = CCRelmem_Dispatch(validated, err_buf)
            IfCondition EqualTo(content, 0) ThenBlock: {
                CCRelmem_SendError(client_fd, id, err_buf)
            } ElseBlock: {
                CCRelmem_SendResult(client_fd, id, content)
                // content is the RespBuf mailbox — DO NOT deallocate.
            }
            Deallocate(err_buf, 256)
            ReturnValue(0)
        }
        CCRelmem_SendError(client_fd, 0, "unknown method")
    }
}


// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    CCRelConst.SOCK_DIR  = "/tmp/ailang_cctools"
    // FS_Exists stats into this buffer. Allocate it before Ctags_FindBinary,
    // or stat(path, NULL) fails and ctags is reported as not installed.
    CCRelState.stat_buf = Allocate(CCRelConst.STATBUF_SIZE)
    Ctags_FindBinary()
    CCRelConst.SOCK_PATH = "@halcode/Relmem"
    CCRelState.schema = CCRelmem_BuildSchema()

    // Allocate path scratch mailboxes once; Path_* helpers reuse them.
    PathScratch.buf_a = Allocate(PathScratch.cap)
    PathScratch.buf_b = Allocate(PathScratch.cap)
    PathScratch.buf_c = Allocate(PathScratch.cap)
    SetByte(PathScratch.buf_a, 0, 0)
    SetByte(PathScratch.buf_b, 0, 0)
    SetByte(PathScratch.buf_c, 0, 0)

    // Response content mailbox — single buffer, reused per request.
    RespBuf.buf = Allocate(RespBuf.cap)
    RespBuf.len = 0
    SetByte(RespBuf.buf, 0, 0)

    OpScratch.needle = Allocate(OpScratch.cap)
    OpScratch.tok_lc = Allocate(OpScratch.cap)
    OpScratch.tmp    = Allocate(OpScratch.cap)
    SetByte(OpScratch.needle, 0, 0)
    SetByte(OpScratch.tok_lc, 0, 0)
    SetByte(OpScratch.tmp, 0, 0)

    Walker.path      = Allocate(CCRelConst.PATH_MAX)
    Walker.join_buf  = Allocate(CCRelConst.PATH_MAX)
    Walker.dent_slab = Allocate(Multiply(CCRelConst.WALK_MAX_DEPTH, CCRelConst.DENTS_BUF))
    Walker.depth     = 0
    SetByte(Walker.path, 0, 0)
    SetByte(Walker.join_buf, 0, 0)

    // Pre-allocate "h1".."h6" strings — 6 slots × 3 bytes each.
    HeadingCats.slab = Allocate(18)
    _hci = 0
    WhileLoop LessThan(_hci, 6) {
        _hs = Add(HeadingCats.slab, Multiply(_hci, 3))
        SetByte(_hs, 0, 104)
        SetByte(_hs, 1, Add(49, _hci))
        SetByte(_hs, 2, 0)
        _hci = Add(_hci, 1)
    }

    Builtins_Init()

    // Allocate SQL escape buffer
    CCRelState.esc_buf = Allocate(CCRelConst.ESC_BUF)

    // Connect to postgres — read $USER from env, no hardcoded names
    _pg_user = Env_LoadVar("USER")
    IfCondition EqualTo(_pg_user, 0) ThenBlock: { _pg_user = "nobody" }
    conn = PG_ConnectUnix("/var/run/postgresql", 5432, "ailang_system", _pg_user, "")
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[cc_relmem_ipc] ERROR: postgres connect failed\n")
        SystemCall(CCRelSys.SYS_EXIT, 1)
    }
    CCRelState.conn = conn
    Rel_Migrate()
    CCRelState.project_id = Rel_GetOrCreateProject("HalCode9000")
    IfCondition EqualTo(CCRelState.project_id, 0) ThenBlock: {
        PrintMessage("[cc_relmem_ipc] ERROR: could not get/create project in postgres\n")
        SystemCall(CCRelSys.SYS_EXIT, 1)
    }
    PrintMessage("[cc_relmem_ipc] postgres connected, project_id=")
    PrintNumber(CCRelState.project_id)
    PrintMessage("\n")

    SystemCall(CCRelSys.SYS_MKDIR, CCRelConst.SOCK_DIR, 493, 0, 0, 0)
    SystemCall(CCRelSys.SYS_UNLINK, CCRelConst.SOCK_PATH, 0, 0, 0, 0)

    fd = Socket.Create(1, 1)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("[cc_relmem_ipc] socket() failed\n")
        SystemCall(CCRelSys.SYS_EXIT, 1)
    }
    Socket.BindUnix(fd, CCRelConst.SOCK_PATH)
    Socket.Listen(fd, CCRelConst.BACKLOG)
    CCRelState.listen_fd = fd

    // Set SO_RCVTIMEO on listen socket so Accept() returns -1 every 10s.
    // Lets us check idle time and exit when no requests for 30s.
    tv_buf = Allocate(16)
    StoreValue(tv_buf, 10)               // tv_sec = 10
    StoreValue(Add(tv_buf, 8), 0)        // tv_usec = 0
    SystemCall(54, fd, 1, 20, tv_buf, 16)  // setsockopt(SOL_SOCKET=1, SO_RCVTIMEO=20)

    PrintMessage("[cc_relmem_ipc] listening on ")
    PrintMessage(CCRelConst.SOCK_PATH)
    PrintMessage("\n")

    last_served = SystemCall(201, 0, 0, 0, 0, 0)

    WhileLoop EqualTo(CCRelState.running, 1) {
        client_fd = Socket.Accept(CCRelState.listen_fd)
        IfCondition GreaterEqual(client_fd, 0) ThenBlock: {
            done = 0
            pfd  = Allocate(16)
            WhileLoop EqualTo(done, 0) {
                StoreValue(pfd, client_fd, "dword")
                SetByte(pfd, 4, 1)
                SetByte(pfd, 5, 0)
                SetByte(pfd, 6, 0)
                SetByte(pfd, 7, 0)
                StoreValue(Add(pfd, 8), CCRelState.listen_fd, "dword")
                SetByte(pfd, 12, 1)
                SetByte(pfd, 13, 0)
                SetByte(pfd, 14, 0)
                SetByte(pfd, 15, 0)

                SystemCall(CCRelSys.SYS_POLL, pfd, 2, -1, 0, 0)

                rev_client = GetByte(pfd, 6)
                rev_listen = GetByte(pfd, 14)

                IfCondition NotEqual(rev_listen, 0) ThenBlock: {
                    new_fd = Socket.Accept(CCRelState.listen_fd)
                    IfCondition GreaterEqual(new_fd, 0) ThenBlock: {
                        Socket.SetRecvTimeout(new_fd, 10000)
                        mcp_req = Socket.RecvMsg(new_fd)
                        IfCondition NotEqual(mcp_req, 0) ThenBlock: {
                            IfCondition NotEqual(mcp_req, -1) ThenBlock: {
                                CCRelmem_HandleRequest(new_fd, mcp_req)
                            }
                        }
                        Socket.Close(new_fd)
                    }
                }

                IfCondition NotEqual(rev_client, 0) ThenBlock: {
                    req = Socket.RecvMsg(client_fd)
                    IfCondition EqualTo(req, 0) ThenBlock: { done = 1 }
                    IfCondition NotEqual(req, 0) ThenBlock: {
                        IfCondition NotEqual(req, -1) ThenBlock: {
                            CCRelmem_HandleRequest(client_fd, req)
                        }
                    }
                }
            }
            Socket.Close(client_fd)
            last_served = SystemCall(201, 0, 0, 0, 0, 0)
        } ElseBlock: {
            now = SystemCall(201, 0, 0, 0, 0, 0)
            IfCondition GreaterEqual(Subtract(now, last_served), 30) ThenBlock: {
                CCRelState.running = 0
            }
        }
    }
    SystemCall(CCRelSys.SYS_EXIT, 0)
}

RunTask(Main)
