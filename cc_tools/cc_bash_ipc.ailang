// cc_bash_ipc.ailang — Claude Code Bash tool, IPC service.
//
// Runs a shell command via /bin/sh -c, captures combined stdout+stderr,
// returns exit code + output. The model's universal escape hatch — when
// nothing else fits, Bash does.
//
// Schema: command (required string), timeout_secs (int, 0 = 30s default, max 55).
// Output format:
//   exit=<N>
//   <combined output>
//
// stderr is merged via the shell's `2>&1` so we only need one pipe.
// timeout_secs is a wall-clock deadline. 0 uses DEFAULT_TIMEOUT (30s).
// On expiry the shell's process group is SIGKILL'd and the exit code is 137.
//
// Build: ./ailang.x Applications/ClaudeCode/cc_tools/cc_bash_ipc.ailang cc_bash_ipc.x
// Run:   ./cc_bash_ipc.x   (binds /tmp/ailang_cctools/Bash.sock)
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. MIT.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.JSON
LibraryImport.StringUtils
LibraryImport.UtilArgs

FixedPool.CCBashSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_LSEEK":     Initialize=8
    "SYS_POLL":      Initialize=7
    "SYS_PIPE":      Initialize=22
    "SYS_DUP2":      Initialize=33
    "SYS_FORK":      Initialize=57
    "SYS_EXECVE":    Initialize=59
    "SYS_EXIT":      Initialize=60
    "SYS_WAIT4":     Initialize=61
    "SYS_KILL":      Initialize=62
    "SYS_SETPGID":   Initialize=109
    "SYS_MKDIR":     Initialize=83
    "SYS_UNLINK":    Initialize=87
    "SYS_TIME":      Initialize=201
    "POLLIN":        Initialize=1
    "O_RDONLY":      Initialize=0
    "O_RDWR":        Initialize=2
    "O_CREAT":       Initialize=64
    "O_TRUNC":       Initialize=512
    "SIGKILL":       Initialize=9
    "WNOHANG":       Initialize=1
    "DEFAULT_TIMEOUT": Initialize=30
}

FixedPool.CCBashConst {
    "SOCK_PATH":     Initialize=0, CanChange=True
    "SOCK_DIR":      Initialize=0, CanChange=True
    "MAX_OUTPUT":    Initialize=50000
    "READ_CHUNK":    Initialize=4096
    "BACKLOG":       Initialize=8
}

FixedPool.CCBashState {
    "schema":        Initialize=0, CanChange=True
    "listen_fd":     Initialize=-1, CanChange=True
    "running":       Initialize=1, CanChange=True
}

Function.CCBash_BuildSchema {
    Output: Address
    Body: {
        s = UtilArgs_NewSchema("Bash", "Run a shell command via /bin/sh. stdout comes first. stderr, when any, follows a [stderr] line. Redirects are not on the Undo stack.")
        UtilArgs_AddField(s, "command", "string", 1, "Shell command to execute (interpreted by /bin/sh -c)", "command")
        UtilArgs_AddField(s, "timeout_secs", "int", 0, "Wall-clock timeout in seconds (0 = 30s default, max 55)", "timeout_secs")
        UtilArgs_SetDefault(s, "timeout_secs", "0")
        ReturnValue(s)
    }
}

// Read /proc/self/environ and build a char** envp array for execve.
// Returns the pointer array (caller frees with Deallocate(envp, 8200)) and
// stores the raw env data buffer in *env_data_out (caller frees 65536).
// Returns 0 on failure — caller should still pass 0 to execve rather than crash.
Function.CCBash_GetEnvp {
    Input:  env_data_out: Address
    Output: Address
    Body: {
        StoreValue(env_data_out, 0)
        fd = SystemCall(CCBashSys.SYS_OPEN, "/proc/self/environ", CCBashSys.O_RDONLY, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }

        env_max  = 65536
        env_data = Allocate(env_max)
        n = SystemCall(CCBashSys.SYS_READ, fd, env_data, env_max, 0, 0)
        SystemCall(CCBashSys.SYS_CLOSE, fd, 0, 0, 0, 0)

        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(env_data, env_max)
            ReturnValue(0)
        }

        // Walk null-separated entries; build char** pointer array (max 1025 entries).
        envp_max = 8200
        envp     = Allocate(envp_max)
        pos = 0
        idx = 0
        WhileLoop LessThan(pos, n) {
            start      = pos
            end_found  = 0
            WhileLoop LessThan(pos, n) {
                IfCondition EqualTo(GetByte(env_data, pos), 0) ThenBlock: {
                    end_found = 1
                    pos = Add(pos, 1)
                    BreakLoop
                }
                pos = Add(pos, 1)
            }
            IfCondition EqualTo(end_found, 1) ThenBlock: {
                StoreValue(Add(envp, Multiply(idx, 8)), Add(env_data, start))
                idx = Add(idx, 1)
            }
        }
        StoreValue(Add(envp, Multiply(idx, 8)), 0)

        StoreValue(env_data_out, env_data)
        ReturnValue(envp)
    }
}

// Fork+exec /bin/sh -c "<cmd>" with stdout+stderr -> pipe.
// timeout_secs: wall-clock limit; 0 means use DEFAULT_TIMEOUT (30s).
// Returns allocated string "exit=N\n<output>" on success, 0 on internal failure.
Function.CCBash_Run {
    Input: cmd:              Address
    Input: timeout_secs:     Integer
    Input: out_truncated_ptr: Address
    Output: Address
    Body: {
        StoreValue(out_truncated_ptr, 0, "dword")
        IfCondition EqualTo(cmd, 0) ThenBlock: { ReturnValue(0) }

        // Clamp timeout: 0 → default, cap at 55s so IPCDispatch's 60s fence always wins.
        effective_timeout = timeout_secs
        IfCondition LessEqual(effective_timeout, 0) ThenBlock: {
            effective_timeout = CCBashSys.DEFAULT_TIMEOUT
        }
        IfCondition GreaterThan(effective_timeout, 55) ThenBlock: {
            effective_timeout = 55
        }
        deadline = Add(SystemCall(CCBashSys.SYS_TIME, 0, 0, 0, 0, 0), effective_timeout)

        // Build argv: ["/bin/sh", "-c", cmd, NULL]
        argv = Allocate(32)
        StoreValue(Add(argv, 0),  "/bin/sh")
        StoreValue(Add(argv, 8),  "-c")
        StoreValue(Add(argv, 16), cmd)
        StoreValue(Add(argv, 24), 0)

        // Capture current environment for the child.
        env_data_holder = Allocate(8)
        StoreValue(env_data_holder, 0)
        envp     = CCBash_GetEnvp(env_data_holder)
        env_data = Dereference(env_data_holder)
        Deallocate(env_data_holder, 8)

        pf = Allocate(8)
        pr = SystemCall(CCBashSys.SYS_PIPE, pf, 0, 0, 0, 0)
        IfCondition LessThan(pr, 0) ThenBlock: {
            Deallocate(pf, 8)
            Deallocate(argv, 32)
            IfCondition NotEqual(envp,     0) ThenBlock: { Deallocate(envp,     8200) }
            IfCondition NotEqual(env_data, 0) ThenBlock: { Deallocate(env_data, 65536) }
            ReturnValue(0)
        }
        pipe_r = Dereference(pf, "dword")
        pipe_w = Dereference(Add(pf, 4), "dword")
        Deallocate(pf, 8)

        // stderr goes to its own file so a warning is not mixed into stdout.
        err_flags = BitwiseOr(CCBashSys.O_RDWR, BitwiseOr(CCBashSys.O_CREAT, CCBashSys.O_TRUNC))
        err_fd = SystemCall(CCBashSys.SYS_OPEN, "/tmp/halcode_app/bash.err", err_flags, 420, 0, 0)

        // Heap slot so a later syscall cannot clobber the child pid.
        pid_box = Allocate(8)
        StoreValue(pid_box, 0)
        pid = SystemCall(CCBashSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            Deallocate(pid_box, 8)
            SystemCall(CCBashSys.SYS_CLOSE, pipe_r, 0, 0, 0, 0)
            SystemCall(CCBashSys.SYS_CLOSE, pipe_w, 0, 0, 0, 0)
            IfCondition GreaterEqual(err_fd, 0) ThenBlock: {
                SystemCall(CCBashSys.SYS_CLOSE, err_fd, 0, 0, 0, 0)
            }
            Deallocate(argv, 32)
            IfCondition NotEqual(envp,     0) ThenBlock: { Deallocate(envp,     8200) }
            IfCondition NotEqual(env_data, 0) ThenBlock: { Deallocate(env_data, 65536) }
            ReturnValue(0)
        }

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // Own group so the timeout kill reaches sleep and anything else
            // the shell forks. Never the tool's group, never the host's.
            SystemCall(CCBashSys.SYS_SETPGID, 0, 0, 0, 0, 0)
            SystemCall(CCBashSys.SYS_CLOSE, pipe_r, 0, 0, 0, 0)
            SystemCall(CCBashSys.SYS_DUP2,  pipe_w, 1, 0, 0, 0)
            IfCondition GreaterEqual(err_fd, 0) ThenBlock: {
                SystemCall(CCBashSys.SYS_DUP2, err_fd, 2, 0, 0, 0)
                SystemCall(CCBashSys.SYS_CLOSE, err_fd, 0, 0, 0, 0)
            } ElseBlock: {
                SystemCall(CCBashSys.SYS_DUP2, pipe_w, 2, 0, 0, 0)
            }
            SystemCall(CCBashSys.SYS_CLOSE, pipe_w, 0, 0, 0, 0)
            SystemCall(CCBashSys.SYS_EXECVE, "/bin/sh", argv, envp)
            SystemCall(CCBashSys.SYS_EXIT, 127, 0, 0, 0, 0)
        }
        StoreValue(pid_box, pid)
        SystemCall(CCBashSys.SYS_SETPGID, pid, pid, 0, 0, 0)

        // Parent: close write end.
        SystemCall(CCBashSys.SYS_CLOSE, pipe_w, 0, 0, 0, 0)
        Deallocate(argv, 32)
        IfCondition NotEqual(envp,     0) ThenBlock: { Deallocate(envp,     8200) }
        IfCondition NotEqual(env_data, 0) ThenBlock: { Deallocate(env_data, 65536) }

        // Drain stdout+stderr via poll so we honor the deadline.
        // pollfd: fd(4) events(2) revents(2) = 8 bytes.
        pfd   = Allocate(8)
        out   = Allocate(Add(CCBashConst.MAX_OUTPUT, 64))
        body_off = 32
        used  = 0
        chunk = Allocate(CCBashConst.READ_CHUNK)
        timed_out = 0

        WhileLoop 1 {
            // Deadline check first.
            now = SystemCall(CCBashSys.SYS_TIME, 0, 0, 0, 0, 0)
            IfCondition GreaterEqual(now, deadline) ThenBlock: {
                timed_out = 1
                BreakLoop
            }

            free_room = Subtract(CCBashConst.MAX_OUTPUT, used)
            IfCondition LessEqual(free_room, 0) ThenBlock: {
                StoreValue(out_truncated_ptr, 1, "dword")
                // Drain remaining within remaining time so child doesn't block on write.
                WhileLoop 1 {
                    now2 = SystemCall(CCBashSys.SYS_TIME, 0, 0, 0, 0, 0)
                    IfCondition GreaterEqual(now2, deadline) ThenBlock: {
                        timed_out = 1
                        BreakLoop
                    }
                    remain_ms3 = Multiply(Subtract(deadline, now2), 1000)
                    IfCondition GreaterThan(remain_ms3, 1000) ThenBlock: { remain_ms3 = 1000 }
                    StoreValue(pfd, pipe_r, "dword")
                    SetByte(pfd, 4, CCBashSys.POLLIN)
                    SetByte(pfd, 5, 0)
                    SetByte(pfd, 6, 0)
                    SetByte(pfd, 7, 0)
                    pr3 = SystemCall(CCBashSys.SYS_POLL, pfd, 1, remain_ms3, 0, 0)
                    IfCondition LessEqual(pr3, 0) ThenBlock: { BreakLoop }
                    dn = SystemCall(CCBashSys.SYS_READ, pipe_r, chunk, CCBashConst.READ_CHUNK, 0, 0)
                    IfCondition LessEqual(dn, 0) ThenBlock: { BreakLoop }
                }
                BreakLoop
            }

            // Poll with up to 1s slices so deadline is checked each iteration.
            remain_ms = Multiply(Subtract(deadline, now), 1000)
            IfCondition GreaterThan(remain_ms, 1000) ThenBlock: { remain_ms = 1000 }
            StoreValue(pfd, pipe_r, "dword")
            SetByte(pfd, 4, CCBashSys.POLLIN)
            SetByte(pfd, 5, 0)
            SetByte(pfd, 6, 0)
            SetByte(pfd, 7, 0)
            poll_r = SystemCall(CCBashSys.SYS_POLL, pfd, 1, remain_ms, 0, 0)

            IfCondition EqualTo(poll_r, 0) ThenBlock: {
                // Poll slice expired, loop back to check deadline.
            }
            IfCondition LessThan(poll_r, 0) ThenBlock: { BreakLoop }
            IfCondition GreaterThan(poll_r, 0) ThenBlock: {
                want = CCBashConst.READ_CHUNK
                IfCondition GreaterThan(want, free_room) ThenBlock: { want = free_room }
                n = SystemCall(CCBashSys.SYS_READ, pipe_r, chunk, want, 0, 0)
                IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }
                i = 0
                WhileLoop LessThan(i, n) {
                    SetByte(out, Add(body_off, Add(used, i)), GetByte(chunk, i))
                    i = Add(i, 1)
                }
                used = Add(used, n)
            }
        }

        Deallocate(pfd, 8)
        Deallocate(chunk, CCBashConst.READ_CHUNK)
        SystemCall(CCBashSys.SYS_CLOSE, pipe_r, 0, 0, 0, 0)

        // Kill the shell group if we hit the deadline. pid <= 1 is never a
        // child (0 is this process's group, 1 is init, negative is a group).
        IfCondition EqualTo(timed_out, 1) ThenBlock: {
            live = Dereference(pid_box)
            IfCondition GreaterThan(live, 1) ThenBlock: {
                SystemCall(CCBashSys.SYS_KILL, live, CCBashSys.SIGKILL, 0, 0, 0)
                SystemCall(CCBashSys.SYS_KILL, Subtract(0, live), CCBashSys.SIGKILL, 0, 0, 0)
            }
            timeout_note = "\n[timed out]"
            tn_len = StringLength(timeout_note)
            avail = Subtract(CCBashConst.MAX_OUTPUT, used)
            IfCondition GreaterThan(tn_len, avail) ThenBlock: { tn_len = avail }
            tn = 0
            WhileLoop LessThan(tn, tn_len) {
                SetByte(out, Add(body_off, Add(used, tn)), GetByte(timeout_note, tn))
                tn = Add(tn, 1)
            }
            used = Add(used, tn_len)
        }

        // Reap child with WNOHANG + retry loop so a D-state child (e.g. find
        // stuck in WSL2 NTFS or /proc) never blocks us permanently.
        // If the child still hasn't exited after 10 x 100ms we leave it and
        // treat the exit code as 137 (SIGKILL convention).
        status_buf = Allocate(8)
        StoreValue(status_buf, 0)
        raw_status = 0
        live_pid = Dereference(pid_box)
        wi = 0
        WhileLoop LessThan(wi, 10) {
            wr = SystemCall(CCBashSys.SYS_WAIT4, live_pid, status_buf, CCBashSys.WNOHANG, 0, 0)
            IfCondition NotEqual(wr, 0) ThenBlock: {
                raw_status = Dereference(status_buf, "dword")
                wi = 10
            } ElseBlock: {
                ts = Allocate(16)
                StoreValue(ts, 0)
                StoreValue(Add(ts, 8), 100000000)
                SystemCall(35, ts, 0, 0, 0, 0)
                Deallocate(ts, 16)
                wi = Add(wi, 1)
            }
        }
        Deallocate(status_buf, 8)
        Deallocate(pid_box, 8)
        // POSIX: bits 8-15 = exit code when WIFEXITED. Low 7 bits = signal
        // when WIFSIGNALED. Report 128+signal (SIGKILL → 137), not exit 0.
        sig = BitwiseAnd(raw_status, 127)
        exit_code = BitwiseAnd(RightShift(raw_status, 8), 255)
        IfCondition And(GreaterThan(sig, 0), NotEqual(sig, 127)) ThenBlock: {
            exit_code = Add(128, sig)
        }
        IfCondition And(EqualTo(timed_out, 1), EqualTo(exit_code, 0)) ThenBlock: {
            exit_code = 137
        }

        // Build "exit=N\n" prefix in-place
        prefix_buf = Allocate(32)
        prefix_str = "exit="
        plen = StringLength(prefix_str)
        pi = 0
        WhileLoop LessThan(pi, plen) {
            SetByte(prefix_buf, pi, GetByte(prefix_str, pi))
            pi = Add(pi, 1)
        }
        // Encode exit code as decimal (0-255)
        digits = NumberToString(exit_code)
        dlen = StringLength(digits)
        di = 0
        WhileLoop LessThan(di, dlen) {
            SetByte(prefix_buf, Add(plen, di), GetByte(digits, di))
            di = Add(di, 1)
        }
        SetByte(prefix_buf, Add(plen, dlen), 10)  // newline
        prefix_total = Add(plen, Add(dlen, 1))

        // Append a tagged stderr section when the command wrote any.
        err_used = 0
        err_buf = 0
        IfCondition GreaterEqual(err_fd, 0) ThenBlock: {
            SystemCall(CCBashSys.SYS_LSEEK, err_fd, 0, 0, 0, 0)
            err_buf = Allocate(8001)
            err_used = SystemCall(CCBashSys.SYS_READ, err_fd, err_buf, 8000, 0, 0)
            IfCondition LessThan(err_used, 0) ThenBlock: { err_used = 0 }
            SetByte(err_buf, err_used, 0)
            SystemCall(CCBashSys.SYS_CLOSE, err_fd, 0, 0, 0, 0)
        }
        err_tag = "\n[stderr]\n"
        err_tag_len = 0
        IfCondition GreaterThan(err_used, 0) ThenBlock: { err_tag_len = StringLength(err_tag) }

        // Final layout: prefix + stdout body + optional [stderr] section
        final_len = Add(prefix_total, Add(used, Add(err_tag_len, err_used)))
        final = Allocate(Add(final_len, 1))
        k = 0
        WhileLoop LessThan(k, prefix_total) {
            SetByte(final, k, GetByte(prefix_buf, k))
            k = Add(k, 1)
        }
        m = 0
        WhileLoop LessThan(m, used) {
            SetByte(final, Add(prefix_total, m), GetByte(out, Add(body_off, m)))
            m = Add(m, 1)
        }
        IfCondition GreaterThan(err_used, 0) ThenBlock: {
            et = 0
            WhileLoop LessThan(et, err_tag_len) {
                SetByte(final, Add(Add(prefix_total, used), et), GetByte(err_tag, et))
                et = Add(et, 1)
            }
            eb = 0
            WhileLoop LessThan(eb, err_used) {
                SetByte(final, Add(Add(Add(prefix_total, used), err_tag_len), eb), GetByte(err_buf, eb))
                eb = Add(eb, 1)
            }
            Deallocate(err_buf, 8001)
        }
        SetByte(final, final_len, 0)
        Deallocate(prefix_buf, 32)
        Deallocate(out, Add(CCBashConst.MAX_OUTPUT, 64))
        ReturnValue(final)
    }
}

// Returns 1 if c is the first byte after "find /" and identifies a dangerous root:
// end/space/tab = bare "/", 'm'=/mnt, 'p'=/proc, 's'=/sys
Function.CCBash_IsDangerousRoot {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(c,   0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c,  32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c,   9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 109) ThenBlock: { ReturnValue(1) }  // 'm' /mnt
        IfCondition EqualTo(c, 112) ThenBlock: { ReturnValue(1) }  // 'p' /proc
        IfCondition EqualTo(c, 115) ThenBlock: { ReturnValue(1) }  // 's' /sys
        ReturnValue(0)
    }
}

// Returns 1 if cmd contains "find " or "find\t" followed by a dangerous root.
// Allows find /home, /tmp, /var, etc. Only blocks /, /mnt, /proc, /sys.
Function.CCBash_IsDangerousFind {
    Input: cmd: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(cmd, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(cmd)
        IfCondition LessThan(len, 6) ThenBlock: { ReturnValue(0) }
        i = 0
        limit = Subtract(len, 5)
        WhileLoop LessEqual(i, limit) {
            IfCondition EqualTo(GetByte(cmd, i), 102) ThenBlock: {
                IfCondition EqualTo(GetByte(cmd, Add(i, 1)), 105) ThenBlock: {
                    IfCondition EqualTo(GetByte(cmd, Add(i, 2)), 110) ThenBlock: {
                        IfCondition EqualTo(GetByte(cmd, Add(i, 3)), 100) ThenBlock: {
                            sep   = GetByte(cmd, Add(i, 4))
                            slash = GetByte(cmd, Add(i, 5))
                            IfCondition EqualTo(slash, 47) ThenBlock: {
                                c6    = 0
                                c6pos = Add(i, 6)
                                IfCondition LessThan(c6pos, len) ThenBlock: {
                                    c6 = GetByte(cmd, c6pos)
                                }
                                IfCondition EqualTo(sep, 32) ThenBlock: {
                                    IfCondition EqualTo(CCBash_IsDangerousRoot(c6), 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                }
                                IfCondition EqualTo(sep, 9) ThenBlock: {
                                    IfCondition EqualTo(CCBash_IsDangerousRoot(c6), 1) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Returns 1 if c (char after '/') indicates a protected system path for rm purposes.
// Covers bare root, /etc, /bin, /sbin, /usr, /lib, /proc, /sys, /dev, /boot, /root, /*.
Function.CCBash_IsRmSystemRoot {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(c,   0) ThenBlock: { ReturnValue(1) }   // bare /
        IfCondition EqualTo(c,  32) ThenBlock: { ReturnValue(1) }   // / (space)
        IfCondition EqualTo(c,   9) ThenBlock: { ReturnValue(1) }   // /\t
        IfCondition EqualTo(c,  42) ThenBlock: { ReturnValue(1) }   // /*
        IfCondition EqualTo(c, 101) ThenBlock: { ReturnValue(1) }   // /e → /etc
        IfCondition EqualTo(c,  98) ThenBlock: { ReturnValue(1) }   // /b → /bin /boot
        IfCondition EqualTo(c, 115) ThenBlock: { ReturnValue(1) }   // /s → /sys /sbin
        IfCondition EqualTo(c, 117) ThenBlock: { ReturnValue(1) }   // /u → /usr
        IfCondition EqualTo(c, 108) ThenBlock: { ReturnValue(1) }   // /l → /lib /lib64
        IfCondition EqualTo(c, 112) ThenBlock: { ReturnValue(1) }   // /p → /proc
        IfCondition EqualTo(c, 100) ThenBlock: { ReturnValue(1) }   // /d → /dev
        IfCondition EqualTo(c, 114) ThenBlock: { ReturnValue(1) }   // /r → /root
        IfCondition EqualTo(c, 109) ThenBlock: { ReturnValue(1) }   // /m → /mnt
        ReturnValue(0)
    }
}

// Returns 1 if cmd contains "rm " followed (eventually) by a system path like / /etc /bin etc.
// Scans for "rm " then looks for space-prefixed "/" tokens within the rest of the command.
// Returns 1 if cmd contains "rm" as a command word (word-boundary aware).
// Matches: rm, rm -rf, ls && rm, ; rm, etc.
// Does NOT match: grep -rm, chmod +r, trim, etc.
Function.CCBash_ContainsRm {
    Input: cmd: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(cmd, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(cmd)
        IfCondition LessThan(len, 2) ThenBlock: { ReturnValue(0) }
        i = 0
        limit = Subtract(len, 2)
        WhileLoop LessEqual(i, limit) {
            IfCondition EqualTo(GetByte(cmd, i), 114) ThenBlock: {           // 'r'
                IfCondition EqualTo(GetByte(cmd, Add(i, 1)), 109) ThenBlock: { // 'm'
                    before_ok = 0
                    IfCondition EqualTo(i, 0) ThenBlock: { before_ok = 1 }
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        bp = GetByte(cmd, Subtract(i, 1))
                        IfCondition EqualTo(bp, 32)  ThenBlock: { before_ok = 1 }  // space
                        IfCondition EqualTo(bp, 9)   ThenBlock: { before_ok = 1 }  // tab
                        IfCondition EqualTo(bp, 10)  ThenBlock: { before_ok = 1 }  // newline
                        IfCondition EqualTo(bp, 59)  ThenBlock: { before_ok = 1 }  // ;
                        IfCondition EqualTo(bp, 124) ThenBlock: { before_ok = 1 }  // |
                        IfCondition EqualTo(bp, 38)  ThenBlock: { before_ok = 1 }  // &
                        IfCondition EqualTo(bp, 40)  ThenBlock: { before_ok = 1 }  // (
                    }
                    IfCondition EqualTo(before_ok, 1) ThenBlock: {
                        after_ok = 0
                        next_pos = Add(i, 2)
                        IfCondition GreaterEqual(next_pos, len) ThenBlock: { after_ok = 1 }
                        IfCondition LessThan(next_pos, len) ThenBlock: {
                            ap = GetByte(cmd, next_pos)
                            IfCondition EqualTo(ap, 32)  ThenBlock: { after_ok = 1 }  // space
                            IfCondition EqualTo(ap, 9)   ThenBlock: { after_ok = 1 }  // tab
                            IfCondition EqualTo(ap, 10)  ThenBlock: { after_ok = 1 }  // newline
                            IfCondition EqualTo(ap, 0)   ThenBlock: { after_ok = 1 }  // null
                        }
                        IfCondition EqualTo(after_ok, 1) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Generic word-boundary matcher: returns 1 if `word` appears in `cmd` as a
// standalone command word (preceded and followed by shell separators or boundaries).
Function.CCBash_ContainsWord {
    Input: cmd: Address
    Input: word: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(cmd, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(word, 0) ThenBlock: { ReturnValue(0) }
        cmd_len  = StringLength(cmd)
        word_len = StringLength(word)
        IfCondition EqualTo(word_len, 0)              ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(cmd_len, word_len)       ThenBlock: { ReturnValue(0) }
        i = 0
        limit = Subtract(cmd_len, word_len)
        WhileLoop LessEqual(i, limit) {
            match = 1
            k = 0
            WhileLoop LessThan(k, word_len) {
                IfCondition NotEqual(GetByte(cmd, Add(i, k)), GetByte(word, k)) ThenBlock: {
                    match = 0
                    BreakLoop
                }
                k = Add(k, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                before_ok = 0
                IfCondition EqualTo(i, 0) ThenBlock: { before_ok = 1 }
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    bp = GetByte(cmd, Subtract(i, 1))
                    IfCondition EqualTo(bp, 32)  ThenBlock: { before_ok = 1 }
                    IfCondition EqualTo(bp, 9)   ThenBlock: { before_ok = 1 }
                    IfCondition EqualTo(bp, 10)  ThenBlock: { before_ok = 1 }
                    IfCondition EqualTo(bp, 59)  ThenBlock: { before_ok = 1 }
                    IfCondition EqualTo(bp, 124) ThenBlock: { before_ok = 1 }
                    IfCondition EqualTo(bp, 38)  ThenBlock: { before_ok = 1 }
                    IfCondition EqualTo(bp, 40)  ThenBlock: { before_ok = 1 }
                }
                IfCondition EqualTo(before_ok, 1) ThenBlock: {
                    after_ok = 0
                    np = Add(i, word_len)
                    IfCondition GreaterEqual(np, cmd_len) ThenBlock: { after_ok = 1 }
                    IfCondition LessThan(np, cmd_len) ThenBlock: {
                        ap = GetByte(cmd, np)
                        IfCondition EqualTo(ap, 32)  ThenBlock: { after_ok = 1 }
                        IfCondition EqualTo(ap, 9)   ThenBlock: { after_ok = 1 }
                        IfCondition EqualTo(ap, 10)  ThenBlock: { after_ok = 1 }
                        IfCondition EqualTo(ap, 0)   ThenBlock: { after_ok = 1 }
                    }
                    IfCondition EqualTo(after_ok, 1) ThenBlock: { ReturnValue(1) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.CCBash_ContainsMv {
    Input: cmd: Address
    Output: Integer
    Body: { ReturnValue(CCBash_ContainsWord(cmd, "mv")) }
}

Function.CCBash_ContainsDd {
    Input: cmd: Address
    Output: Integer
    Body: { ReturnValue(CCBash_ContainsWord(cmd, "dd")) }
}

Function.CCBash_ContainsCrontab {
    Input: cmd: Address
    Output: Integer
    Body: { ReturnValue(CCBash_ContainsWord(cmd, "crontab")) }
}

// Returns 1 if cmd contains kill, killall, or pkill as a command word.
Function.CCBash_ContainsKillCmd {
    Input: cmd: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CCBash_ContainsWord(cmd, "kill"),    1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CCBash_ContainsWord(cmd, "killall"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CCBash_ContainsWord(cmd, "pkill"),   1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Returns 1 if cmd pipes output to sh or bash (e.g. curl url | sh).
// Skips || (logical OR). Matches: | sh, | bash, |sh, |bash.
Function.CCBash_ContainsPipeToShell {
    Input: cmd: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(cmd, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(cmd)
        i = 0
        WhileLoop LessThan(i, len) {
            IfCondition EqualTo(GetByte(cmd, i), 124) ThenBlock: {  // '|'
                is_real_pipe = 1
                IfCondition LessThan(Add(i, 1), len) ThenBlock: {
                    IfCondition EqualTo(GetByte(cmd, Add(i, 1)), 124) ThenBlock: {
                        is_real_pipe = 0  // || is logical OR, not a pipe
                    }
                }
                IfCondition EqualTo(is_real_pipe, 1) ThenBlock: {
                    j = Add(i, 1)
                    WhileLoop LessThan(j, len) {
                        b = GetByte(cmd, j)
                        IfCondition And(NotEqual(b, 32), NotEqual(b, 9)) ThenBlock: { BreakLoop }
                        j = Add(j, 1)
                    }
                    // If token is an absolute path, strip to basename first
                    IfCondition EqualTo(GetByte(cmd, j), 47) ThenBlock: {  // '/'
                        last_sl = j
                        sk = j
                        WhileLoop LessThan(sk, len) {
                            bsk = GetByte(cmd, sk)
                            IfCondition EqualTo(bsk, 0)  ThenBlock: { BreakLoop }
                            IfCondition EqualTo(bsk, 32) ThenBlock: { BreakLoop }
                            IfCondition EqualTo(bsk, 9)  ThenBlock: { BreakLoop }
                            IfCondition EqualTo(bsk, 10) ThenBlock: { BreakLoop }
                            IfCondition EqualTo(bsk, 47) ThenBlock: { last_sl = sk }
                            sk = Add(sk, 1)
                        }
                        j = Add(last_sl, 1)
                    }
                    // Check for "sh" followed by word boundary
                    IfCondition LessThan(Add(j, 1), len) ThenBlock: {
                        IfCondition EqualTo(GetByte(cmd, j), 115) ThenBlock: {           // 's'
                            IfCondition EqualTo(GetByte(cmd, Add(j, 1)), 104) ThenBlock: { // 'h'
                                ap = 0
                                IfCondition LessThan(Add(j, 2), len) ThenBlock: {
                                    ap = GetByte(cmd, Add(j, 2))
                                }
                                IfCondition EqualTo(ap, 0)  ThenBlock: { ReturnValue(1) }
                                IfCondition EqualTo(ap, 32) ThenBlock: { ReturnValue(1) }
                                IfCondition EqualTo(ap, 9)  ThenBlock: { ReturnValue(1) }
                                IfCondition EqualTo(ap, 10) ThenBlock: { ReturnValue(1) }
                            }
                        }
                    }
                    // Check for "bash" followed by word boundary
                    IfCondition LessThan(Add(j, 3), len) ThenBlock: {
                        IfCondition EqualTo(GetByte(cmd, j), 98) ThenBlock: {               // 'b'
                            IfCondition EqualTo(GetByte(cmd, Add(j, 1)), 97) ThenBlock: {   // 'a'
                                IfCondition EqualTo(GetByte(cmd, Add(j, 2)), 115) ThenBlock: { // 's'
                                    IfCondition EqualTo(GetByte(cmd, Add(j, 3)), 104) ThenBlock: { // 'h'
                                        ap2 = 0
                                        IfCondition LessThan(Add(j, 4), len) ThenBlock: {
                                            ap2 = GetByte(cmd, Add(j, 4))
                                        }
                                        IfCondition EqualTo(ap2, 0)  ThenBlock: { ReturnValue(1) }
                                        IfCondition EqualTo(ap2, 32) ThenBlock: { ReturnValue(1) }
                                        IfCondition EqualTo(ap2, 9)  ThenBlock: { ReturnValue(1) }
                                        IfCondition EqualTo(ap2, 10) ThenBlock: { ReturnValue(1) }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Returns 1 if cmd[j..] starts with lit.
Function.CCBash_StartsAt {
    Input: cmd: Address
    Input: len: Integer
    Input: j: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        n = StringLength(lit)
        IfCondition GreaterThan(Add(j, n), len) ThenBlock: { ReturnValue(0) }
        k = 0
        WhileLoop LessThan(k, n) {
            IfCondition NotEqual(GetByte(cmd, Add(j, k)), GetByte(lit, k)) ThenBlock: {
                ReturnValue(0)
            }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

// Returns 1 if cmd[j..] is exactly lit, or lit followed by a shell boundary.
Function.CCBash_MatchBounded {
    Input: cmd: Address
    Input: len: Integer
    Input: j: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(CCBash_StartsAt(cmd, len, j, lit), 0) ThenBlock: { ReturnValue(0) }
        n = StringLength(lit)
        IfCondition EqualTo(Add(j, n), len) ThenBlock: { ReturnValue(1) }
        b = GetByte(cmd, Add(j, n))
        IfCondition EqualTo(b, 32)  ThenBlock: { ReturnValue(1) }  // space
        IfCondition EqualTo(b, 9)   ThenBlock: { ReturnValue(1) }  // tab
        IfCondition EqualTo(b, 10)  ThenBlock: { ReturnValue(1) }  // newline
        IfCondition EqualTo(b, 59)  ThenBlock: { ReturnValue(1) }  // ;
        IfCondition EqualTo(b, 38)  ThenBlock: { ReturnValue(1) }  // &
        IfCondition EqualTo(b, 124) ThenBlock: { ReturnValue(1) }  // |
        IfCondition EqualTo(b, 62)  ThenBlock: { ReturnValue(1) }  // >
        ReturnValue(0)
    }
}

// /dev/null and the stdio aliases are not OS-critical writes.
// /dev/sda, /dev/mem, and the rest of /dev stay blocked.
Function.CCBash_IsAllowedDevSink {
    Input: cmd: Address
    Input: len: Integer
    Input: j: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CCBash_MatchBounded(cmd, len, j, "/dev/null"), 1)   ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CCBash_MatchBounded(cmd, len, j, "/dev/stdout"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CCBash_MatchBounded(cmd, len, j, "/dev/stderr"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CCBash_MatchBounded(cmd, len, j, "/dev/tty"), 1)    ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(CCBash_StartsAt(cmd, len, j, "/dev/fd/"), 1)        ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Returns 1 if cmd contains a shell output-redirect (> or >>) targeting a system path.
// Catches patterns like: echo x > /etc/passwd, cmd > /bin/evil
// Allows >/dev/null, 2>/dev/null, >/dev/stdout, >/dev/stderr, >/dev/tty, >/dev/fd/N.
Function.CCBash_IsRedirectToSystemPath {
    Input: cmd: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(cmd, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(cmd)
        IfCondition LessThan(len, 4) ThenBlock: { ReturnValue(0) }
        i = 0
        limit = Subtract(len, 2)
        WhileLoop LessEqual(i, limit) {
            IfCondition EqualTo(GetByte(cmd, i), 62) ThenBlock: {  // '>'
                // Skip second '>' if present (>>)
                j = Add(i, 1)
                IfCondition EqualTo(GetByte(cmd, j), 62) ThenBlock: { j = Add(j, 1) }
                // Skip spaces/tabs after >
                WhileLoop LessThan(j, len) {
                    b = GetByte(cmd, j)
                    IfCondition And(NotEqual(b, 32), NotEqual(b, 9)) ThenBlock: { BreakLoop }
                    j = Add(j, 1)
                }
                // Check if next char is '/'
                IfCondition LessThan(j, len) ThenBlock: {
                    IfCondition EqualTo(GetByte(cmd, j), 47) ThenBlock: {  // '/'
                        c_after = 0
                        IfCondition LessThan(Add(j, 1), len) ThenBlock: {
                            c_after = GetByte(cmd, Add(j, 1))
                        }
                        IfCondition EqualTo(CCBash_IsRmSystemRoot(c_after), 1) ThenBlock: {
                            allowed = 0
                            // byte 100 is 'd' — /dev may be a null sink
                            IfCondition EqualTo(c_after, 100) ThenBlock: {
                                allowed = CCBash_IsAllowedDevSink(cmd, len, j)
                            }
                            IfCondition EqualTo(allowed, 0) ThenBlock: { ReturnValue(1) }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when this machine has opted in to sudo. The flag is a file, so a desk
// without ~/.halcode/allow_sudo stays blocked. rm and the other blocks
// still run after this check, so `sudo rm` stays forbidden.
Function.CCBash_SudoAllowed {
    Output: Integer
    Body: {
        fd = SystemCall(CCBashSys.SYS_OPEN, "/proc/self/environ", CCBashSys.O_RDONLY, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(8192)
        n = SystemCall(CCBashSys.SYS_READ, fd, buf, 8191, 0, 0)
        SystemCall(CCBashSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 8192)
            ReturnValue(0)
        }
        i = 0
        home = 0
        WhileLoop LessThan(i, n) {
            is_home = 0
            IfCondition LessThan(Add(i, 4), n) ThenBlock: {
                IfCondition EqualTo(GetByte(buf, i), 72) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, Add(i, 1)), 79) ThenBlock: {
                        IfCondition EqualTo(GetByte(buf, Add(i, 2)), 77) ThenBlock: {
                            IfCondition EqualTo(GetByte(buf, Add(i, 3)), 69) ThenBlock: {
                                IfCondition EqualTo(GetByte(buf, Add(i, 4)), 61) ThenBlock: {
                                    is_home = 1
                                }
                            }
                        }
                    }
                }
            }
            entry_end = i
            WhileLoop LessThan(entry_end, n) {
                IfCondition EqualTo(GetByte(buf, entry_end), 0) ThenBlock: { BreakLoop }
                entry_end = Add(entry_end, 1)
            }
            IfCondition EqualTo(is_home, 1) ThenBlock: {
                val_start = Add(i, 5)
                val_len = Subtract(entry_end, val_start)
                IfCondition GreaterThan(val_len, 0) ThenBlock: {
                    home = Allocate(Add(val_len, 1))
                    k = 0
                    WhileLoop LessThan(k, val_len) {
                        SetByte(home, k, GetByte(buf, Add(val_start, k)))
                        k = Add(k, 1)
                    }
                    SetByte(home, val_len, 0)
                    i = n
                }
            }
            IfCondition LessThan(i, n) ThenBlock: {
                IfCondition LessThan(entry_end, n) ThenBlock: {
                    i = Add(entry_end, 1)
                }
                IfCondition EqualTo(entry_end, n) ThenBlock: {
                    i = n
                }
            }
        }
        Deallocate(buf, 8192)
        IfCondition EqualTo(home, 0) ThenBlock: { ReturnValue(0) }
        path = StringConcat(home, "/.halcode/allow_sudo")
        flag = SystemCall(CCBashSys.SYS_OPEN, path, CCBashSys.O_RDONLY, 0, 0, 0)
        IfCondition LessThan(flag, 0) ThenBlock: { ReturnValue(0) }
        SystemCall(CCBashSys.SYS_CLOSE, flag, 0, 0, 0, 0)
        ReturnValue(1)
    }
}

// Returns 1 if cmd contains the substring "sudo".
Function.CCBash_ContainsSudo {
    Input: cmd: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(cmd, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(cmd)
        IfCondition LessThan(len, 4) ThenBlock: { ReturnValue(0) }
        i = 0
        limit = Subtract(len, 4)
        WhileLoop LessEqual(i, limit) {
            IfCondition EqualTo(GetByte(cmd, i), 115) ThenBlock: {           // 's'
                IfCondition EqualTo(GetByte(cmd, Add(i, 1)), 117) ThenBlock: {   // 'u'
                    IfCondition EqualTo(GetByte(cmd, Add(i, 2)), 100) ThenBlock: {   // 'd'
                        IfCondition EqualTo(GetByte(cmd, Add(i, 3)), 111) ThenBlock: {   // 'o'
                            ReturnValue(1)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Strip ANSI/VT escape sequences in-place.
// Handles CSI (ESC [), OSC (ESC ]), and 2-char sequences (ESC x).
// Stripped content is always <= original length, so no realloc needed.
Function.CCBash_StripAnsi {
    Input: buf: Address
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        slen = StringLength(buf)
        si = 0
        di = 0
        WhileLoop LessThan(si, slen) {
            ch = GetByte(buf, si)
            IfCondition EqualTo(ch, 27) ThenBlock: {
                si = Add(si, 1)
                IfCondition LessThan(si, slen) ThenBlock: {
                    next = GetByte(buf, si)
                    si = Add(si, 1)
                    IfCondition EqualTo(next, 91) ThenBlock: {
                        // CSI (ESC [): skip until final byte in 0x40–0x7E
                        WhileLoop LessThan(si, slen) {
                            b = GetByte(buf, si)
                            si = Add(si, 1)
                            IfCondition And(GreaterEqual(b, 64), LessEqual(b, 126)) ThenBlock: {
                                BreakLoop
                            }
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(next, 93) ThenBlock: {
                            // OSC (ESC ]): skip until BEL (0x07) or ESC '\'
                            WhileLoop LessThan(si, slen) {
                                b = GetByte(buf, si)
                                si = Add(si, 1)
                                IfCondition EqualTo(b, 7) ThenBlock: { BreakLoop }
                                IfCondition EqualTo(b, 27) ThenBlock: {
                                    IfCondition LessThan(si, slen) ThenBlock: {
                                        IfCondition EqualTo(GetByte(buf, si), 92) ThenBlock: {
                                            si = Add(si, 1)
                                        }
                                    }
                                    BreakLoop
                                }
                            }
                        }
                        // Other 2-char sequences: ESC + 1 byte already consumed, done.
                    }
                }
            } ElseBlock: {
                SetByte(buf, di, ch)
                di = Add(di, 1)
                si = Add(si, 1)
            }
        }
        SetByte(buf, di, 0)
    }
}

Function.CCBash_SendError {
    Input: client_fd: Integer
    Input: id: Address
    Input: error_msg: Address
    Body: {
        resp = JSON.NewObject()
        JSON.SetString(resp, "method", "result")
        IfCondition NotEqual(id, 0) ThenBlock: { JSON.SetString(resp, "id", id) }
        JSON.SetBool(resp, "ok", 0)
        JSON.SetString(resp, "error", error_msg)
        Socket.SendMsg(client_fd, JSON.SerializeObject(resp))
    }
}

Function.CCBash_SendResult {
    Input: client_fd: Integer
    Input: id: Address
    Input: content: Address
    Input: truncated: Integer
    Body: {
        resp = JSON.NewObject()
        JSON.SetString(resp, "method", "result")
        IfCondition NotEqual(id, 0) ThenBlock: { JSON.SetString(resp, "id", id) }
        JSON.SetBool(resp, "ok", 1)
        IfCondition NotEqual(content, 0) ThenBlock: { JSON.SetString(resp, "content", content) }
        IfCondition EqualTo(truncated, 1) ThenBlock: { JSON.SetBool(resp, "truncated", 1) }
        Socket.SendMsg(client_fd, JSON.SerializeObject(resp))
    }
}

Function.CCBash_SendSchema {
    Input: client_fd: Integer
    Body: {
        schema_str = UtilArgs_ExportToolSchema(CCBashState.schema)
        parsed = ParseJSON(schema_str)
        schema_obj = JSON.AsObject(parsed)
        resp = JSON.NewObject()
        JSON.SetString(resp, "method", "schema_response")
        IfCondition NotEqual(schema_obj, 0) ThenBlock: { JSON.SetObject(resp, "schema", schema_obj) }
        Socket.SendMsg(client_fd, JSON.SerializeObject(resp))
    }
}

Function.CCBash_HandleRequest {
    Input: client_fd: Integer
    Input: req_str: Address
    Body: {
        parsed = ParseJSON(req_str)
        IfCondition EqualTo(parsed, 0) ThenBlock: {
            CCBash_SendError(client_fd, 0, "invalid JSON")
            ReturnValue(0)
        }
        obj = JSON.AsObject(parsed)
        IfCondition EqualTo(obj, 0) ThenBlock: {
            CCBash_SendError(client_fd, 0, "request must be a JSON object")
            ReturnValue(0)
        }
        method = JSON.GetString(obj, "method")
        IfCondition EqualTo(method, 0) ThenBlock: {
            CCBash_SendError(client_fd, 0, "missing method")
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(method, "schema"), 0) ThenBlock: {
            CCBash_SendSchema(client_fd)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(method, "call"), 0) ThenBlock: {
            id = JSON.GetString(obj, "id")
            args = JSON.GetObject(obj, "args")
            validated = UtilArgs_ParseIPC(CCBashState.schema, args)
            IfCondition EqualTo(validated, 0) ThenBlock: {
                CCBash_SendError(client_fd, id, "missing required argument 'command'")
                ReturnValue(0)
            }
            cmd          = UtilArgs_GetString(validated, "command")
            IfCondition EqualTo(CCBash_IsDangerousFind(cmd), 1) ThenBlock: {
                CCBash_SendError(client_fd, id, "Blocked: `find` with a filesystem root (/ /mnt /proc /sys) causes permanent hangs on WSL2. Scope find to a specific directory under /home or the project path.")
                ReturnValue(0)
            }
            IfCondition EqualTo(CCBash_ContainsSudo(cmd), 1) ThenBlock: {
                IfCondition EqualTo(CCBash_SudoAllowed(), 0) ThenBlock: {
                    CCBash_SendError(client_fd, id, "Blocked: `sudo` is strictly forbidden. Do not attempt to escalate privileges.")
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(CCBash_ContainsRm(cmd), 1) ThenBlock: {
                CCBash_SendError(client_fd, id, "Blocked: `rm` is not permitted. File deletion is the user's responsibility.")
                ReturnValue(0)
            }
            IfCondition EqualTo(CCBash_ContainsMv(cmd), 1) ThenBlock: {
                CCBash_SendError(client_fd, id, "Blocked: `mv` is not permitted. File management is the user's responsibility.")
                ReturnValue(0)
            }
            IfCondition EqualTo(CCBash_ContainsDd(cmd), 1) ThenBlock: {
                CCBash_SendError(client_fd, id, "Blocked: `dd` can overwrite raw devices. File operations are the user's responsibility.")
                ReturnValue(0)
            }
            IfCondition EqualTo(CCBash_ContainsKillCmd(cmd), 1) ThenBlock: {
                CCBash_SendError(client_fd, id, "Blocked: `kill`/`killall`/`pkill` are not permitted. Process management is the user's responsibility.")
                ReturnValue(0)
            }
            IfCondition EqualTo(CCBash_ContainsCrontab(cmd), 1) ThenBlock: {
                CCBash_SendError(client_fd, id, "Blocked: `crontab` installs persistent scheduled tasks and is not permitted.")
                ReturnValue(0)
            }
            IfCondition EqualTo(CCBash_ContainsPipeToShell(cmd), 1) ThenBlock: {
                CCBash_SendError(client_fd, id, "Blocked: piping to `sh` or `bash` is not permitted (supply-chain risk).")
                ReturnValue(0)
            }
            IfCondition EqualTo(CCBash_IsRedirectToSystemPath(cmd), 1) ThenBlock: {
                CCBash_SendError(client_fd, id, "Blocked: shell output redirect (> or >>) targeting a system path. Writing to OS-critical directories is not allowed.")
                ReturnValue(0)
            }
            // Schema type is int, so the model sends a JSON number.
            // GetString on a number is 0, which used to fall through to the
            // 30s default and ignore timeout_secs. A string still parses.
            timeout_secs = UtilArgs_GetInt(validated, "timeout_secs")
            timeout_str  = UtilArgs_GetString(validated, "timeout_secs")
            IfCondition NotEqual(timeout_str, 0) ThenBlock: {
                timeout_secs = StringToInt(timeout_str)
            }
            trunc_holder = Allocate(8)
            StoreValue(trunc_holder, 0, "dword")
            content = CCBash_Run(cmd, timeout_secs, trunc_holder)
            IfCondition NotEqual(content, 0) ThenBlock: { CCBash_StripAnsi(content) }
            truncated = Dereference(trunc_holder, "dword")
            Deallocate(trunc_holder, 8)
            IfCondition EqualTo(content, 0) ThenBlock: {
                CCBash_SendError(client_fd, id, "fork/exec failed")
            } ElseBlock: {
                IfCondition EqualTo(truncated, 1) ThenBlock: {
                    marker = "\n[OUTPUT TRUNCATED at 50KB — use Grep tool for targeted code search, or pipe through head -N]"
                    final = StringConcat(content, marker)
                    CCBash_SendResult(client_fd, id, final, 1)
                } ElseBlock: {
                    CCBash_SendResult(client_fd, id, content, 0)
                }
            }
            ReturnValue(0)
        }
        CCBash_SendError(client_fd, 0, "unknown method")
    }
}

SubRoutine.Main {
    CCBashConst.SOCK_DIR  = "/tmp/ailang_cctools"
    CCBashConst.SOCK_PATH = "@halcode/Bash"
    CCBashState.schema = CCBash_BuildSchema()

    SystemCall(CCBashSys.SYS_MKDIR, CCBashConst.SOCK_DIR, 493, 0, 0, 0)
    SystemCall(CCBashSys.SYS_UNLINK, CCBashConst.SOCK_PATH, 0, 0, 0, 0)

    fd = Socket.Create(1, 1)
    IfCondition LessThan(fd, 0) ThenBlock: { Exit(1) }
    br = Socket.BindUnix(fd, CCBashConst.SOCK_PATH)
    IfCondition LessThan(br, 0) ThenBlock: { Exit(1) }
    lr = Socket.Listen(fd, CCBashConst.BACKLOG)
    IfCondition LessThan(lr, 0) ThenBlock: { Exit(1) }
    CCBashState.listen_fd = fd

    PrintMessage("[cc_bash_ipc] listening on ")
    PrintMessage(CCBashConst.SOCK_PATH)
    PrintMessage("\n")

    WhileLoop EqualTo(CCBashState.running, 1) {
        client_fd = Socket.Accept(CCBashState.listen_fd)
        IfCondition GreaterEqual(client_fd, 0) ThenBlock: {
            done = 0
            pfd  = Allocate(16)
            WhileLoop EqualTo(done, 0) {
                StoreValue(pfd, client_fd, "dword")
                SetByte(pfd, 4, 1)
                SetByte(pfd, 5, 0)
                SetByte(pfd, 6, 0)
                SetByte(pfd, 7, 0)
                StoreValue(Add(pfd, 8), CCBashState.listen_fd, "dword")
                SetByte(pfd, 12, 1)
                SetByte(pfd, 13, 0)
                SetByte(pfd, 14, 0)
                SetByte(pfd, 15, 0)

                SystemCall(CCBashSys.SYS_POLL, pfd, 2, -1, 0, 0)

                rev_client = GetByte(pfd, 6)
                rev_listen = GetByte(pfd, 14)

                IfCondition NotEqual(rev_listen, 0) ThenBlock: {
                    new_fd = Socket.Accept(CCBashState.listen_fd)
                    IfCondition GreaterEqual(new_fd, 0) ThenBlock: {
                        Socket.SetRecvTimeout(new_fd, 10000)
                        mcp_req = Socket.RecvMsg(new_fd)
                        IfCondition NotEqual(mcp_req, 0) ThenBlock: {
                            IfCondition NotEqual(mcp_req, -1) ThenBlock: {
                                CCBash_HandleRequest(new_fd, mcp_req)
                            }
                        }
                        Socket.Close(new_fd)
                    }
                }

                IfCondition NotEqual(rev_client, 0) ThenBlock: {
                    req = Socket.RecvMsg(client_fd)
                    IfCondition EqualTo(req, 0) ThenBlock: { done = 1 }
                    IfCondition NotEqual(req, 0) ThenBlock: {
                        IfCondition NotEqual(req, -1) ThenBlock: {
                            CCBash_HandleRequest(client_fd, req)
                        }
                    }
                }
            }
            Socket.Close(client_fd)
        }
    }
    Exit(0)
}

RunTask(Main)
