// halcode_desk — AppDesk MDI kernel. GTK shell only blits.
// Writes /tmp/halcode_app/{meta.bin,frame.raw,gen.txt}
// Reads ptr.txt (d/m/u/w/W x y) and cmd.txt (quit).
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. MIT.

LibraryImport.Arena
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.Fonts
LibraryImport.Display.Theme.UIScale
LibraryImport.Applications.AppDesk
LibraryImport.Display.UI.InputBar
LibraryImport.JSON

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

